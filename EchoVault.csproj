<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\Icons\telegram.png" />
    <None Remove="Assets\Icons\viber.png" />
    <None Remove="Assets\Icons\whatsapp.png" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Icons\telegram.png" />
    <Resource Include="Assets\Icons\viber.png" />
    <Resource Include="Assets\Icons\whatsapp.png" />
    <Resource Include="Fonts\Inter-Thin.ttf" />
    <Resource Include="Fonts\Inter-ExtraLight.ttf" />
    <Resource Include="Fonts\Inter-Light.ttf" />
    <Resource Include="Fonts\Inter-Regular.ttf" />
    <Resource Include="Fonts\Inter-Medium.ttf" />
    <Resource Include="Fonts\Inter-SemiBold.ttf" />
    <Resource Include="Fonts\Inter-Bold.ttf" />
    <Resource Include="Fonts\Inter-ExtraBold.ttf" />
    <Resource Include="Fonts\Inter-Black.ttf" />
    <Resource Include="Fonts\InterVariable.ttf" />
  </ItemGroup>

</Project>
