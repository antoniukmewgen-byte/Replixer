<UserControl
    x:Class="Replixer.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
        <StackPanel MouseDown="Root_MouseDown">
            <Border
                Padding="16"
                Background="{StaticResource BrushColor2}"
                BorderBrush="{StaticResource BrushBorderColor2}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,12"
                        FontFamily="{StaticResource InterFont}"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="{StaticResource SubText}">
                        МЕТОД ВИЯВЛЕННЯ ДЗВІНКІВ
                    </TextBlock>

                    <!--  Window Monitor  -->
                    <Border
                        Margin="0,0,0,12"
                        Padding="16"
                        Background="{StaticResource BrushColor3}"
                        BorderBrush="{StaticResource BrushBorderColor3}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--  Icon  -->
                            <Border
                                Grid.Column="0"
                                Width="38"
                                Height="38"
                                Background="{StaticResource OtherBrushColor1}"
                                CornerRadius="8">
                                <Path
                                    Width="18"
                                    Height="18"
                                    Data="M24,8v-2c0-2.76-2.24-5-5-5H5C2.24,1,0,3.24,0,6v2H24Zm-4.5-5c.83,0,1.5,.67,1.5,1.5s-.67,1.5-1.5,1.5-1.5-.67-1.5-1.5,.67-1.5,1.5-1.5Zm-4,0c.83,0,1.5,.67,1.5,1.5s-.67,1.5-1.5,1.5-1.5-.67-1.5-1.5,.67-1.5,1.5-1.5Zm-4,0c.83,0,1.5,.67,1.5,1.5s-.67,1.5-1.5,1.5-1.5-.67-1.5-1.5,.67-1.5,1.5-1.5Zm12.5,7v8c0,2.76-2.24,5-5,5H5c-2.76,0-5-2.24-5-5V10H24Z"
                                    Fill="{StaticResource OtherBrushSubColor1}"
                                    Stretch="Uniform" />
                            </Border>

                            <!--  Text  -->
                            <StackPanel
                                Grid.Column="1"
                                Margin="12,0,12,0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    FontFamily="{StaticResource InterFont}"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource Text}">
                                    Моніторинг вікон
                                </TextBlock>
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontFamily="{StaticResource InterFont}"
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="{StaticResource SubText}"
                                    TextWrapping="Wrap">
                                    Відстежує вікна дзвінків через UI Automation
                                </TextBlock>
                            </StackPanel>

                            <!--  Toggle  -->
                            <ToggleButton
                                Grid.Column="2"
                                IsChecked="{Binding IsWindowMonitorActive, Mode=TwoWay}"
                                Style="{StaticResource ToggleSwitch}" />
                        </Grid>
                    </Border>

                    <!--  Microphone Monitor  -->
                    <Border
                        Padding="16"
                        Background="{StaticResource BrushColor3}"
                        BorderBrush="{StaticResource BrushBorderColor3}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--  Icon  -->
                            <Border
                                Grid.Column="0"
                                Width="38"
                                Height="38"
                                Background="{StaticResource OtherBrushColor2}"
                                CornerRadius="8">
                                <Path
                                    Width="18"
                                    Height="18"
                                    Data="M5,22a2,2,0,0,0,2-2V14a2,2,0,0,0-2-2V11a7,7,0,0,1,14,0v1a2,2,0,0,0-2,2v6H14a1,1,0,0,0,0,2h5a5,5,0,0,0,2-9.576V11A9,9,0,0,0,3,11v1.424A5,5,0,0,0,5,22Z"
                                    Fill="{StaticResource OtherBrushSubColor2}"
                                    Stretch="Uniform" />
                            </Border>

                            <!--  Text  -->
                            <StackPanel
                                Grid.Column="1"
                                Margin="12,0,12,0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    FontFamily="{StaticResource InterFont}"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource Text}">
                                    Моніторинг мікрофонів
                                </TextBlock>
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontFamily="{StaticResource InterFont}"
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="{StaticResource SubText}"
                                    TextWrapping="Wrap">
                                    Відстежується мікрофон та відтворення аудіо
                                </TextBlock>
                            </StackPanel>

                            <!--  Toggle  -->
                            <ToggleButton
                                Grid.Column="2"
                                IsChecked="{Binding IsMicrophoneMonitorActive, Mode=TwoWay}"
                                Style="{StaticResource ToggleSwitch}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <Border
                Margin="0,16,0,0"
                Padding="16"
                Background="{StaticResource BrushColor2}"
                BorderBrush="{StaticResource BrushBorderColor2}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel>
                    <!--  Google Drive section  -->
                    <TextBlock
                        Margin="0,0,0,12"
                        FontFamily="{StaticResource InterFont}"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="{StaticResource SubText}">
                        ХМАРНЕ СХОВИЩЕ
                    </TextBlock>

                    <!--  Google Drive toggle card  -->
                    <Border
                        Padding="16"
                        Background="{StaticResource BrushColor3}"
                        BorderBrush="{StaticResource BrushBorderColor3}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--  Icon  -->
                            <Border
                                Grid.Column="0"
                                Width="38"
                                Height="38"
                                Background="{StaticResource OtherBrushColor3}"
                                CornerRadius="8">
                                <Path
                                    Width="18"
                                    Height="18"
                                    Data="M480.768,87.936l-56.704-56.704c-5.674-5.585-11.957-10.515-18.731-14.699V64   c-0.071,58.881-47.786,106.596-106.667,106.667h-85.333C154.452,170.596,106.737,122.881,106.667,64V0   C47.786,0.071,0.071,47.786,0,106.667v298.667C0.071,464.215,47.786,511.93,106.667,512h298.667   C464.214,511.93,511.93,464.215,512,405.334V163.35C512.08,135.049,500.833,107.893,480.768,87.936z M256,384   c-47.128,0-85.333-38.205-85.333-85.333s38.205-85.333,85.333-85.333s85.333,38.205,85.333,85.333S303.128,384,256,384z                         M213.333,128h85.333c35.346,0,64-28.654,64-64V1.366c-4.638-0.756-9.32-1.212-14.016-1.365H149.333v64   C149.333,99.346,177.987,128,213.333,128z                         "
                                    Fill="{StaticResource OtherBrushSubColor3}"
                                    Stretch="Uniform" />
                            </Border>

                            <!--  Text  -->
                            <StackPanel
                                Grid.Column="1"
                                Margin="12,0,12,0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    FontFamily="{StaticResource InterFont}"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource Text}">
                                    Google Drive
                                </TextBlock>
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontFamily="{StaticResource InterFont}"
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="{StaticResource SubText}"
                                    TextWrapping="Wrap">
                                    Автоматично завантажувати запис на Google Drive
                                </TextBlock>
                            </StackPanel>
                            <!--  Toggle  -->
                            <ToggleButton
                                Grid.Column="2"
                                IsChecked="{Binding IsGoogleDriveEnabled, Mode=TwoWay}"
                                Style="{StaticResource ToggleSwitch}" />
                        </Grid>
                    </Border>

                    <!--  Google Drive settings (visible when enabled)  -->
                    <Border
                        Margin="0,12,0,0"
                        Padding="16"
                        Background="{StaticResource BrushColor3}"
                        BorderBrush="{StaticResource BrushBorderColor3}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="{Binding IsGoogleDriveEnabled, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Background="{StaticResource BrushColor4}"
                                CornerRadius="16">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderColor4}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="Padding" Value="12,8" />
                                        <Style.Triggers>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter Property="BorderThickness" Value="2" />
                                                <Setter Property="Padding" Value="11,7" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <TextBox
                                        x:Name="FolderIdBox"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        CaretBrush="{StaticResource Text}"
                                        FontFamily="{StaticResource InterFont}"
                                        FontSize="14"
                                        Foreground="{StaticResource Text}"
                                        Text="{Binding GoogleDriveFolderId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        ToolTip="Вставте ID Shared Drive або папки з URL" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource InterFont}"
                                        FontSize="14"
                                        Foreground="{StaticResource SubText}"
                                        IsHitTestVisible="False"
                                        Text="ID головної папки (Shared Drive)">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=FolderIdBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <!--  Перевірити / Перевірка... / Підключено / Немає доступу  -->
                            <Button
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                Padding="12,8"
                                HorizontalAlignment="Right"
                                Command="{Binding TestDriveConnectionCommand}"
                                Cursor="Hand"
                                ToolTip="{Binding DriveConnectionError}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCheckingDrive}" Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                                <Setter Property="Cursor" Value="Arrow" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDriveConnected}" Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                                <Setter Property="Cursor" Value="Arrow" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border
                                            x:Name="Bg"
                                            Padding="{TemplateBinding Padding}"
                                            Background="{StaticResource BrushColor4}"
                                            BorderBrush="{StaticResource BrushBorderColor4}"
                                            BorderThickness="1"
                                            CornerRadius="16">
                                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                <Path
                                                    x:Name="CheckIcon"
                                                    Width="12"
                                                    Height="12"
                                                    Margin="0,0,6,0"
                                                    Data="M20.285,2l-11.285,11.567l-5.286,-5.011l-3.714,3.716l9,8.728l15,-15.285z"
                                                    Fill="{StaticResource OtherBrushSubColor1}"
                                                    Stretch="Uniform"
                                                    Visibility="Collapsed" />
                                                <Path
                                                    x:Name="ErrorIcon"
                                                    Width="12"
                                                    Height="12"
                                                    Margin="0,0,6,0"
                                                    Data="M19,6.41L17.59,5 12,10.59 6.41,5 5,6.41 10.59,12 5,17.59 6.41,19 12,13.41 17.59,19 19,17.59 13.41,12z"
                                                    Fill="{StaticResource OtherBrushSubColor4}"
                                                    Stretch="Uniform"
                                                    Visibility="Collapsed" />
                                                <TextBlock
                                                    x:Name="Label"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontFamily="{StaticResource InterFont}"
                                                    FontSize="14"
                                                    FontWeight="Medium"
                                                    Foreground="{StaticResource SubText}"
                                                    Text="Перевірити" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <!--  Перевірка...  -->
                                            <DataTrigger Binding="{Binding IsCheckingDrive}" Value="True">
                                                <Setter TargetName="Label" Property="Text" Value="Перевірка..." />
                                            </DataTrigger>
                                            <!--  Підключено — зелений  -->
                                            <DataTrigger Binding="{Binding IsDriveConnected}" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource OtherBrushColor1}" />
                                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource OtherBrushSubColor1}" />
                                                <Setter TargetName="Label" Property="Text" Value="Підключено" />
                                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource OtherBrushSubColor1}" />
                                                <Setter TargetName="CheckIcon" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <!--  Немає доступу — червоний  -->
                                            <DataTrigger Binding="{Binding IsDriveConnected}" Value="False">
                                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource OtherBrushColor4}" />
                                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource OtherBrushSubColor4}" />
                                                <Setter TargetName="Label" Property="Text" Value="Немає доступу" />
                                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource OtherBrushSubColor4}" />
                                                <Setter TargetName="ErrorIcon" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!--  Telegram section  -->
            <Border
                Margin="0,16,0,0"
                Padding="16"
                Background="{StaticResource BrushColor2}"
                BorderBrush="{StaticResource BrushBorderColor2}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,12"
                        FontFamily="{StaticResource InterFont}"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="{StaticResource SubText}">
                        TELEGRAM
                    </TextBlock>

                    <!--  Telegram toggle card  -->
                    <Border
                        Padding="16"
                        Background="{StaticResource BrushColor3}"
                        BorderBrush="{StaticResource BrushBorderColor3}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Width="38"
                                Height="38"
                                Background="{StaticResource BrushTelegram}"
                                CornerRadius="8">
                                <Image
                                    Width="18"
                                    Height="18"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Source="/Assets/Icons/telegram.png" />
                            </Border>

                            <StackPanel
                                Grid.Column="1"
                                Margin="12,0,12,0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    FontFamily="{StaticResource InterFont}"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource Text}">
                                    Telegram
                                </TextBlock>
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontFamily="{StaticResource InterFont}"
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="{StaticResource SubText}"
                                    TextWrapping="Wrap">
                                    Автоматично надсилати запис у Telegram
                                </TextBlock>
                            </StackPanel>

                            <ToggleButton
                                Grid.Column="2"
                                IsChecked="{Binding IsTelegramEnabled, Mode=TwoWay}"
                                Style="{StaticResource ToggleSwitch}" />
                        </Grid>
                    </Border>

                    <!--  Telegram settings (visible when enabled)  -->
                    <Border
                        Margin="0,12,0,0"
                        Padding="16"
                        Background="{StaticResource BrushColor3}"
                        BorderBrush="{StaticResource BrushBorderColor3}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="{Binding IsTelegramEnabled, Converter={StaticResource BoolToVis}}">
                        <StackPanel>

                            <!--  Chat selector  -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource InterFont}"
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="{StaticResource SubText}">
                                    Чат для відправки
                                </TextBlock>

                                <Border
                                    Grid.Column="1"
                                    Padding="4,2"
                                    Background="{StaticResource BrushColor4}"
                                    BorderBrush="{StaticResource BrushBorderColor4}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <ComboBox
                                        MinWidth="140"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontFamily="{StaticResource InterFont}"
                                        FontSize="13"
                                        Foreground="{StaticResource Text}"
                                        ItemsSource="{Binding TelegramChats}"
                                        SelectedItem="{Binding SelectedTelegramChat, Mode=TwoWay}" />
                                </Border>
                            </Grid>

                            <!--  Phone + Authorize  -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Grid.Column="0"
                                    Background="{StaticResource BrushColor4}"
                                    CornerRadius="16">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{StaticResource BrushBorderColor4}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="Padding" Value="12,8" />
                                            <Style.Triggers>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter Property="BorderThickness" Value="2" />
                                                    <Setter Property="Padding" Value="11,7" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <TextBox
                                            x:Name="PhoneBox"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            CaretBrush="{StaticResource Text}"
                                            FontFamily="{StaticResource InterFont}"
                                            FontSize="14"
                                            Foreground="{StaticResource Text}"
                                            Text="{Binding TelegramPhone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            ToolTip="Наприклад: +380991234567 або 0991234567" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource InterFont}"
                                            FontSize="14"
                                            Foreground="{StaticResource SubText}"
                                            IsHitTestVisible="False"
                                            Text="Номер телефону (+380... або 09...)">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=PhoneBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <!--  Авторизувати / Авторизація... / Авторизовано / Помилка  -->
                                <Button
                                    Grid.Column="1"
                                    Margin="12,0,0,0"
                                    Padding="12,8"
                                    HorizontalAlignment="Right"
                                    Command="{Binding TelegramActionCommand}"
                                    Cursor="Hand"
                                    ToolTip="{Binding TelegramAuthError}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAuthorizingTelegram}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                    <Setter Property="Cursor" Value="Arrow" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsTelegramConnected}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                    <Setter Property="Cursor" Value="Arrow" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                x:Name="Bg"
                                                Padding="{TemplateBinding Padding}"
                                                Background="{StaticResource BrushColor4}"
                                                BorderBrush="{StaticResource BrushBorderColor4}"
                                                BorderThickness="1"
                                                CornerRadius="16">
                                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                    <Path
                                                        x:Name="CheckIcon"
                                                        Width="12"
                                                        Height="12"
                                                        Margin="0,0,6,0"
                                                        Data="M20.285,2l-11.285,11.567l-5.286,-5.011l-3.714,3.716l9,8.728l15,-15.285z"
                                                        Fill="{StaticResource OtherBrushSubColor1}"
                                                        Stretch="Uniform"
                                                        Visibility="Collapsed" />
                                                    <Path
                                                        x:Name="ErrorIcon"
                                                        Width="12"
                                                        Height="12"
                                                        Margin="0,0,6,0"
                                                        Data="M19,6.41L17.59,5 12,10.59 6.41,5 5,6.41 10.59,12 5,17.59 6.41,19 12,13.41 17.59,19 19,17.59 13.41,12z"
                                                        Fill="{StaticResource OtherBrushSubColor4}"
                                                        Stretch="Uniform"
                                                        Visibility="Collapsed" />
                                                    <TextBlock
                                                        x:Name="Label"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontFamily="{StaticResource InterFont}"
                                                        FontSize="14"
                                                        FontWeight="Medium"
                                                        Foreground="{StaticResource SubText}"
                                                        Text="Авторизувати" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <!--  Авторизація...  -->
                                                <DataTrigger Binding="{Binding IsAuthorizingTelegram}" Value="True">
                                                    <Setter TargetName="Label" Property="Text" Value="Авторизація..." />
                                                </DataTrigger>
                                                <!--  Авторизовано — зелений  -->
                                                <DataTrigger Binding="{Binding IsTelegramConnected}" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource OtherBrushColor1}" />
                                                    <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource OtherBrushSubColor1}" />
                                                    <Setter TargetName="Label" Property="Text" Value="Авторизовано" />
                                                    <Setter TargetName="Label" Property="Foreground" Value="{StaticResource OtherBrushSubColor1}" />
                                                    <Setter TargetName="CheckIcon" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <!--  Помилка — червоний  -->
                                                <DataTrigger Binding="{Binding IsTelegramConnected}" Value="False">
                                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource OtherBrushColor4}" />
                                                    <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource OtherBrushSubColor4}" />
                                                    <Setter TargetName="Label" Property="Text" Value="Помилка" />
                                                    <Setter TargetName="Label" Property="Foreground" Value="{StaticResource OtherBrushSubColor4}" />
                                                    <Setter TargetName="ErrorIcon" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <!--  Error message  -->
                            <TextBlock
                                Margin="0,8,0,0"
                                FontFamily="{StaticResource InterFont}"
                                FontSize="12"
                                FontWeight="Medium"
                                Foreground="{StaticResource OtherBrushSubColor4}"
                                Text="{Binding TelegramAuthError}"
                                TextWrapping="Wrap"
                                Visibility="{Binding TelegramAuthError, Converter={StaticResource NullToVisibility}}" />

                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
