<UserControl
    x:Class="Replixer.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:callViews="clr-namespace:Replixer.Views.Call"
    xmlns:callVm="clr-namespace:Replixer.ViewModels.Call"
    xmlns:models="clr-namespace:Replixer.Models"
    xmlns:views="clr-namespace:Replixer.Views">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type callVm:IdleCallViewModel}">
            <callViews:IdleCallView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type callVm:ActiveCallViewModel}">
            <callViews:ActiveCallView />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  CallContent  -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,12"
            Padding="16"
            Background="{StaticResource BrushColor2}"
            BorderBrush="{StaticResource BrushBorderColor2}"
            BorderThickness="1"
            CornerRadius="12">
            <ContentControl Content="{Binding CallContent}" />
        </Border>

        <!--  LastCallContent  -->
        <Border
            Grid.Row="1"
            Background="{StaticResource BrushColor2}"
            BorderBrush="{StaticResource BrushBorderColor2}"
            BorderThickness="1"
            CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Title  -->
                <TextBlock
                    Grid.Row="0"
                    Margin="16,16,16,0"
                    HorizontalAlignment="Left"
                    FontFamily="{StaticResource InterFont}"
                    FontSize="12"
                    FontWeight="Bold"
                    Foreground="{StaticResource SubText}">
                    ОСТАННІ ЗАПИСИ
                </TextBlock>

                <!--  List  -->
                <ItemsControl
                    Grid.Row="1"
                    Margin="16,0,16,16"
                    ItemsSource="{Binding RecordingsVm.RecentRecordings}"
                    Visibility="{Binding RecordingsVm.IsEmpty, Converter={StaticResource InverseBoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:RecordingEntry}">
                            <views:RecordingItemView />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--  Empty state  -->
                <views:EmptyRecordingsView Grid.Row="1" Visibility="{Binding RecordingsVm.IsEmpty, Converter={StaticResource BoolToVis}}" />

            </Grid>
        </Border>
    </Grid>
</UserControl>
