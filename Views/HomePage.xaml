<UserControl
    x:Class="EchoVault.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  CallContent  -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,12"
            Padding="16"
            Background="{StaticResource BrushCardBackground}"
            BorderBrush="{StaticResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="16">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontFamily="{StaticResource InterFont}"
                    FontSize="12"
                    FontWeight="Bold"
                    Foreground="{StaticResource BrushIcon}">
                    Зараз не йде жодного дзвінка
                </TextBlock>
                <Grid
                    Width="60"
                    Height="60"
                    Margin="0,12">
                    <Ellipse Fill="{StaticResource BrushCardDeep}" Stroke="{StaticResource BrushBorder}" />
                    <Path
                        Width="30"
                        Height="30"
                        Data="M22.183,22.164l.91-1.049a3.1,3.1,0,0,0,0-4.377c-.031-.031-2.437-1.882-2.437-1.882a3.1,3.1,0,0,0-4.281.006l-1.906,1.606A12.784,12.784,0,0,1,7.537,9.524l1.6-1.9a3.1,3.1,0,0,0,.007-4.282S7.291.939,7.26.908A3.082,3.082,0,0,0,2.934.862l-1.15,1C-5.01,9.744,9.62,24.261,17.762,24A6.155,6.155,0,0,0,22.183,22.164Z"
                        Fill="{StaticResource BrushIcon}"
                        Stretch="Uniform" />
                </Grid>
                <Button
                    Padding="8,4"
                    HorizontalAlignment="Center"
                    Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border
                                Padding="{TemplateBinding Padding}"
                                Background="{StaticResource BrushCardDeep}"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1"
                                CornerRadius="12">
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <Path
                                        Width="16"
                                        Height="16"
                                        Margin="0,0,6,0"
                                        Data="m12,0C5.383,0,0,5.383,0,12s5.383,12,12,12,12-5.383,12-12S18.617,0,12,0Zm0,22c-5.514,0-10-4.486-10-10S6.486,2,12,2s10,4.486,10,10-4.486,10-10,10Zm4-10c0,2.209-1.791,4-4,4s-4-1.791-4-4,1.791-4,4-4,4,1.791,4,4Z"
                                        Fill="{StaticResource BrushIcon}"
                                        Stretch="Uniform" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource InterFont}"
                                        FontSize="12"
                                        FontWeight="Medium"
                                        Foreground="{StaticResource BrushIcon}">
                                        Записати вручну
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>

        <!--  LastCallContent  -->
        <Border
            Grid.Row="1"
            Padding="16"
            Background="{StaticResource BrushCardBackground}"
            BorderBrush="{StaticResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    HorizontalAlignment="Left"
                    FontFamily="{StaticResource InterFont}"
                    FontSize="10"
                    FontWeight="Bold"
                    Foreground="{StaticResource BrushIcon}">
                    Останні записи
                </TextBlock>
                <StackPanel
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <Grid Width="60" Height="60">
                        <Ellipse Fill="{StaticResource BrushCardDeep}" Stroke="{StaticResource BrushBorder}" />
                        <Path
                            Width="30"
                            Height="30"
                            Data="m14 7v-6.54a6.977 6.977 0 0 1 2.465 1.59l3.484 3.486a6.954 6.954 0 0 1 1.591 2.464h-6.54a1 1 0 0 1 -1-1zm8 3.485v8.515a5.006 5.006 0 0 1 -5 5h-10a5.006 5.006 0 0 1 -5-5v-14a5.006 5.006 0 0 1 5-5h4.515c.163 0 .324.013.485.024v6.976a3 3 0 0 0 3 3h6.976c.011.161.024.322.024.485zm-6 6.515a1 1 0 0 0 -1-1h-2v-2a1 1 0 0 0 -2 0v2h-2a1 1 0 0 0 0 2h2v2a1 1 0 0 0 2 0v-2h2a1 1 0 0 0 1-1z"
                            Fill="{StaticResource BrushIcon}"
                            Stretch="Uniform" />
                    </Grid>
                    <TextBlock
                        Margin="0,12,0,6"
                        HorizontalAlignment="Center"
                        FontFamily="{StaticResource InterFont}"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="{StaticResource BrushIcon}">
                        Записів не знайдено
                    </TextBlock>
                    <TextBlock
                        Width="300"
                        Margin="0,0,0,12"
                        HorizontalAlignment="Center"
                        FontFamily="{StaticResource InterFont}"
                        FontSize="10"
                        FontWeight="Medium"
                        Foreground="{StaticResource BrushSubtext}"
                        TextAlignment="Center"
                        TextWrapping="Wrap">
                        Коли відбудеться дзвінок у WhatsApp, Telegram, Viber або інші програми - запис з'явиться тут
                    </TextBlock>
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <Border
                            Width="30"
                            Height="30"
                            Background="{StaticResource BrushTelegram}"
                            CornerRadius="8">
                            <Image
                                Width="16"
                                Height="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Source="/Assets/Icons/telegram.png" />
                        </Border>
                        <Border
                            Width="30"
                            Height="30"
                            Margin="6,0"
                            Background="{StaticResource BrushViber}"
                            CornerRadius="8">
                            <Image
                                Width="16"
                                Height="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Source="/Assets/Icons/viber.png" />
                        </Border>
                        <Border
                            Width="30"
                            Height="30"
                            Background="{StaticResource BrushWhatsApp}"
                            CornerRadius="8">
                            <Image
                                Width="16"
                                Height="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Source="/Assets/Icons/whatsapp.png" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
