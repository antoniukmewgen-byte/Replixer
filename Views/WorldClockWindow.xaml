<Window
    x:Class="Replixer.Views.WorldClockWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Світовий час"
    Width="340"
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="{StaticResource InterFont}"
    RenderOptions.BitmapScalingMode="NearestNeighbor"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    Topmost="True"
    WindowStyle="None">

    <!--
        Margin навколо картки — та сама причина, що й у CallCheatSheetWindow/MissedCallReminderWindow:
        DropShadowEffect (BlurRadius=24, ShadowDepth=6) розмиває тінь ЗА межі Border, і без вільного
        прозорого простору навколо вона обрізається прямокутними межами вікна. Ширину вікна відповідно
        збільшено з 292 до 340 (292 + 24*2), щоб сама картка лишилась візуально тих самих 292px.
    -->
    <Border
        Margin="24,24,24,30"
        Background="{StaticResource BrushColor2}"
        BorderBrush="{StaticResource BrushBorderColor2}"
        BorderThickness="1"
        CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="26"
                Opacity="0.6"
                ShadowDepth="6"
                Color="Black" />
        </Border.Effect>

        <StackPanel>

            <!--  Header  -->
            <Border
                x:Name="DragHeader"
                Padding="14,12"
                Background="{StaticResource BrushColor3}"
                CornerRadius="13,13,0,0"
                Cursor="SizeAll"
                MouseLeftButtonDown="Header_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  Живий пульсуючий індикатор — сигналізує, що годинники оновлюються  -->
                    <Ellipse
                        x:Name="LivePulse"
                        Width="7"
                        Height="7"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Fill="{StaticResource OtherBrushSubColor1}"
                        RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="PulseScale" />
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Ellipse.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            AutoReverse="True"
                                            RepeatBehavior="Forever"
                                            Storyboard.TargetName="PulseScale"
                                            Storyboard.TargetProperty="ScaleX"
                                            From="0.85"
                                            To="1.6"
                                            Duration="0:0:1.2" />
                                        <DoubleAnimation
                                            AutoReverse="True"
                                            RepeatBehavior="Forever"
                                            Storyboard.TargetName="PulseScale"
                                            Storyboard.TargetProperty="ScaleY"
                                            From="0.85"
                                            To="1.6"
                                            Duration="0:0:1.2" />
                                        <DoubleAnimation
                                            AutoReverse="True"
                                            RepeatBehavior="Forever"
                                            Storyboard.TargetName="LivePulse"
                                            Storyboard.TargetProperty="Opacity"
                                            From="1.0"
                                            To="0.35"
                                            Duration="0:0:1.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>

                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource SubText}"
                        Text="СВІТОВИЙ ЧАС" />

                    <Border
                        x:Name="CloseButton"
                        Grid.Column="2"
                        Width="22"
                        Height="22"
                        Background="Transparent"
                        Cursor="Hand"
                        CornerRadius="11"
                        MouseLeftButtonDown="CloseButton_MouseLeftButtonDown">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Foreground="{StaticResource SubText}"
                            Text="✕" />
                    </Border>
                </Grid>
            </Border>

            <!--  Zones  -->
            <StackPanel Margin="10,10,10,10">
                <StackPanel.Resources>

                    <Style x:Key="ZoneCard" TargetType="Border">
                        <Setter Property="Padding" Value="10,9" />
                        <Setter Property="Background" Value="{StaticResource BrushColor3}" />
                        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderColor3}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="CornerRadius" Value="11" />
                        <Setter Property="Margin" Value="0,0,0,6" />
                    </Style>

                    <Style x:Key="ZoneName" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="13" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Foreground" Value="{StaticResource Text}" />
                    </Style>

                    <Style x:Key="ZoneSub" TargetType="TextBlock">
                        <Setter Property="Margin" Value="0,2,0,0" />
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="Foreground" Value="{StaticResource SubText}" />
                    </Style>

                    <Style x:Key="ZoneTime" TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="HorizontalAlignment" Value="Right" />
                        <Setter Property="FontFamily" Value="Consolas" />
                        <Setter Property="FontSize" Value="19" />
                        <Setter Property="FontWeight" Value="Bold" />
                    </Style>

                </StackPanel.Resources>

                <!--  Kyiv — домашній пояс, позначений синьою рамкою; іконка/колір все одно
                      реагують на фазу доби, як і в інших рядках, для візуальної єдності.  -->
                <Border BorderBrush="{StaticResource OtherBrushSubColor2}" Style="{StaticResource ZoneCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            x:Name="BadgeKyiv"
                            Width="34"
                            Height="34"
                            CornerRadius="9">
                            <Path
                                x:Name="IconKyiv"
                                Width="16"
                                Height="16"
                                Stretch="Uniform" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource ZoneName}" Text="Київ" />
                            <TextBlock Style="{StaticResource ZoneSub}" Text="Домашній пояс" />
                        </StackPanel>

                        <TextBlock x:Name="TimeKyiv" Grid.Column="2" Style="{StaticResource ZoneTime}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource ZoneCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            x:Name="BadgeEastern"
                            Width="34"
                            Height="34"
                            CornerRadius="9">
                            <Path
                                x:Name="IconEastern"
                                Width="16"
                                Height="16"
                                Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource ZoneName}" Text="Eastern (Флорида)" />
                            <TextBlock x:Name="SubEastern" Style="{StaticResource ZoneSub}" />
                        </StackPanel>
                        <TextBlock x:Name="TimeEastern" Grid.Column="2" Style="{StaticResource ZoneTime}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource ZoneCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            x:Name="BadgeCentral"
                            Width="34"
                            Height="34"
                            CornerRadius="9">
                            <Path
                                x:Name="IconCentral"
                                Width="16"
                                Height="16"
                                Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource ZoneName}" Text="Central" />
                            <TextBlock x:Name="SubCentral" Style="{StaticResource ZoneSub}" />
                        </StackPanel>
                        <TextBlock x:Name="TimeCentral" Grid.Column="2" Style="{StaticResource ZoneTime}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource ZoneCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            x:Name="BadgeMountain"
                            Width="34"
                            Height="34"
                            CornerRadius="9">
                            <Path
                                x:Name="IconMountain"
                                Width="16"
                                Height="16"
                                Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource ZoneName}" Text="Mountain" />
                            <TextBlock x:Name="SubMountain" Style="{StaticResource ZoneSub}" />
                        </StackPanel>
                        <TextBlock x:Name="TimeMountain" Grid.Column="2" Style="{StaticResource ZoneTime}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource ZoneCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            x:Name="BadgePacific"
                            Width="34"
                            Height="34"
                            CornerRadius="9">
                            <Path
                                x:Name="IconPacific"
                                Width="16"
                                Height="16"
                                Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource ZoneName}" Text="Pacific" />
                            <TextBlock x:Name="SubPacific" Style="{StaticResource ZoneSub}" />
                        </StackPanel>
                        <TextBlock x:Name="TimePacific" Grid.Column="2" Style="{StaticResource ZoneTime}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource ZoneCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            x:Name="BadgeAlaska"
                            Width="34"
                            Height="34"
                            CornerRadius="9">
                            <Path
                                x:Name="IconAlaska"
                                Width="16"
                                Height="16"
                                Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource ZoneName}" Text="Alaska" />
                            <TextBlock x:Name="SubAlaska" Style="{StaticResource ZoneSub}" />
                        </StackPanel>
                        <TextBlock x:Name="TimeAlaska" Grid.Column="2" Style="{StaticResource ZoneTime}" />
                    </Grid>
                </Border>

                <Border Margin="0,0,0,0" Style="{StaticResource ZoneCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            x:Name="BadgeHawaii"
                            Width="34"
                            Height="34"
                            CornerRadius="9">
                            <Path
                                x:Name="IconHawaii"
                                Width="16"
                                Height="16"
                                Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource ZoneName}" Text="Hawaii" />
                            <TextBlock x:Name="SubHawaii" Style="{StaticResource ZoneSub}" />
                        </StackPanel>
                        <TextBlock x:Name="TimeHawaii" Grid.Column="2" Style="{StaticResource ZoneTime}" />
                    </Grid>
                </Border>

            </StackPanel>

        </StackPanel>
    </Border>
</Window>
