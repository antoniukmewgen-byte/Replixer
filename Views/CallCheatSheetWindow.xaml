<Window
    x:Class="Replixer.Views.CallCheatSheetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Cheat Sheet"
    Width="300"
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="{StaticResource InterFont}"
    RenderOptions.BitmapScalingMode="NearestNeighbor"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    Topmost="True"
    WindowStyle="None">

    <Border
        Background="{StaticResource BrushColor2}"
        BorderBrush="{StaticResource BrushBorderColor2}"
        BorderThickness="1"
        CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="24"
                Opacity="0.6"
                ShadowDepth="6"
                Color="Black" />
        </Border.Effect>

        <StackPanel>

            <!--  Header  -->
            <Border
                x:Name="DragHeader"
                Padding="12,10"
                Background="{StaticResource BrushColor3}"
                CornerRadius="11,11,0,0"
                Cursor="SizeAll"
                MouseLeftButtonDown="Header_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <UniformGrid
                        Width="12"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Columns="2"
                        Rows="3">
                        <Ellipse
                            Width="2.5"
                            Height="2.5"
                            Margin="1.5"
                            Fill="{StaticResource BrushBorderColor4}" />
                        <Ellipse
                            Width="2.5"
                            Height="2.5"
                            Margin="1.5"
                            Fill="{StaticResource BrushBorderColor4}" />
                        <Ellipse
                            Width="2.5"
                            Height="2.5"
                            Margin="1.5"
                            Fill="{StaticResource BrushBorderColor4}" />
                        <Ellipse
                            Width="2.5"
                            Height="2.5"
                            Margin="1.5"
                            Fill="{StaticResource BrushBorderColor4}" />
                        <Ellipse
                            Width="2.5"
                            Height="2.5"
                            Margin="1.5"
                            Fill="{StaticResource BrushBorderColor4}" />
                        <Ellipse
                            Width="2.5"
                            Height="2.5"
                            Margin="1.5"
                            Fill="{StaticResource BrushBorderColor4}" />
                    </UniformGrid>

                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource SubText}"
                        Text="ШПАРГАЛКА" />
                </Grid>
            </Border>

            <Rectangle Height="1" Fill="{StaticResource BrushBorderColor2}" />

            <!--  Items  -->
            <StackPanel Margin="8,8,8,8">
                <StackPanel.Resources>
                    <Style x:Key="HintItem" TargetType="CheckBox">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Margin" Value="0,0,0,1" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="CheckBox">
                                    <Border
                                        x:Name="RowBg"
                                        Padding="8,7"
                                        Background="Transparent"
                                        CornerRadius="7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!--  Number badge  -->
                                            <Border
                                                x:Name="Badge"
                                                Width="20"
                                                Height="20"
                                                Margin="0,1,0,0"
                                                VerticalAlignment="Top"
                                                Background="Transparent"
                                                BorderBrush="{StaticResource BrushBorderColor4}"
                                                BorderThickness="1.5"
                                                CornerRadius="5">
                                                <Grid>
                                                    <TextBlock
                                                        x:Name="Num"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="10"
                                                        FontWeight="SemiBold"
                                                        Foreground="{StaticResource SubText}"
                                                        Text="{TemplateBinding Tag}" />
                                                    <Path
                                                        x:Name="CheckMark"
                                                        Data="M4,10 L8,14 L16,6"
                                                        Stroke="{StaticResource OtherBrushSubColor1}"
                                                        StrokeEndLineCap="Round"
                                                        StrokeStartLineCap="Round"
                                                        StrokeThickness="1.8"
                                                        Visibility="Collapsed" />
                                                </Grid>
                                            </Border>

                                            <!--  Label  -->
                                            <TextBlock
                                                x:Name="Label"
                                                Grid.Column="1"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                FontSize="14"
                                                Foreground="{StaticResource Text}"
                                                LineHeight="18"
                                                Text="{TemplateBinding Content}"
                                                TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="RowBg" Property="Background" Value="{StaticResource BrushColor4}" />
                                            <Setter TargetName="Badge" Property="BorderBrush" Value="{StaticResource OtherBrushSubColor1}" />
                                            <Setter TargetName="Num" Property="Foreground" Value="{StaticResource OtherBrushSubColor1}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Badge" Property="Background" Value="{StaticResource OtherBrushColor1}" />
                                            <Setter TargetName="Badge" Property="BorderBrush" Value="{StaticResource OtherBrushSubColor1}" />
                                            <Setter TargetName="Num" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="Label" Property="Opacity" Value="0.35" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </StackPanel.Resources>

                <CheckBox
                    Content="Привітання, тест на дебіла та встановлення рамок"
                    Style="{StaticResource HintItem}"
                    Tag="1" />
                <CheckBox
                    Content="Первинний анамнез та підводимо лінію"
                    Style="{StaticResource HintItem}"
                    Tag="2" />
                <CheckBox
                    Content="Вторинний анамнез, розкриваємо досвід клієнта через техніку &quot;ближче-далі&quot;"
                    Style="{StaticResource HintItem}"
                    Tag="3" />
                <CheckBox
                    Content="Знайшли зачіпку, інтегруємо приклад успішного кейсу та аппрува"
                    Style="{StaticResource HintItem}"
                    Tag="4" />
                <CheckBox
                    Content="Прийом &quot;чашка чаю&quot; + &quot;ваш кейс унікальний, антиприклад щойно був порожній кейс&quot;"
                    Style="{StaticResource HintItem}"
                    Tag="5" />
                <CheckBox
                    Content="Ставимо дедлайн, вибираємо день і час"
                    Style="{StaticResource HintItem}"
                    Tag="6" />
                <CheckBox
                    Content="Закриття у дзвінку, отримуємо ім'я, прізвище, пошту. І приймаємо оплату на реквізити"
                    Style="{StaticResource HintItem}"
                    Tag="7" />

            </StackPanel>

        </StackPanel>
    </Border>
</Window>
