<Window
    x:Class="Replixer.Views.CallCheatSheetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Cheat Sheet"
    Width="270"
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="{StaticResource InterFont}"
    RenderOptions.BitmapScalingMode="NearestNeighbor"
    ShowInTaskbar="False"
    SizeToContent="Height"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    Topmost="True"
    WindowStyle="None">

    <Border
        Background="{StaticResource BrushColor2}"
        BorderBrush="{StaticResource BrushBorderColor2}"
        BorderThickness="1"
        CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="24"
                Opacity="0.6"
                ShadowDepth="6"
                Color="Black" />
        </Border.Effect>

        <StackPanel>

            <!--  Header (drag zone only)  -->
            <Border
                x:Name="DragHeader"
                Padding="12,10"
                Background="{StaticResource BrushColor3}"
                CornerRadius="11,11,0,0"
                Cursor="SizeAll"
                MouseLeftButtonDown="Header_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  Drag grip dots  -->
                    <UniformGrid
                        Width="12"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Columns="2"
                        Rows="3">
                        <Ellipse
                            Width="2.5"
                            Height="2.5"
                            Margin="1.5"
                            Fill="{StaticResource BrushBorderColor4}" />
                        <Ellipse
                            Width="2.5"
                            Height="2.5"
                            Margin="1.5"
                            Fill="{StaticResource BrushBorderColor4}" />
                        <Ellipse
                            Width="2.5"
                            Height="2.5"
                            Margin="1.5"
                            Fill="{StaticResource BrushBorderColor4}" />
                        <Ellipse
                            Width="2.5"
                            Height="2.5"
                            Margin="1.5"
                            Fill="{StaticResource BrushBorderColor4}" />
                        <Ellipse
                            Width="2.5"
                            Height="2.5"
                            Margin="1.5"
                            Fill="{StaticResource BrushBorderColor4}" />
                        <Ellipse
                            Width="2.5"
                            Height="2.5"
                            Margin="1.5"
                            Fill="{StaticResource BrushBorderColor4}" />
                    </UniformGrid>

                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="10"
                        FontWeight="Bold"
                        Foreground="{StaticResource SubText}"
                        Text="ШПАРГАЛКА" />
                </Grid>
            </Border>

            <Rectangle Height="1" Fill="{StaticResource BrushBorderColor2}" />

            <!--  Items list  -->
            <StackPanel Margin="10,10,10,10">
                <StackPanel.Resources>
                    <Style x:Key="HintRow" TargetType="Border">
                        <Setter Property="CornerRadius" Value="7" />
                        <Setter Property="Padding" Value="8,6" />
                        <Setter Property="Margin" Value="0,0,0,2" />
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource BrushColor4}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="HintCheck" TargetType="CheckBox">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="CheckBox">
                                    <Border
                                        x:Name="Box"
                                        Width="14"
                                        Height="14"
                                        Background="Transparent"
                                        BorderBrush="{StaticResource BrushBorderColor3}"
                                        BorderThickness="1.5"
                                        CornerRadius="4">
                                        <Path
                                            x:Name="CheckMark"
                                            Data="M2.5,7 L5.5,10 L11.5,3.5"
                                            Stroke="{StaticResource OtherBrushSubColor1}"
                                            StrokeEndLineCap="Round"
                                            StrokeStartLineCap="Round"
                                            StrokeThickness="1.8"
                                            Visibility="Collapsed" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="Box" Property="Background" Value="{StaticResource OtherBrushColor1}" />
                                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource OtherBrushSubColor1}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource OtherBrushSubColor1}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style x:Key="HintText" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource Text}" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="TextWrapping" Value="Wrap" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Margin" Value="6,0,0,0" />
                        <Setter Property="LineHeight" Value="17" />
                    </Style>
                </StackPanel.Resources>

                <Border Style="{StaticResource HintRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox
                            Margin="0,3,0,0"
                            VerticalAlignment="Top"
                            Style="{StaticResource HintCheck}" />
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource HintText}"
                            Text="1. Привітання, тест на дебіла та встановлення рамок" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource HintRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox
                            Margin="0,3,0,0"
                            VerticalAlignment="Top"
                            Style="{StaticResource HintCheck}" />
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource HintText}"
                            Text="2. Первинний анамнез та підводимо лінію" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource HintRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox
                            Margin="0,3,0,0"
                            VerticalAlignment="Top"
                            Style="{StaticResource HintCheck}" />
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource HintText}"
                            Text="3. Вторинний анамнез, розкриваємо досвід клієнта через техніку &quot;ближче-далі&quot;" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource HintRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox
                            Margin="0,3,0,0"
                            VerticalAlignment="Top"
                            Style="{StaticResource HintCheck}" />
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource HintText}"
                            Text="4. Знайшли зачіпку, інтегруємо приклад успішного кейсу та аппрува" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource HintRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox
                            Margin="0,3,0,0"
                            VerticalAlignment="Top"
                            Style="{StaticResource HintCheck}" />
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource HintText}"
                            Text="5. Прийом &quot;чашка чаю&quot; + &quot;ваш кейс унікальний, антиприклад щойно був порожній кейс&quot;" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource HintRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox
                            Margin="0,3,0,0"
                            VerticalAlignment="Top"
                            Style="{StaticResource HintCheck}" />
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource HintText}"
                            Text="6. Ставимо дедлайн, вибираємо день і час" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource HintRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox
                            Margin="0,3,0,0"
                            VerticalAlignment="Top"
                            Style="{StaticResource HintCheck}" />
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource HintText}"
                            Text="7. Закриття у дзвінку, отримуємо ім'я, прізвище, пошту. І приймаємо оплату на реквізити" />
                    </Grid>
                </Border>

            </StackPanel>

        </StackPanel>
    </Border>
</Window>
