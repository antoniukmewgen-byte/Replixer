<UserControl
    x:Class="Replixer.Views.Call.IdleCallView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel HorizontalAlignment="Center">
        <TextBlock
            HorizontalAlignment="Center"
            FontFamily="{StaticResource InterFont}"
            FontSize="14"
            FontWeight="Bold"
            Foreground="{StaticResource Text}">
            Зараз не йде жодного дзвінка
        </TextBlock>
        <Grid
            Width="60"
            Height="60"
            Margin="0,12">
            <Ellipse Fill="{StaticResource BrushColor4}" Stroke="{StaticResource BrushBorderColor4}" />
            <Path
                Width="30"
                Height="30"
                Data="M22.183,22.164l.91-1.049a3.1,3.1,0,0,0,0-4.377c-.031-.031-2.437-1.882-2.437-1.882a3.1,3.1,0,0,0-4.281.006l-1.906,1.606A12.784,12.784,0,0,1,7.537,9.524l1.6-1.9a3.1,3.1,0,0,0,.007-4.282S7.291.939,7.26.908A3.082,3.082,0,0,0,2.934.862l-1.15,1C-5.01,9.744,9.62,24.261,17.762,24A6.155,6.155,0,0,0,22.183,22.164Z"
                Fill="{StaticResource SubText}"
                Stretch="Uniform" />
        </Grid>
        <StackPanel
            Margin="0,0,0,0"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
            <Button
                Padding="12,8"
                HorizontalAlignment="Center"
                Command="{Binding RecordManuallyCommand}"
                Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bg"
                            Padding="{TemplateBinding Padding}"
                            Background="{StaticResource BrushColor4}"
                            BorderBrush="{StaticResource BrushBorderColor4}"
                            BorderThickness="1"
                            CornerRadius="16">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <Path
                                    x:Name="Icon"
                                    Width="14"
                                    Height="14"
                                    Margin="0,0,6,0"
                                    Data="m12,0C5.383,0,0,5.383,0,12s5.383,12,12,12,12-5.383,12-12S18.617,0,12,0Zm0,22c-5.514,0-10-4.486-10-10S6.486,2,12,2s10,4.486,10,10-4.486,10-10,10Zm4-10c0,2.209-1.791,4-4,4s-4-1.791-4-4,1.791-4,4-4,4,1.791,4,4Z"
                                    Fill="{StaticResource SubText}"
                                    Stretch="Uniform" />
                                <TextBlock
                                    x:Name="Label"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource InterFont}"
                                    FontSize="14"
                                    FontWeight="Medium"
                                    Foreground="{StaticResource SubText}">
                                    Записати вручну
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button
                Margin="8,0,0,0"
                Padding="12,8"
                HorizontalAlignment="Center"
                Command="{Binding ReportMissedCallCommand}"
                Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bg"
                            Padding="{TemplateBinding Padding}"
                            Background="{StaticResource OtherBrushColor4}"
                            BorderBrush="{StaticResource OtherBrushSubColor4}"
                            BorderThickness="1"
                            CornerRadius="16">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <Path
                                    x:Name="Icon"
                                    Width="14"
                                    Height="14"
                                    Margin="0,0,6,0"
                                    Data="M64.004,133.44V44.565C63.504,20.486,82.592,0.548,106.671,0h85.333c12.306,0,22.283,9.976,22.283,22.283  s-9.976,22.283-22.283,22.283h-54.635l125.995,131.797c0.865,0.93,2.079,1.456,3.349,1.451l0,0c1.262,0.016,2.471-0.503,3.328-1.429  L416.943,23.232c20.523-20.693,49.579,11.563,30.165,31.467l-146.88,153.088c-8.702,9.22-20.815,14.451-33.493,14.464l0,0  c-12.701-0.026-24.83-5.28-33.536-14.528L106.671,75.371v58.069c0,11.782-9.551,21.333-21.333,21.333S64.004,145.222,64.004,133.44z   M478.831,342.507c-95.765-99.797-349.867-99.819-445.632,0C11.562,365.05-0.358,395.188,0.004,426.432l1.728,25.045  C1.1,484.183,27.034,511.242,59.737,512c0.939,0,53.824-7.168,53.824-7.168c31.523-1.541,56.336-27.469,56.491-59.029l3.371-40.064  c26.202-10.792,54.244-16.413,82.581-16.555c28.357,0.41,56.391,6.096,82.667,16.768l3.328,39.851  c0.155,31.561,24.967,57.488,56.491,59.029c0,0,52.885,7.168,53.824,7.168c32.19-0.524,58.01-26.771,58.005-58.965l1.685-28.096  c0.041-30.723-11.862-60.259-33.195-82.368L478.831,342.507z"
                                    Fill="{StaticResource OtherBrushSubColor4}"
                                    Stretch="Uniform" />
                                <TextBlock
                                    x:Name="Label"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource InterFont}"
                                    FontSize="14"
                                    FontWeight="Medium"
                                    Foreground="{StaticResource OtherBrushSubColor4}">
                                    Не додзвонився
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </StackPanel>
</UserControl>
