<UserControl
    x:Class="EchoVault.Views.Call.IdleCallView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel HorizontalAlignment="Center">
        <TextBlock
            HorizontalAlignment="Center"
            FontFamily="{StaticResource InterFont}"
            FontSize="14"
            FontWeight="Bold"
            Foreground="{StaticResource Text}">
            Зараз не йде жодного дзвінка
        </TextBlock>
        <Grid
            Width="60"
            Height="60"
            Margin="0,12">
            <Ellipse Fill="{StaticResource BrushColor4}" Stroke="{StaticResource BrushBorderColor4}" />
            <Path
                Width="30"
                Height="30"
                Data="M22.183,22.164l.91-1.049a3.1,3.1,0,0,0,0-4.377c-.031-.031-2.437-1.882-2.437-1.882a3.1,3.1,0,0,0-4.281.006l-1.906,1.606A12.784,12.784,0,0,1,7.537,9.524l1.6-1.9a3.1,3.1,0,0,0,.007-4.282S7.291.939,7.26.908A3.082,3.082,0,0,0,2.934.862l-1.15,1C-5.01,9.744,9.62,24.261,17.762,24A6.155,6.155,0,0,0,22.183,22.164Z"
                Fill="{StaticResource SubText}"
                Stretch="Uniform" />
        </Grid>
        <Button
            Padding="12,8"
            HorizontalAlignment="Center"
            Command="{Binding RecordManuallyCommand}"
            Cursor="Hand">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Bg"
                        Padding="{TemplateBinding Padding}"
                        Background="{StaticResource BrushColor4}"
                        BorderBrush="{StaticResource BrushBorderColor4}"
                        BorderThickness="1"
                        CornerRadius="16">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <Path
                                x:Name="Icon"
                                Width="14"
                                Height="14"
                                Margin="0,0,6,0"
                                Data="m12,0C5.383,0,0,5.383,0,12s5.383,12,12,12,12-5.383,12-12S18.617,0,12,0Zm0,22c-5.514,0-10-4.486-10-10S6.486,2,12,2s10,4.486,10,10-4.486,10-10,10Zm4-10c0,2.209-1.791,4-4,4s-4-1.791-4-4,1.791-4,4-4,4,1.791,4,4Z"
                                Fill="{StaticResource SubText}"
                                Stretch="Uniform" />
                            <TextBlock
                                x:Name="Label"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource InterFont}"
                                FontSize="14"
                                FontWeight="Medium"
                                Foreground="{StaticResource SubText}">
                                Записати вручну
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </StackPanel>
</UserControl>
