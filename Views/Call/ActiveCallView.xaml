<UserControl
    x:Class="EchoVault.Views.Call.ActiveCallView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel HorizontalAlignment="Center">
        <TextBlock
            HorizontalAlignment="Center"
            FontFamily="{StaticResource InterFont}"
            FontSize="14"
            FontWeight="Bold"
            Foreground="{StaticResource BrushAccent}"
            Text="{Binding ElapsedTime}" />
        <Grid
            Width="60"
            Height="60"
            Margin="0,12">
            <Grid.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <!--  Wave 1  -->
                            <DoubleAnimation
                                BeginTime="0:0:0"
                                Storyboard.TargetName="Wave1Scale"
                                Storyboard.TargetProperty="ScaleX"
                                From="1"
                                To="1.8"
                                Duration="0:0:0.8" />
                            <DoubleAnimation
                                BeginTime="0:0:0"
                                Storyboard.TargetName="Wave1Scale"
                                Storyboard.TargetProperty="ScaleY"
                                From="1"
                                To="1.8"
                                Duration="0:0:0.8" />
                            <DoubleAnimation
                                BeginTime="0:0:0"
                                Storyboard.TargetName="Wave1"
                                Storyboard.TargetProperty="Opacity"
                                From="0.6"
                                To="0"
                                Duration="0:0:0.8" />
                            <!--  Wave 2  -->
                            <DoubleAnimation
                                BeginTime="0:0:0.4"
                                Storyboard.TargetName="Wave2Scale"
                                Storyboard.TargetProperty="ScaleX"
                                From="1"
                                To="1.8"
                                Duration="0:0:0.8" />
                            <DoubleAnimation
                                BeginTime="0:0:0.4"
                                Storyboard.TargetName="Wave2Scale"
                                Storyboard.TargetProperty="ScaleY"
                                From="1"
                                To="1.8"
                                Duration="0:0:0.8" />
                            <DoubleAnimation
                                BeginTime="0:0:0.4"
                                Storyboard.TargetName="Wave2"
                                Storyboard.TargetProperty="Opacity"
                                From="0.6"
                                To="0"
                                Duration="0:0:0.8" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>
            <Ellipse
                x:Name="Wave1"
                Opacity="0"
                RenderTransformOrigin="0.5,0.5"
                Stroke="{StaticResource BrushAccent}"
                StrokeThickness="1">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="Wave1Scale" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse
                x:Name="Wave2"
                Opacity="0"
                RenderTransformOrigin="0.5,0.5"
                Stroke="{StaticResource BrushAccent}"
                StrokeThickness="1">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="Wave2Scale" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Fill="{StaticResource BrushAccentBackground}" Stroke="{StaticResource BrushAccentBorder}" />
            <Path
                Width="30"
                Height="30"
                Data="M23,11a1,1,0,0,1-1-1,8.008,8.008,0,0,0-8-8,1,1,0,0,1,0-2A10.011,10.011,0,0,1,24,10,1,1,0,0,1,23,11Zm-3-1a6,6,0,0,0-6-6,1,1,0,1,0,0,2,4,4,0,0,1,4,4,1,1,0,0,0,2,0Zm2.183,12.164.91-1.049a3.1,3.1,0,0,0,0-4.377c-.031-.031-2.437-1.882-2.437-1.882a3.1,3.1,0,0,0-4.281.006l-1.906,1.606A12.784,12.784,0,0,1,7.537,9.524l1.6-1.9a3.1,3.1,0,0,0,.007-4.282S7.291.939,7.26.908A3.082,3.082,0,0,0,2.934.862l-1.15,1C-5.01,9.744,9.62,24.261,17.762,24A6.155,6.155,0,0,0,22.183,22.164Z"
                Fill="{StaticResource BrushAccent}"
                Stretch="Uniform" />
        </Grid>
        <Button
            Padding="12,8"
            HorizontalAlignment="Center"
            Command="{Binding StopCommand}"
            Cursor="Hand">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Bg"
                        Padding="{TemplateBinding Padding}"
                        Background="{StaticResource BrushAccentBackground}"
                        BorderBrush="{StaticResource BrushAccentBorder}"
                        BorderThickness="1"
                        CornerRadius="16">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <Path
                                x:Name="Icon"
                                Width="14"
                                Height="14"
                                Margin="0,0,6,0"
                                Data="M106.667,0h298.667C464.244,0,512,47.756,512,106.667v298.667C512,464.244,464.244,512,405.333,512H106.667  C47.756,512,0,464.244,0,405.333V106.667C0,47.756,47.756,0,106.667,0z"
                                Fill="{StaticResource BrushAccent}"
                                Stretch="Uniform" />
                            <TextBlock
                                x:Name="Label"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource InterFont}"
                                FontSize="14"
                                FontWeight="Medium"
                                Foreground="{StaticResource BrushAccent}">
                                Зупинити запис
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource BrushAccent}" />
                            <Setter TargetName="Icon" Property="Fill" Value="White" />
                            <Setter TargetName="Label" Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushAccentPressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </StackPanel>
</UserControl>
