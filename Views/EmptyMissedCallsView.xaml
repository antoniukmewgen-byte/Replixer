<UserControl
    x:Class="Replixer.Views.EmptyMissedCallsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid Width="60" Height="60">
            <Ellipse Fill="{StaticResource BrushColor4}" Stroke="{StaticResource BrushBorderColor4}" />
            <Path
                Width="26"
                Height="26"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Data="M1.172,19.119A4,4,0,0,0,0,21.947V24H2.053a4,4,0,0,0,2.828-1.172L18.224,9.485,14.515,5.776Z M23.145.855a2.622,2.622,0,0,0-3.71,0L15.929,4.362l3.709,3.709,3.507-3.506A2.622,2.622,0,0,0,23.145.855Z"
                Fill="{StaticResource SubText}"
                Stretch="Uniform" />
        </Grid>
        <TextBlock
            Margin="0,12,0,4"
            HorizontalAlignment="Center"
            FontFamily="{StaticResource InterFont}"
            FontSize="14"
            FontWeight="Bold"
            Foreground="{StaticResource Text}">
            Недодзвонів не знайдено
        </TextBlock>
        <TextBlock
            Width="300"
            Margin="0,0,0,12"
            HorizontalAlignment="Center"
            FontFamily="{StaticResource InterFont}"
            FontSize="12"
            FontWeight="Medium"
            Foreground="{StaticResource SubText}"
            TextAlignment="Center"
            TextWrapping="Wrap">
            Коли ви позначите дзвінок як недодзвон - запис з'явиться тут
        </TextBlock>
    </StackPanel>
</UserControl>
