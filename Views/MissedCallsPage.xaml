<UserControl
    x:Class="Replixer.Views.MissedCallsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="clr-namespace:Replixer.Models"
    xmlns:views="clr-namespace:Replixer.Views">
    <Border
        Margin="16"
        Padding="16,0,16,0"
        Background="{StaticResource BrushColor2}"
        BorderBrush="{StaticResource BrushBorderColor2}"
        BorderThickness="1"
        CornerRadius="12">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
            <Grid Margin="0,16,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    HorizontalAlignment="Left"
                    FontFamily="{StaticResource InterFont}"
                    FontSize="12"
                    FontWeight="Bold"
                    Foreground="{StaticResource SubText}">
                    НЕДОЗВОНИ
                </TextBlock>
                <views:EmptyMissedCallsView Grid.Row="1" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

                <ItemsControl
                    Grid.Row="1"
                    ItemsSource="{Binding MissedCalls}"
                    Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:MissedCallEntry}">
                            <views:MissedCallItemView />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </Grid>
        </ScrollViewer>
    </Border>
</UserControl>
