<Window
    x:Class="Replixer.Views.SetupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="500"
    Height="724"
    AllowsTransparency="True"
    Background="Transparent"
    Icon="/Assets/Icons/IconApp.png"
    ResizeMode="NoResize"
    RenderOptions.BitmapScalingMode="NearestNeighbor"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">

    <Window.Resources>
        <Style x:Key="SetupInput" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BrushColor4}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorderColor4}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,10" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource OtherBrushSubColor1}" />
                    <Setter Property="BorderThickness" Value="2" />
                    <Setter Property="Padding" Value="13,9" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border
        x:Name="RootBorder"
        Background="{StaticResource BrushColor1}"
        CornerRadius="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Title bar  -->
            <Grid
                Grid.Row="0"
                Background="Transparent"
                MouseDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Margin="16,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Image
                        Width="14"
                        Height="14"
                        Margin="0,0,8,0"
                        Source="/Assets/Icons/IconApp.png" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource InterFont}"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="{StaticResource Text}">
                        Replixer
                    </TextBlock>
                </StackPanel>

                <Button
                    x:Name="CloseButton"
                    Grid.Column="1"
                    Width="40"
                    Height="40"
                    Click="CloseButton_Click"
                    Cursor="Hand"
                    FocusVisualStyle="{x:Null}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bg"
                                Background="Transparent"
                                CornerRadius="0,16,0,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushColor3}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Path
                        Width="10"
                        Height="10"
                        Data="M301.258,256.01L502.645,54.645c12.501-12.501,12.501-32.769,0-45.269c-12.501-12.501-32.769-12.501-45.269,0l0,0L256.01,210.762L54.645,9.376c-12.501-12.501-32.769-12.501-45.269,0s-12.501,32.769,0,45.269L210.762,256.01L9.376,457.376c-12.501,12.501-12.501,32.769,0,45.269s32.769,12.501,45.269,0L256.01,301.258l201.365,201.387c12.501,12.501,32.769,12.501,45.269,0c12.501-12.501,12.501-32.769,0-45.269L301.258,256.01z"
                        Fill="{StaticResource SubText}"
                        Stretch="Uniform" />
                </Button>
            </Grid>

            <!--  Scrollable content  -->
            <ScrollViewer
                Grid.Row="1"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Hidden">
                <StackPanel Margin="28,0,28,28">

                    <!--  Header  -->
                    <Image
                        Width="48"
                        Height="48"
                        Margin="0,28,0,14"
                        HorizontalAlignment="Center"
                        Source="/Assets/Icons/IconApp.png" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontFamily="{StaticResource InterFont}"
                        FontSize="22"
                        FontWeight="Bold"
                        Foreground="{StaticResource Text}">
                        Вітаємо в Replixer!
                    </TextBlock>
                    <TextBlock
                        Margin="0,6,0,24"
                        HorizontalAlignment="Center"
                        FontFamily="{StaticResource InterFont}"
                        FontSize="13"
                        Foreground="{StaticResource SubText}">
                        Заповніть інформацію для початку роботи
                    </TextBlock>

                    <!--  ─── Card 1: Manager name ───────────────────────────  -->
                    <Border
                        Margin="0,0,0,10"
                        Padding="18"
                        Background="{StaticResource BrushColor2}"
                        BorderBrush="{StaticResource BrushBorderColor2}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel>
                            <!--  Label row  -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Grid.Column="0"
                                    Width="28"
                                    Height="28"
                                    Margin="0,0,10,0"
                                    Background="{StaticResource OtherBrushColor1}"
                                    CornerRadius="8">
                                    <Path
                                        Width="13"
                                        Height="13"
                                        Data="M384,128A128,128,0,1,1,256,0A128,128,0,0,1,384,128Z M256,298.667c-105.99,0.118-191.882,86.01-192,192C64,502.449,73.551,512,85.333,512h341.333c11.782,0,21.333-9.551,21.333-21.333C447.882,384.677,361.99,298.784,256,298.667Z"
                                        Fill="{StaticResource OtherBrushSubColor1}"
                                        Stretch="Uniform" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock
                                        FontFamily="{StaticResource InterFont}"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource Text}">
                                        Ім'я менеджера
                                    </TextBlock>
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        FontFamily="{StaticResource InterFont}"
                                        FontSize="11"
                                        Foreground="{StaticResource SubText}">
                                        Обов'язково · використовується для папки на Google Drive
                                    </TextBlock>
                                </StackPanel>
                            </Grid>

                            <!--  Input  -->
                            <Border Style="{StaticResource SetupInput}">
                                <Grid>
                                    <TextBox
                                        x:Name="NameBox"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        CaretBrush="{StaticResource Text}"
                                        FontFamily="{StaticResource InterFont}"
                                        FontSize="14"
                                        Foreground="{StaticResource Text}"
                                        Text="{Binding ManagerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource InterFont}"
                                        FontSize="14"
                                        Foreground="{StaticResource SubText}"
                                        IsHitTestVisible="False"
                                        Text="Наприклад: Олексій Коваль">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=NameBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!--  ─── Card 2: Google Drive ──────────────────────────  -->
                    <Border
                        Margin="0,0,0,10"
                        Padding="18"
                        Background="{StaticResource BrushColor2}"
                        BorderBrush="{StaticResource BrushBorderColor2}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel>
                            <!--  Label row  -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Grid.Column="0"
                                    Width="28"
                                    Height="28"
                                    Margin="0,0,10,0"
                                    Background="{StaticResource OtherBrushColor3}"
                                    CornerRadius="8">
                                    <Path
                                        Width="13"
                                        Height="13"
                                        Data="M480.768,87.936l-56.704-56.704c-5.674-5.585-11.957-10.515-18.731-14.699V64c-0.071,58.881-47.786,106.596-106.667,106.667h-85.333C154.452,170.596,106.737,122.881,106.667,64V0C47.786,0.071,0.071,47.786,0,106.667v298.667C0.071,464.215,47.786,511.93,106.667,512h298.667C464.214,511.93,511.93,464.215,512,405.334V163.35C512.08,135.049,500.833,107.893,480.768,87.936z M256,384c-47.128,0-85.333-38.205-85.333-85.333s38.205-85.333,85.333-85.333s85.333,38.205,85.333,85.333S303.128,384,256,384z M213.333,128h85.333c35.346,0,64-28.654,64-64V1.366c-4.638-0.756-9.32-1.212-14.016-1.365H149.333v64C149.333,99.346,177.987,128,213.333,128z"
                                        Fill="{StaticResource OtherBrushSubColor3}"
                                        Stretch="Uniform" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock
                                        FontFamily="{StaticResource InterFont}"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource Text}">
                                        Google Drive
                                    </TextBlock>
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        FontFamily="{StaticResource InterFont}"
                                        FontSize="11"
                                        Foreground="{StaticResource SubText}">
                                        Необов'язково · можна налаштувати пізніше
                                    </TextBlock>
                                </StackPanel>
                            </Grid>

                            <!--  Input + test button  -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource SetupInput}">
                                    <Grid>
                                        <TextBox
                                            x:Name="DriveIdBox"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            CaretBrush="{StaticResource Text}"
                                            FontFamily="{StaticResource InterFont}"
                                            FontSize="14"
                                            Foreground="{StaticResource Text}"
                                            Text="{Binding GoogleDriveFolderId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            ToolTip="Вставте ID Shared Drive або папки з URL" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource InterFont}"
                                            FontSize="14"
                                            Foreground="{StaticResource SubText}"
                                            IsHitTestVisible="False"
                                            Text="ID головної папки">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=DriveIdBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <Button
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    Padding="12,10"
                                    Command="{Binding TestDriveConnectionCommand}"
                                    Cursor="Hand"
                                    FocusVisualStyle="{x:Null}"
                                    ToolTip="{Binding DriveConnectionError}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCheckingDrive}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                    <Setter Property="Cursor" Value="Arrow" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDriveConnected}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                    <Setter Property="Cursor" Value="Arrow" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                x:Name="Bg"
                                                Padding="{TemplateBinding Padding}"
                                                Background="{StaticResource BrushColor4}"
                                                BorderBrush="{StaticResource BrushBorderColor4}"
                                                BorderThickness="1"
                                                CornerRadius="10">
                                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                    <Path
                                                        x:Name="CheckIcon"
                                                        Width="11"
                                                        Height="11"
                                                        Margin="0,0,6,0"
                                                        Data="M20.285,2l-11.285,11.567l-5.286,-5.011l-3.714,3.716l9,8.728l15,-15.285z"
                                                        Fill="{StaticResource OtherBrushSubColor1}"
                                                        Stretch="Uniform"
                                                        Visibility="Collapsed" />
                                                    <Path
                                                        x:Name="ErrorIcon"
                                                        Width="11"
                                                        Height="11"
                                                        Margin="0,0,6,0"
                                                        Data="M19,6.41L17.59,5 12,10.59 6.41,5 5,6.41 10.59,12 5,17.59 6.41,19 12,13.41 17.59,19 19,17.59 13.41,12z"
                                                        Fill="{StaticResource OtherBrushSubColor4}"
                                                        Stretch="Uniform"
                                                        Visibility="Collapsed" />
                                                    <TextBlock
                                                        x:Name="Label"
                                                        FontFamily="{StaticResource InterFont}"
                                                        FontSize="13"
                                                        FontWeight="Medium"
                                                        Foreground="{StaticResource SubText}"
                                                        Text="Перевірити" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsCheckingDrive}" Value="True">
                                                    <Setter TargetName="Label" Property="Text" Value="Перевірка..." />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDriveConnected}" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource OtherBrushColor1}" />
                                                    <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource OtherBrushSubColor1}" />
                                                    <Setter TargetName="Label" Property="Text" Value="Підключено" />
                                                    <Setter TargetName="Label" Property="Foreground" Value="{StaticResource OtherBrushSubColor1}" />
                                                    <Setter TargetName="CheckIcon" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDriveConnected}" Value="False">
                                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource OtherBrushColor4}" />
                                                    <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource OtherBrushSubColor4}" />
                                                    <Setter TargetName="Label" Property="Text" Value="Помилка" />
                                                    <Setter TargetName="Label" Property="Foreground" Value="{StaticResource OtherBrushSubColor4}" />
                                                    <Setter TargetName="ErrorIcon" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!--  ─── Card 3: Telegram ─────────────────────────────  -->
                    <Border
                        Margin="0,0,0,20"
                        Padding="18"
                        Background="{StaticResource BrushColor2}"
                        BorderBrush="{StaticResource BrushBorderColor2}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel>
                            <!--  Label row  -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Grid.Column="0"
                                    Width="28"
                                    Height="28"
                                    Margin="0,0,10,0"
                                    Background="{StaticResource BrushTelegram}"
                                    CornerRadius="8">
                                    <Image
                                        Width="15"
                                        Height="15"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Source="/Assets/Icons/telegram.png" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock
                                        FontFamily="{StaticResource InterFont}"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource Text}">
                                        Telegram
                                    </TextBlock>
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        FontFamily="{StaticResource InterFont}"
                                        FontSize="11"
                                        Foreground="{StaticResource SubText}">
                                        Необов'язково · можна налаштувати пізніше
                                    </TextBlock>
                                </StackPanel>
                            </Grid>

                            <!--  Group selector  -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource InterFont}"
                                    FontSize="13"
                                    Foreground="{StaticResource SubText}">
                                    Група для відправки
                                </TextBlock>
                                <ComboBox
                                    Grid.Column="1"
                                    MinWidth="160"
                                    ItemsSource="{Binding TelegramChats}"
                                    SelectedItem="{Binding SelectedTelegramChat, Mode=TwoWay}">
                                    <ComboBox.Style>
                                        <Style TargetType="ComboBox">
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                                            <Setter Property="FontFamily" Value="{StaticResource InterFont}" />
                                            <Setter Property="FontSize" Value="13" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ComboBox">
                                                        <Grid>
                                                            <Border
                                                                x:Name="Bg"
                                                                Background="{StaticResource BrushColor4}"
                                                                BorderBrush="{StaticResource BrushBorderColor4}"
                                                                BorderThickness="1"
                                                                CornerRadius="8">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="30" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <ContentPresenter
                                                                        Grid.Column="0"
                                                                        Margin="12,7,0,7"
                                                                        VerticalAlignment="Center"
                                                                        Content="{TemplateBinding SelectionBoxItem}"
                                                                        ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                                        IsHitTestVisible="False"
                                                                        TextBlock.FontFamily="{TemplateBinding FontFamily}"
                                                                        TextBlock.FontSize="{TemplateBinding FontSize}"
                                                                        TextBlock.Foreground="{TemplateBinding Foreground}" />
                                                                    <Path
                                                                        x:Name="Arrow"
                                                                        Grid.Column="1"
                                                                        Width="10"
                                                                        Height="10"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        Data="M18.71,8.21a1,1,0,0,0-1.42,0l-4.58,4.58a1,1,0,0,1-1.42,0L6.71,8.21a1,1,0,0,0-1.42,0,1,1,0,0,0,0,1.41l4.59,4.59a3,3,0,0,0,4.24,0l4.59-4.59A1,1,0,0,0,18.71,8.21Z"
                                                                        Fill="{StaticResource SubText}"
                                                                        RenderTransformOrigin="0.5,0.5"
                                                                        Stretch="Uniform">
                                                                        <Path.RenderTransform>
                                                                            <RotateTransform Angle="0" />
                                                                        </Path.RenderTransform>
                                                                    </Path>
                                                                </Grid>
                                                            </Border>
                                                            <ToggleButton
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Focusable="False"
                                                                IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                                Opacity="0" />
                                                            <Popup
                                                                x:Name="PART_Popup"
                                                                AllowsTransparency="True"
                                                                Focusable="False"
                                                                IsOpen="{TemplateBinding IsDropDownOpen}"
                                                                Placement="Bottom"
                                                                PopupAnimation="Fade">
                                                                <Border
                                                                    MinWidth="{Binding ActualWidth, ElementName=Bg}"
                                                                    Margin="0,4,0,0"
                                                                    Padding="4"
                                                                    Background="{StaticResource BrushColor2}"
                                                                    BorderBrush="{StaticResource BrushBorderColor2}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="8">
                                                                    <ScrollViewer
                                                                        MaxHeight="220"
                                                                        CanContentScroll="True"
                                                                        VerticalScrollBarVisibility="Auto">
                                                                        <ItemsPresenter />
                                                                    </ScrollViewer>
                                                                </Border>
                                                            </Popup>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource BrushBorderColor4}" />
                                                                <Setter TargetName="Bg" Property="Opacity" Value="0.85" />
                                                            </Trigger>
                                                            <Trigger Property="IsDropDownOpen" Value="True">
                                                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource OtherBrushSubColor1}" />
                                                                <Setter TargetName="Arrow" Property="RenderTransform">
                                                                    <Setter.Value>
                                                                        <RotateTransform Angle="180" />
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="ItemContainerStyle">
                                                <Setter.Value>
                                                    <Style TargetType="ComboBoxItem">
                                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                        <Setter Property="FontFamily" Value="{StaticResource InterFont}" />
                                                        <Setter Property="FontSize" Value="13" />
                                                        <Setter Property="Foreground" Value="{StaticResource Text}" />
                                                        <Setter Property="Cursor" Value="Hand" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ComboBoxItem">
                                                                    <Border
                                                                        x:Name="Bg"
                                                                        Padding="10,7"
                                                                        Background="Transparent"
                                                                        CornerRadius="6">
                                                                        <ContentPresenter
                                                                            TextBlock.FontFamily="{TemplateBinding FontFamily}"
                                                                            TextBlock.FontSize="{TemplateBinding FontSize}"
                                                                            TextBlock.Foreground="{TemplateBinding Foreground}" />
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushColor3}" />
                                                                        </Trigger>
                                                                        <Trigger Property="IsSelected" Value="True">
                                                                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource OtherBrushColor1}" />
                                                                            <Setter Property="Foreground" Value="{StaticResource OtherBrushSubColor1}" />
                                                                        </Trigger>
                                                                        <MultiTrigger>
                                                                            <MultiTrigger.Conditions>
                                                                                <Condition Property="IsSelected" Value="True" />
                                                                                <Condition Property="IsMouseOver" Value="True" />
                                                                            </MultiTrigger.Conditions>
                                                                            <Setter TargetName="Bg" Property="Opacity" Value="0.82" />
                                                                        </MultiTrigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ComboBox.Style>
                                </ComboBox>
                            </Grid>

                            <!--  Phone + authorize  -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource SetupInput}">
                                    <Grid>
                                        <TextBox
                                            x:Name="PhoneBox"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            CaretBrush="{StaticResource Text}"
                                            FontFamily="{StaticResource InterFont}"
                                            FontSize="14"
                                            Foreground="{StaticResource Text}"
                                            Text="{Binding TelegramPhone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            ToolTip="+380XXXXXXXXX або 0XXXXXXXXX" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource InterFont}"
                                            FontSize="14"
                                            Foreground="{StaticResource SubText}"
                                            IsHitTestVisible="False"
                                            Text="+380...">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=PhoneBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <Button
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    Padding="12,10"
                                    Command="{Binding TelegramActionCommand}"
                                    Cursor="Hand"
                                    FocusVisualStyle="{x:Null}"
                                    ToolTip="{Binding TelegramAuthError}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAuthorizingTelegram}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                    <Setter Property="Cursor" Value="Arrow" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsTelegramConnected}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                    <Setter Property="Cursor" Value="Arrow" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                x:Name="Bg"
                                                Padding="{TemplateBinding Padding}"
                                                Background="{StaticResource BrushColor4}"
                                                BorderBrush="{StaticResource BrushBorderColor4}"
                                                BorderThickness="1"
                                                CornerRadius="10">
                                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                    <Path
                                                        x:Name="CheckIcon"
                                                        Width="11"
                                                        Height="11"
                                                        Margin="0,0,6,0"
                                                        Data="M20.285,2l-11.285,11.567l-5.286,-5.011l-3.714,3.716l9,8.728l15,-15.285z"
                                                        Fill="{StaticResource OtherBrushSubColor1}"
                                                        Stretch="Uniform"
                                                        Visibility="Collapsed" />
                                                    <Path
                                                        x:Name="ErrorIcon"
                                                        Width="11"
                                                        Height="11"
                                                        Margin="0,0,6,0"
                                                        Data="M19,6.41L17.59,5 12,10.59 6.41,5 5,6.41 10.59,12 5,17.59 6.41,19 12,13.41 17.59,19 19,17.59 13.41,12z"
                                                        Fill="{StaticResource OtherBrushSubColor4}"
                                                        Stretch="Uniform"
                                                        Visibility="Collapsed" />
                                                    <TextBlock
                                                        x:Name="Label"
                                                        FontFamily="{StaticResource InterFont}"
                                                        FontSize="13"
                                                        FontWeight="Medium"
                                                        Foreground="{StaticResource SubText}"
                                                        Text="Авторизувати" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsAuthorizingTelegram}" Value="True">
                                                    <Setter TargetName="Label" Property="Text" Value="Авторизація..." />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsTelegramConnected}" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource OtherBrushColor1}" />
                                                    <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource OtherBrushSubColor1}" />
                                                    <Setter TargetName="Label" Property="Text" Value="Авторизовано" />
                                                    <Setter TargetName="Label" Property="Foreground" Value="{StaticResource OtherBrushSubColor1}" />
                                                    <Setter TargetName="CheckIcon" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsTelegramConnected}" Value="False">
                                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource OtherBrushColor4}" />
                                                    <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource OtherBrushSubColor4}" />
                                                    <Setter TargetName="Label" Property="Text" Value="Помилка" />
                                                    <Setter TargetName="Label" Property="Foreground" Value="{StaticResource OtherBrushSubColor4}" />
                                                    <Setter TargetName="ErrorIcon" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <!--  Auth error  -->
                            <TextBlock
                                Margin="0,8,0,0"
                                FontFamily="{StaticResource InterFont}"
                                FontSize="12"
                                Foreground="{StaticResource OtherBrushSubColor4}"
                                Text="{Binding TelegramAuthError}"
                                TextWrapping="Wrap"
                                Visibility="{Binding TelegramAuthError, Converter={StaticResource NullToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <!--  ─── CTA button ──────────────────────────────────  -->
                    <Button
                        Height="52"
                        Command="{Binding FinishCommand}"
                        Cursor="Hand"
                        FocusVisualStyle="{x:Null}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border
                                    x:Name="Bg"
                                    Background="{StaticResource OtherBrushColor1}"
                                    BorderBrush="{StaticResource OtherBrushSubColor1}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                    <TextBlock
                                        x:Name="Label"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource InterFont}"
                                        FontSize="15"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource OtherBrushSubColor1}"
                                        Text="Почати роботу →" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Opacity" Value="0.82" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bg" Property="Opacity" Value="0.65" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushColor3}" />
                                        <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource BrushBorderColor3}" />
                                        <Setter TargetName="Label" Property="Foreground" Value="{StaticResource SubText}" />
                                        <Setter TargetName="Label" Property="Text" Value="Введіть ім'я менеджера" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                </StackPanel>
            </ScrollViewer>

            <!--  Modal overlay (Telegram verification code dialog)  -->
            <Grid
                Grid.RowSpan="2"
                Visibility="{Binding Dialog, Converter={StaticResource NullToVisibility}}">
                <Rectangle
                    Fill="{StaticResource BrushColor1}"
                    Opacity="0.88"
                    RadiusX="16"
                    RadiusY="16" />
                <ContentControl
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="{Binding Dialog}" />
            </Grid>

        </Grid>
    </Border>
</Window>
