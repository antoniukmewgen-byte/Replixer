<UserControl
    x:Class="Replixer.Views.Controls.NumberWheel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="34"
    Height="50"
    Background="Transparent"
    ClipToBounds="True"
    Cursor="SizeNS">
    <Border
        Background="{StaticResource BrushColor4}"
        BorderBrush="{StaticResource BrushBorderColor4}"
        BorderThickness="1"
        CornerRadius="6">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock
                x:Name="PrevText"
                HorizontalAlignment="Center"
                FontFamily="{StaticResource InterFont}"
                FontSize="9"
                Foreground="{StaticResource SubText}"
                Opacity="0.35" />
            <TextBlock
                x:Name="CurrentText"
                Margin="0,0"
                HorizontalAlignment="Center"
                FontFamily="{StaticResource InterFont}"
                FontSize="14"
                FontWeight="Bold"
                Foreground="{StaticResource Text}" />
            <TextBlock
                x:Name="NextText"
                HorizontalAlignment="Center"
                FontFamily="{StaticResource InterFont}"
                FontSize="9"
                Foreground="{StaticResource SubText}"
                Opacity="0.35" />
        </StackPanel>
    </Border>
</UserControl>
