<UserControl
    x:Class="Replixer.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
        <StackPanel Margin="16">

            <!--  Профіль  -->
            <Border
                Padding="16"
                Background="{StaticResource BrushColor2}"
                BorderBrush="{StaticResource BrushBorderColor2}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,12"
                        FontFamily="{StaticResource InterFont}"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="{StaticResource SubText}">
                        ПРОФІЛЬ
                    </TextBlock>
                    <Border
                        Padding="16"
                        Background="{StaticResource BrushColor3}"
                        BorderBrush="{StaticResource BrushBorderColor3}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Column="0"
                                Width="38"
                                Height="38"
                                Background="{StaticResource OtherBrushColor1}"
                                CornerRadius="8">
                                <Path
                                    Width="18"
                                    Height="18"
                                    Data="M384,128A128,128,0,1,1,256,0A128,128,0,0,1,384,128Z     M256,298.667c-105.99,0.118-191.882,86.01-192,192C64,502.449,73.551,512,85.333,512h341.333c11.782,0,21.333-9.551,21.333-21.333C447.882,384.677,361.99,298.784,256,298.667Z"
                                    Fill="{StaticResource OtherBrushSubColor1}"
                                    Stretch="Uniform" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" Orientation="Vertical">
                                <Border Style="{StaticResource AppInputBorder}">
                                    <Grid>
                                        <TextBox
                                            x:Name="NameBox"
                                            Style="{StaticResource AppTextBox}"
                                            Text="{Binding ManagerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource InterFont}"
                                            FontSize="14"
                                            Foreground="{StaticResource SubText}"
                                            IsHitTestVisible="False"
                                            Text="Ім'я менеджера">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=NameBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <ComboBox
                                    Margin="0,8,0,0"
                                    ItemsSource="{Binding Positions}"
                                    SelectedItem="{Binding Position, Mode=TwoWay}"
                                    Style="{StaticResource AppComboBox}"
                                    Tag="Посада" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!--  Telegram  -->
            <Border
                Margin="0,12,0,0"
                Padding="16"
                Background="{StaticResource BrushColor2}"
                BorderBrush="{StaticResource BrushBorderColor2}"
                BorderThickness="1"
                CornerRadius="12"
                Visibility="{Binding IsTelegramVisible, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,12"
                        FontFamily="{StaticResource InterFont}"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="{StaticResource SubText}">
                        ТЕЛЕГРАМ
                    </TextBlock>

                    <!--  Toggle row  -->
                    <Border
                        Padding="16"
                        Background="{StaticResource BrushColor3}"
                        BorderBrush="{StaticResource BrushBorderColor3}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Column="0"
                                Width="38"
                                Height="38"
                                Background="{StaticResource BrushTelegram}"
                                CornerRadius="8">
                                <Image
                                    Width="18"
                                    Height="18"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Source="/Assets/Icons/telegram.png" />
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                Margin="12,0,12,0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    FontFamily="{StaticResource InterFont}"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource Text}">
                                    Telegram
                                </TextBlock>
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontFamily="{StaticResource InterFont}"
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="{StaticResource SubText}"
                                    TextWrapping="Wrap">
                                    Автоматично надсилати запис у Telegram
                                </TextBlock>
                            </StackPanel>
                            <ToggleButton
                                Grid.Column="2"
                                IsChecked="{Binding IsTelegramEnabled, Mode=TwoWay}"
                                Style="{StaticResource ToggleSwitch}" />
                        </Grid>
                    </Border>

                    <!--  Auth settings (shown when enabled)  -->
                    <Border
                        Margin="0,12,0,0"
                        Padding="16"
                        Background="{StaticResource BrushColor3}"
                        BorderBrush="{StaticResource BrushBorderColor3}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="{Binding IsTelegramEnabled, Converter={StaticResource BoolToVis}}">
                        <StackPanel>

                            <!--  Phone + Authorize  -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource AppInputBorder}">
                                    <Grid>
                                        <TextBox
                                            x:Name="PhoneBox"
                                            Style="{StaticResource AppTextBox}"
                                            Text="{Binding TelegramPhone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource InterFont}"
                                            FontSize="14"
                                            Foreground="{StaticResource SubText}"
                                            IsHitTestVisible="False"
                                            Text="Номер телефону">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=PhoneBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <Button
                                    Grid.Column="1"
                                    Margin="12,0,0,0"
                                    Padding="12,8"
                                    HorizontalAlignment="Right"
                                    Command="{Binding TelegramActionCommand}"
                                    Cursor="Hand"
                                    ToolTip="{Binding TelegramAuthError}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAuthorizingTelegram}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                    <Setter Property="Cursor" Value="Arrow" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsTelegramConnected}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                    <Setter Property="Cursor" Value="Arrow" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                x:Name="Bg"
                                                Padding="{TemplateBinding Padding}"
                                                Background="{StaticResource BrushColor4}"
                                                BorderBrush="{StaticResource BrushBorderColor4}"
                                                BorderThickness="1"
                                                CornerRadius="16">
                                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                    <Path
                                                        x:Name="CheckIcon"
                                                        Width="12"
                                                        Height="12"
                                                        Margin="0,0,6,0"
                                                        Data="M20.285,2l-11.285,11.567l-5.286,-5.011l-3.714,3.716l9,8.728l15,-15.285z"
                                                        Fill="{StaticResource OtherBrushSubColor1}"
                                                        Stretch="Uniform"
                                                        Visibility="Collapsed" />
                                                    <Path
                                                        x:Name="ErrorIcon"
                                                        Width="12"
                                                        Height="12"
                                                        Margin="0,0,6,0"
                                                        Data="M19,6.41L17.59,5 12,10.59 6.41,5 5,6.41 10.59,12 5,17.59 6.41,19 12,13.41 17.59,19 19,17.59 13.41,12z"
                                                        Fill="{StaticResource OtherBrushSubColor4}"
                                                        Stretch="Uniform"
                                                        Visibility="Collapsed" />
                                                    <TextBlock
                                                        x:Name="Label"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontFamily="{StaticResource InterFont}"
                                                        FontSize="14"
                                                        FontWeight="Medium"
                                                        Foreground="{StaticResource SubText}"
                                                        Text="Авторизувати" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsAuthorizingTelegram}" Value="True">
                                                    <Setter TargetName="Label" Property="Text" Value="Авторизація..." />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsTelegramConnected}" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource OtherBrushColor1}" />
                                                    <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource OtherBrushSubColor1}" />
                                                    <Setter TargetName="Label" Property="Text" Value="Авторизовано" />
                                                    <Setter TargetName="Label" Property="Foreground" Value="{StaticResource OtherBrushSubColor1}" />
                                                    <Setter TargetName="CheckIcon" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsTelegramConnected}" Value="False">
                                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource OtherBrushColor4}" />
                                                    <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource OtherBrushSubColor4}" />
                                                    <Setter TargetName="Label" Property="Text" Value="Помилка" />
                                                    <Setter TargetName="Label" Property="Foreground" Value="{StaticResource OtherBrushSubColor4}" />
                                                    <Setter TargetName="ErrorIcon" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Opacity" Value="0.75" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Bg" Property="Opacity" Value="0.5" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="Bg" Property="Opacity" Value="0.3" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <!--  Chat selector  -->
                            <ComboBox
                                MinWidth="150"
                                Margin="0,12,0,0"
                                ItemsSource="{Binding FilteredTelegramChats}"
                                SelectedItem="{Binding SelectedTelegramChat, Mode=TwoWay}"
                                Style="{StaticResource AppComboBox}"
                                Tag="Оберіть чат" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!--  Хмарне сховище  -->
            <Border
                Margin="0,12,0,0"
                Padding="16"
                Background="{StaticResource BrushColor2}"
                BorderBrush="{StaticResource BrushBorderColor2}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,12"
                        FontFamily="{StaticResource InterFont}"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="{StaticResource SubText}">
                        ХМАРНЕ СХОВИЩЕ
                    </TextBlock>

                    <!--  Toggle row  -->
                    <Border
                        Padding="16"
                        Background="{StaticResource BrushColor3}"
                        BorderBrush="{StaticResource BrushBorderColor3}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Column="0"
                                Width="38"
                                Height="38"
                                Background="{StaticResource OtherBrushColor3}"
                                CornerRadius="8">
                                <Path
                                    Width="18"
                                    Height="18"
                                    Data="M480.768,87.936l-56.704-56.704c-5.674-5.585-11.957-10.515-18.731-14.699V64 c-0.071,58.881-47.786,106.596-106.667,106.667h-85.333C154.452,170.596,106.737,122.881,106.667,64V0 C47.786,0.071,0.071,47.786,0,106.667v298.667C0.071,464.215,47.786,511.93,106.667,512h298.667 C464.214,511.93,511.93,464.215,512,405.334V163.35C512.08,135.049,500.833,107.893,480.768,87.936z M256,384 c-47.128,0-85.333-38.205-85.333-85.333s38.205-85.333,85.333-85.333s85.333,38.205,85.333,85.333S303.128,384,256,384z M213.333,128h85.333c35.346,0,64-28.654,64-64V1.366c-4.638-0.756-9.32-1.212-14.016-1.365H149.333v64 C149.333,99.346,177.987,128,213.333,128z"
                                    Fill="{StaticResource OtherBrushSubColor3}"
                                    Stretch="Uniform" />
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                Margin="12,0,12,0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    FontFamily="{StaticResource InterFont}"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource Text}">
                                    Google Drive
                                </TextBlock>
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontFamily="{StaticResource InterFont}"
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="{StaticResource SubText}"
                                    TextWrapping="Wrap">
                                    Автоматично завантажувати запис на Google Drive
                                </TextBlock>
                            </StackPanel>
                            <ToggleButton
                                Grid.Column="2"
                                IsChecked="{Binding IsGoogleDriveEnabled, Mode=TwoWay}"
                                Style="{StaticResource ToggleSwitch}" />
                        </Grid>
                    </Border>

                    <!--  Folder ID + Test (shown when enabled)  -->
                    <Border
                        Margin="0,12,0,0"
                        Padding="16"
                        Background="{StaticResource BrushColor3}"
                        BorderBrush="{StaticResource BrushBorderColor3}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="{Binding IsGoogleDriveEnabled, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource AppInputBorder}">
                                <Grid>
                                    <TextBox
                                        x:Name="FolderIdBox"
                                        Style="{StaticResource AppTextBox}"
                                        Text="{Binding GoogleDriveFolderId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource InterFont}"
                                        FontSize="14"
                                        Foreground="{StaticResource SubText}"
                                        IsHitTestVisible="False"
                                        Text="ID головної папки (Shared Drive)">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=FolderIdBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                            <Button
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                Padding="12,8"
                                HorizontalAlignment="Right"
                                Command="{Binding TestDriveConnectionCommand}"
                                Cursor="Hand"
                                ToolTip="{Binding DriveConnectionError}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCheckingDrive}" Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                                <Setter Property="Cursor" Value="Arrow" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDriveConnected}" Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                                <Setter Property="Cursor" Value="Arrow" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border
                                            x:Name="Bg"
                                            Padding="{TemplateBinding Padding}"
                                            Background="{StaticResource BrushColor4}"
                                            BorderBrush="{StaticResource BrushBorderColor4}"
                                            BorderThickness="1"
                                            CornerRadius="16">
                                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                <Path
                                                    x:Name="CheckIcon"
                                                    Width="12"
                                                    Height="12"
                                                    Margin="0,0,6,0"
                                                    Data="M20.285,2l-11.285,11.567l-5.286,-5.011l-3.714,3.716l9,8.728l15,-15.285z"
                                                    Fill="{StaticResource OtherBrushSubColor1}"
                                                    Stretch="Uniform"
                                                    Visibility="Collapsed" />
                                                <Path
                                                    x:Name="ErrorIcon"
                                                    Width="12"
                                                    Height="12"
                                                    Margin="0,0,6,0"
                                                    Data="M19,6.41L17.59,5 12,10.59 6.41,5 5,6.41 10.59,12 5,17.59 6.41,19 12,13.41 17.59,19 19,17.59 13.41,12z"
                                                    Fill="{StaticResource OtherBrushSubColor4}"
                                                    Stretch="Uniform"
                                                    Visibility="Collapsed" />
                                                <TextBlock
                                                    x:Name="Label"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontFamily="{StaticResource InterFont}"
                                                    FontSize="14"
                                                    FontWeight="Medium"
                                                    Foreground="{StaticResource SubText}"
                                                    Text="Перевірити" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsCheckingDrive}" Value="True">
                                                <Setter TargetName="Label" Property="Text" Value="Перевірка..." />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDriveConnected}" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource OtherBrushColor1}" />
                                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource OtherBrushSubColor1}" />
                                                <Setter TargetName="Label" Property="Text" Value="Підключено" />
                                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource OtherBrushSubColor1}" />
                                                <Setter TargetName="CheckIcon" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDriveConnected}" Value="False">
                                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource OtherBrushColor4}" />
                                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource OtherBrushSubColor4}" />
                                                <Setter TargetName="Label" Property="Text" Value="Немає доступу" />
                                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource OtherBrushSubColor4}" />
                                                <Setter TargetName="ErrorIcon" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Opacity" Value="0.75" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Bg" Property="Opacity" Value="0.5" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Bg" Property="Opacity" Value="0.3" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!--  Kommo CRM  -->
            <Border
                Margin="0,12,0,0"
                Padding="16"
                Background="{StaticResource BrushColor2}"
                BorderBrush="{StaticResource BrushBorderColor2}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,12"
                        FontFamily="{StaticResource InterFont}"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="{StaticResource SubText}">
                        KOMMO CRM
                    </TextBlock>

                    <!--  Toggle row  -->
                    <Border
                        Padding="16"
                        Background="{StaticResource BrushColor3}"
                        BorderBrush="{StaticResource BrushBorderColor3}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Column="0"
                                Width="38"
                                Height="38"
                                Background="#1A2A3A"
                                CornerRadius="8">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource InterFont}"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="#4A9EFF">
                                    K
                                </TextBlock>
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                Margin="12,0,12,0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    FontFamily="{StaticResource InterFont}"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource Text}">
                                    Kommo
                                </TextBlock>
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontFamily="{StaticResource InterFont}"
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="{StaticResource SubText}"
                                    TextWrapping="Wrap">
                                    Автоматично додавати нотатку в угоду Kommo
                                </TextBlock>
                            </StackPanel>
                            <ToggleButton
                                Grid.Column="2"
                                IsChecked="{Binding IsKommoEnabled, Mode=TwoWay}"
                                Style="{StaticResource ToggleSwitch}" />
                        </Grid>
                    </Border>

                    <!--  Subdomain + Token + Test (shown when enabled)  -->
                    <Border
                        Margin="0,12,0,0"
                        Padding="16"
                        Background="{StaticResource BrushColor3}"
                        BorderBrush="{StaticResource BrushBorderColor3}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="{Binding IsKommoEnabled, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <!--  Subdomain row  -->
                            <Border Margin="0,0,0,12" Style="{StaticResource AppInputBorder}">
                                <Grid>
                                    <TextBox
                                        x:Name="KommoSubdomainBox"
                                        Style="{StaticResource AppTextBox}"
                                        Text="{Binding KommoSubdomain, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource InterFont}"
                                        FontSize="14"
                                        Foreground="{StaticResource SubText}"
                                        IsHitTestVisible="False"
                                        Text="Субдомен (напр. movenation)">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=KommoSubdomainBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                            <!--  Token + button row  -->
                            <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource AppInputBorder}">
                                <Grid>
                                    <TextBox
                                        x:Name="KommoTokenBox"
                                        Style="{StaticResource AppTextBox}"
                                        Text="{Binding KommoApiToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource InterFont}"
                                        FontSize="14"
                                        Foreground="{StaticResource SubText}"
                                        IsHitTestVisible="False"
                                        Text="API токен">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=KommoTokenBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                            <Button
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                Padding="12,8"
                                HorizontalAlignment="Right"
                                Command="{Binding TestKommoConnectionCommand}"
                                Cursor="Hand"
                                ToolTip="{Binding KommoConnectionError}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCheckingKommo}" Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                                <Setter Property="Cursor" Value="Arrow" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsKommoConnected}" Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                                <Setter Property="Cursor" Value="Arrow" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border
                                            x:Name="Bg"
                                            Padding="{TemplateBinding Padding}"
                                            Background="{StaticResource BrushColor4}"
                                            BorderBrush="{StaticResource BrushBorderColor4}"
                                            BorderThickness="1"
                                            CornerRadius="16">
                                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                <Path
                                                    x:Name="CheckIcon"
                                                    Width="12"
                                                    Height="12"
                                                    Margin="0,0,6,0"
                                                    Data="M20.285,2l-11.285,11.567l-5.286,-5.011l-3.714,3.716l9,8.728l15,-15.285z"
                                                    Fill="{StaticResource OtherBrushSubColor1}"
                                                    Stretch="Uniform"
                                                    Visibility="Collapsed" />
                                                <Path
                                                    x:Name="ErrorIcon"
                                                    Width="12"
                                                    Height="12"
                                                    Margin="0,0,6,0"
                                                    Data="M19,6.41L17.59,5 12,10.59 6.41,5 5,6.41 10.59,12 5,17.59 6.41,19 12,13.41 17.59,19 19,17.59 13.41,12z"
                                                    Fill="{StaticResource OtherBrushSubColor4}"
                                                    Stretch="Uniform"
                                                    Visibility="Collapsed" />
                                                <TextBlock
                                                    x:Name="Label"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontFamily="{StaticResource InterFont}"
                                                    FontSize="14"
                                                    FontWeight="Medium"
                                                    Foreground="{StaticResource SubText}"
                                                    Text="Перевірити" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsCheckingKommo}" Value="True">
                                                <Setter TargetName="Label" Property="Text" Value="Перевірка..." />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsKommoConnected}" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource OtherBrushColor1}" />
                                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource OtherBrushSubColor1}" />
                                                <Setter TargetName="Label" Property="Text" Value="Авторизовано" />
                                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource OtherBrushSubColor1}" />
                                                <Setter TargetName="CheckIcon" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsKommoConnected}" Value="False">
                                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource OtherBrushColor4}" />
                                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource OtherBrushSubColor4}" />
                                                <Setter TargetName="Label" Property="Text" Value="Помилка" />
                                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource OtherBrushSubColor4}" />
                                                <Setter TargetName="ErrorIcon" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Opacity" Value="0.75" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Bg" Property="Opacity" Value="0.5" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Bg" Property="Opacity" Value="0.3" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
                </StackPanel>
            </Border>

            <!--  Небезпечна зона  -->
            <Border
                Margin="0,12,0,0"
                Padding="16"
                Background="{StaticResource BrushColor2}"
                BorderBrush="{StaticResource BrushBorderColor2}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,12"
                        FontFamily="{StaticResource InterFont}"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="{StaticResource SubText}">
                        НЕБЕЗПЕЧНА ЗОНА
                    </TextBlock>
                    <Border
                        Padding="16"
                        Background="{StaticResource BrushColor3}"
                        BorderBrush="{StaticResource BrushBorderColor3}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Column="0"
                                Width="38"
                                Height="38"
                                Background="{StaticResource OtherBrushColor4}"
                                CornerRadius="8">
                                <Path
                                    Width="18"
                                    Height="18"
                                    Data="m22,4h-4.101c-.465-2.279-2.484-4-4.899-4h-2c-2.414,0-4.434,1.721-4.899,4H2c-.552,0-1,.447-1,1s.448,1,1,1h.86l1.296,13.479c.248,2.578,2.388,4.521,4.977,4.521h5.727c2.593,0,4.733-1.947,4.978-4.528l1.276-13.472h.885c.552,0,1-.447,1-1s-.448-1-1-1Zm-11-2h2c1.302,0,2.402.839,2.816,2h-7.631c.414-1.161,1.514-2,2.816-2Zm4.707,14.293c.391.391.391,1.023,0,1.414-.195.195-.451.293-.707.293s-.512-.098-.707-.293l-2.293-2.293-2.293,2.293c-.195.195-.451.293-.707.293s-.512-.098-.707-.293c-.391-.391-.391-1.023,0-1.414l2.293-2.293-2.293-2.293c-.391-.391-.391-1.023,0-1.414s1.023-.391,1.414,0l2.293,2.293,2.293-2.293c.391-.391,1.023-.391,1.414,0s.391,1.023,0,1.414l-2.293,2.293,2.293,2.293Z"
                                    Fill="{StaticResource OtherBrushSubColor4}"
                                    Stretch="Uniform" />
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                Margin="12,0,12,0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    FontFamily="{StaticResource InterFont}"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource Text}">
                                    Видалити всі дані
                                </TextBlock>
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontFamily="{StaticResource InterFont}"
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="{StaticResource SubText}"
                                    TextWrapping="Wrap">
                                    Записи, сесія Telegram та підключення будуть скинуті
                                </TextBlock>
                            </StackPanel>
                            <Button
                                Grid.Column="2"
                                Padding="12,8"
                                Command="{Binding ClearAllDataCommand}"
                                Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border
                                            x:Name="Bg"
                                            Padding="{TemplateBinding Padding}"
                                            Background="{StaticResource OtherBrushColor4}"
                                            BorderBrush="{StaticResource OtherBrushSubColor4}"
                                            BorderThickness="1"
                                            CornerRadius="16">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontFamily="{StaticResource InterFont}"
                                                FontSize="14"
                                                FontWeight="Medium"
                                                Foreground="{StaticResource OtherBrushSubColor4}"
                                                Text="Очистити" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Opacity" Value="0.75" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Bg" Property="Opacity" Value="0.5" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Bg" Property="Opacity" Value="0.3" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
