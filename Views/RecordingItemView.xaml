<UserControl
    x:Class="EchoVault.Views.RecordingItemView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="clr-namespace:EchoVault.Models">
    <Border
        Margin="0,12,0,0"
        Padding="16"
        Background="{StaticResource BrushColor3}"
        BorderBrush="{StaticResource BrushBorderColor3}"
        BorderThickness="1"
        CornerRadius="8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  Platform icon  -->
            <Border
                Grid.Column="0"
                Width="38"
                Height="38"
                CornerRadius="8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource BrushColor4}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Platform}" Value="Telegram">
                                <Setter Property="Background" Value="{StaticResource BrushTelegram}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Platform}" Value="Viber">
                                <Setter Property="Background" Value="{StaticResource BrushViber}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Platform}" Value="WhatsApp.Root">
                                <Setter Property="Background" Value="{StaticResource BrushWhatsApp}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Platform}" Value="Ringostat Smart Phone">
                                <Setter Property="Background" Value="{StaticResource BrushRingostat}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Image
                        Width="18"
                        Height="18"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Source="{Binding IconPath}"
                        Visibility="{Binding IsManual, Converter={StaticResource InverseBoolToVis}}" />
                    <Path
                        Width="16"
                        Height="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="M9.34,10.793a6.179,6.179,0,0,1,.545-8.275l.633-.634a6.179,6.179,0,0,1,8.274-.544,5.946,5.946,0,0,1,2.146,4.343,6.01,6.01,0,0,1-1.751,4.5l-1,1a6.018,6.018,0,0,1-4.246,1.758q-.129,0-.258-.006A5.95,5.95,0,0,1,9.34,10.793ZM18.757,16a5.214,5.214,0,0,0-3.707,1.535A15.14,15.14,0,0,1,4.272,22H3.122a1.121,1.121,0,0,1-.794-1.914l.7-.7a7.176,7.176,0,0,0,4.6-2.092l3.054-3.054A8,8,0,0,1,7.809,12.08a7.568,7.568,0,0,1-1.082-1.725L3.7,13.379a7.171,7.171,0,0,0-2.092,4.6l-.7.7A3.121,3.121,0,0,0,3.122,24h1.15a17.13,17.13,0,0,0,12.192-5.05A3.243,3.243,0,0,1,22,21.242V23a1,1,0,0,0,2,0V21.242A5.249,5.249,0,0,0,18.757,16Z"
                        Fill="{StaticResource SubText}"
                        Stretch="Uniform"
                        Visibility="{Binding IsManual, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Border>

            <!--  Text  -->
            <StackPanel
                Grid.Column="1"
                Margin="12,0,12,0"
                VerticalAlignment="Center">
                <TextBlock
                    FontFamily="{StaticResource InterFont}"
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="{StaticResource Text}"
                    Text="{Binding PlatformDisplayName}" />
                <StackPanel
                    Margin="0,4,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <Path
                            Width="12"
                            Height="12"
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            Data="M0,19a5.006,5.006,0,0,0,5,5H19a5.006,5.006,0,0,0,5-5V10H0Zm17-4.5A1.5,1.5,0,1,1,15.5,16,1.5,1.5,0,0,1,17,14.5Zm-5,0A1.5,1.5,0,1,1,10.5,16,1.5,1.5,0,0,1,12,14.5Zm-5,0A1.5,1.5,0,1,1,5.5,16,1.5,1.5,0,0,1,7,14.5ZM19,2H18V1a1,1,0,0,0-2,0V2H8V1A1,1,0,0,0,6,1V2H5A5.006,5.006,0,0,0,0,7V8H24V7A5.006,5.006,0,0,0,19,2Z"
                            Fill="{StaticResource SubText}"
                            Stretch="Uniform" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource InterFont}"
                            FontSize="12"
                            FontWeight="Medium"
                            Foreground="{StaticResource SubText}"
                            Text="{Binding DateDisplay}" />
                    </StackPanel>
                    <StackPanel
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Path
                            Width="12"
                            Height="12"
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            Data="M12,0A12,12,0,1,0,24,12,12.013,12.013,0,0,0,12,0Zm1,11.879a1,1,0,0,1-.469.848l-3.84,2.4a1,1,0,1,1-1.062-1.7L11,11.325V7a1,1,0,0,1,2,0Z"
                            Fill="{StaticResource SubText}"
                            Stretch="Uniform" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource InterFont}"
                            FontSize="12"
                            FontWeight="Medium"
                            Foreground="{StaticResource SubText}"
                            Text="{Binding TimeOfDayDisplay}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!--  Status  -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">

                <!--  Open in Explorer (manual recordings)  -->
                <Button
                    Margin="0,0,12,0"
                    Padding="8,8"
                    VerticalAlignment="Center"
                    Command="{Binding OpenInExplorerCommand}"
                    Cursor="Hand"
                    Visibility="{Binding FilePath, Converter={StaticResource NullToVisibility}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bg"
                                Padding="{TemplateBinding Padding}"
                                Background="{StaticResource BrushColor4}"
                                BorderBrush="{StaticResource BrushBorderColor4}"
                                BorderThickness="1"
                                CornerRadius="50">
                                <Path
                                    Width="17"
                                    Height="17"
                                    Data="M20,6h-8l-2-2H4C2.9,4,2,4.9,2,6v12c0,1.1,0.9,2,2,2h16c1.1,0,2-0.9,2-2V8C22,6.9,21.1,6,20,6z"
                                    Fill="{StaticResource SubText}"
                                    Stretch="Uniform" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!--  Open on Google Drive  -->
                <Button
                    Margin="0,0,12,0"
                    Padding="8,8"
                    VerticalAlignment="Center"
                    Command="{Binding OpenInDriveCommand}"
                    Cursor="Hand"
                    Visibility="{Binding DriveUrl, Converter={StaticResource NullToVisibility}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bg"
                                Padding="{TemplateBinding Padding}"
                                Background="{StaticResource BrushColor4}"
                                BorderBrush="{StaticResource BrushBorderColor4}"
                                BorderThickness="1"
                                CornerRadius="50">
                                <Path
                                    Width="17"
                                    Height="17"
                                    Data="m12,0C5.383,0,0,5.383,0,12s5.383,12,12,12,12-5.383,12-12S18.617,0,12,0Zm4.404,13.873l-5.212,2.854c-.325.183-.683.274-1.041.274-.373,0-.747-.099-1.087-.297-.667-.39-1.064-1.083-1.064-1.855v-5.699c0-.772.397-1.465,1.064-1.855.665-.389,1.465-.396,2.138-.017l5.192,2.843c.696.391,1.105,1.091,1.105,1.878s-.409,1.487-1.096,1.873Zm-.904-1.873c0,.087-.058.119-.066.125l-5.212,2.855c-.019.01-.077.042-.147-.001-.074-.043-.074-.107-.074-.128v-5.699c0-.021,0-.085.074-.128.027-.016.052-.021.074-.021.036,0,.065.016.083.026l5.192,2.844c.019.011.076.043.076.13Z"
                                    Fill="{StaticResource SubText}"
                                    Stretch="Uniform" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!--  Status badge  -->
                <Border
                    Padding="12,8"
                    VerticalAlignment="Center"
                    BorderThickness="1"
                    CornerRadius="16">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:RecordingStatus.Loading}">
                                    <Setter Property="Background" Value="{StaticResource OtherBrushColor3}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource OtherBrushSubColor3}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:RecordingStatus.Saved}">
                                    <Setter Property="Background" Value="{StaticResource OtherBrushColor1}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource OtherBrushSubColor1}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:RecordingStatus.Error}">
                                    <Setter Property="Background" Value="{StaticResource OtherBrushColor4}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource OtherBrushSubColor4}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource InterFont}"
                        FontSize="14"
                        FontWeight="Medium"
                        Text="{Binding StatusText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:RecordingStatus.Loading}">
                                        <Setter Property="Foreground" Value="{StaticResource OtherBrushSubColor3}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:RecordingStatus.Saved}">
                                        <Setter Property="Foreground" Value="{StaticResource OtherBrushSubColor1}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:RecordingStatus.Error}">
                                        <Setter Property="Foreground" Value="{StaticResource OtherBrushSubColor4}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
