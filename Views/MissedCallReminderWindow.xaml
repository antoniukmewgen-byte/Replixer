<Window
    x:Class="Replixer.Views.MissedCallReminderWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Нагадування"
    Width="368"
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="{StaticResource InterFont}"
    RenderOptions.BitmapScalingMode="NearestNeighbor"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    Topmost="True"
    WindowStyle="None">

    <!--
        Стартове нагадування: з'являється разом із застосунком і лишається на екрані
        поверх усіх вікон (Topmost) до самого виходу із застосунку — на відміну від
        CallCheatSheetWindow, воно не ховається/закривається програмно ніде в коді.
        Кнопки закриття немає навмисно, щоб менеджер не міг випадково прибрати нагадування.
    -->
    <!--
        Margin навколо картки — навмисно, не декоративний відступ: DropShadowEffect нижче
        (BlurRadius=24, ShadowDepth=6) розмиває тінь ЗА межі Border, і без вільного прозорого
        простору навколо ця тінь просто обрізається прямокутними межами вікна (AllowsTransparency
        + Background="Transparent" на Window), даючи різкий "чорний напівпрозорий квадрат" замість
        плавного згасання. 24px з боків/зверху покриває BlurRadius, знизу трохи більше (30px) —
        бо ShadowDepth=6 ще й зсуває тінь вниз. Ширину вікна відповідно збільшено з 320 до 368
        (320 + 24*2), щоб сама картка лишилась візуально тих самих 320px.
    -->
    <Border
        Margin="24,24,24,30"
        Background="{StaticResource OtherBrushColor4}"
        BorderBrush="{StaticResource OtherBrushSubColor4}"
        BorderThickness="1.5"
        CornerRadius="12"
        Cursor="SizeAll"
        MouseLeftButtonDown="Banner_MouseDown">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="24"
                Opacity="0.6"
                ShadowDepth="6"
                Color="Black" />
        </Border.Effect>

        <Grid Margin="14,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Width="28"
                Height="28"
                Margin="0,0,10,0"
                VerticalAlignment="Top"
                Background="{StaticResource OtherBrushSubColor4}"
                CornerRadius="14">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="!" />
            </Border>

            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="{StaticResource Text}"
                LineHeight="18"
                Text="Якщо клієнт не відповів — натисніть кнопку «Не додзвонився» в застосунку Replixer"
                TextWrapping="Wrap" />
        </Grid>
    </Border>
</Window>
