<Window
    x:Class="Replixer.Views.InputWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    Loaded="Window_Loaded">

    <!--  Затемнений фон  -->
    <Window.Resources>
        <SolidColorBrush x:Key="OverlayBrush" Color="#AA000000" />
    </Window.Resources>

    <Border Background="{StaticResource OverlayBrush}">
        <Grid>
            <!--  Клік поза карткою — закриває без результату  -->
            <Rectangle Fill="Transparent" MouseDown="Overlay_MouseDown" />

            <!--  Картка  -->
            <Border
                Width="340"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource BrushColor2}"
                BorderBrush="{StaticResource BrushBorderColor2}"
                BorderThickness="1"
                CornerRadius="16">
                <StackPanel>

                    <TextBlock
                        x:Name="PromptText"
                        Margin="0,0,0,16"
                        FontFamily="{StaticResource InterFont}"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="{StaticResource Text}"
                        TextWrapping="Wrap" />

                    <Border
                        Padding="12,8"
                        Background="{StaticResource BrushColor4}"
                        BorderBrush="{StaticResource BrushBorderColor4}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <TextBox
                            x:Name="InputBox"
                            Background="Transparent"
                            BorderThickness="0"
                            CaretBrush="{StaticResource Text}"
                            FontFamily="{StaticResource InterFont}"
                            FontSize="14"
                            Foreground="{StaticResource Text}"
                            KeyDown="InputBox_KeyDown" />
                    </Border>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            Padding="0,10"
                            Click="CancelButton_Click"
                            Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        Padding="{TemplateBinding Padding}"
                                        Background="{StaticResource BrushColor3}"
                                        BorderBrush="{StaticResource BrushBorderColor3}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontFamily="{StaticResource InterFont}"
                                            FontSize="13"
                                            FontWeight="Medium"
                                            Foreground="{StaticResource SubText}"
                                            Text="Скасувати" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button
                            Grid.Column="2"
                            Padding="0,10"
                            Click="OkButton_Click"
                            Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        Padding="{TemplateBinding Padding}"
                                        Background="{StaticResource BrushTelegram}"
                                        CornerRadius="8">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontFamily="{StaticResource InterFont}"
                                            FontSize="13"
                                            FontWeight="Medium"
                                            Foreground="{StaticResource Text}"
                                            Text="Підтвердити" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
