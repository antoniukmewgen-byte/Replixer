<Window
    x:Class="Replixer.Views.InputWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="360"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None">

    <Border
        Background="{StaticResource BrushColor2}"
        BorderBrush="{StaticResource BrushBorderColor2}"
        BorderThickness="1"
        CornerRadius="12">
        <StackPanel Margin="24">

            <TextBlock
                x:Name="PromptText"
                Margin="0,0,0,12"
                FontFamily="{StaticResource InterFont}"
                FontSize="14"
                FontWeight="Bold"
                Foreground="{StaticResource Text}"
                TextWrapping="Wrap" />

            <Border
                Padding="12,8"
                Background="{StaticResource BrushColor4}"
                BorderBrush="{StaticResource BrushBorderColor4}"
                BorderThickness="1"
                CornerRadius="8">
                <TextBox
                    x:Name="InputBox"
                    Background="Transparent"
                    BorderThickness="0"
                    CaretBrush="{StaticResource Text}"
                    FontFamily="{StaticResource InterFont}"
                    FontSize="14"
                    Foreground="{StaticResource Text}"
                    KeyDown="InputBox_KeyDown" />
            </Border>

            <Button
                Margin="0,12,0,0"
                Padding="0,10"
                Click="OkButton_Click"
                Cursor="Hand"
                FontFamily="{StaticResource InterFont}"
                FontSize="14"
                FontWeight="Medium">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{StaticResource BrushTelegram}"
                            CornerRadius="8">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontFamily="{StaticResource InterFont}"
                                FontSize="14"
                                FontWeight="Medium"
                                Foreground="{StaticResource Text}"
                                Text="Підтвердити" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

        </StackPanel>
    </Border>
</Window>
