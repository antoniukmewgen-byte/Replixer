<UserControl
    x:Class="EchoVault.Views.RecordingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="clr-namespace:EchoVault.Models">
    <Border
        Padding="16,0,16,0"
        Background="{StaticResource BrushColor2}"
        BorderBrush="{StaticResource BrushBorderColor2}"
        BorderThickness="1"
        CornerRadius="12">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
            <Grid Margin="0,16,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    HorizontalAlignment="Left"
                    FontFamily="{StaticResource InterFont}"
                    FontSize="12"
                    FontWeight="Bold"
                    Foreground="{StaticResource SubText}">
                    ВСІ ВАШІ ЗАПИСИ
                </TextBlock>
                <StackPanel
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <Grid Width="60" Height="60">
                        <Ellipse Fill="{StaticResource BrushColor4}" Stroke="{StaticResource BrushBorderColor4}" />
                        <Path
                            Width="30"
                            Height="30"
                            Data="m14 7v-6.54a6.977 6.977 0 0 1 2.465 1.59l3.484 3.486a6.954 6.954 0 0 1 1.591 2.464h-6.54a1 1 0 0 1 -1-1zm8 3.485v8.515a5.006 5.006 0 0 1 -5 5h-10a5.006 5.006 0 0 1 -5-5v-14a5.006 5.006 0 0 1 5-5h4.515c.163 0 .324.013.485.024v6.976a3 3 0 0 0 3 3h6.976c.011.161.024.322.024.485zm-6 6.515a1 1 0 0 0 -1-1h-2v-2a1 1 0 0 0 -2 0v2h-2a1 1 0 0 0 0 2h2v2a1 1 0 0 0 2 0v-2h2a1 1 0 0 0 1-1z"
                            Fill="{StaticResource SubText}"
                            Stretch="Uniform" />
                    </Grid>
                    <TextBlock
                        Margin="0,12,0,6"
                        HorizontalAlignment="Center"
                        FontFamily="{StaticResource InterFont}"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="{StaticResource Text}">
                        Записів не знайдено
                    </TextBlock>
                    <TextBlock
                        Width="300"
                        Margin="0,0,0,12"
                        HorizontalAlignment="Center"
                        FontFamily="{StaticResource InterFont}"
                        FontSize="12"
                        FontWeight="Medium"
                        Foreground="{StaticResource SubText}"
                        TextAlignment="Center"
                        TextWrapping="Wrap">
                        Коли відбудеться дзвінок у WhatsApp, Telegram, Viber або інші програми - запис з'явиться тут
                    </TextBlock>
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <Border
                            Width="38"
                            Height="38"
                            Background="{StaticResource BrushTelegram}"
                            CornerRadius="8">
                            <Image
                                Width="18"
                                Height="18"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Source="/Assets/Icons/telegram.png" />
                        </Border>
                        <Border
                            Width="38"
                            Height="38"
                            Margin="6,0"
                            Background="{StaticResource BrushViber}"
                            CornerRadius="8">
                            <Image
                                Width="18"
                                Height="18"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Source="/Assets/Icons/viber.png" />
                        </Border>
                        <Border
                            Width="38"
                            Height="38"
                            Background="{StaticResource BrushWhatsApp}"
                            CornerRadius="8">
                            <Image
                                Width="18"
                                Height="18"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Source="/Assets/Icons/whatsapp.png" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <ItemsControl
                    Grid.Row="1"
                    ItemsSource="{Binding Recordings}"
                    Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:RecordingEntry}">
                            <Border
                                Margin="0,12,0,0"
                                Padding="16"
                                Background="{StaticResource BrushColor3}"
                                BorderBrush="{StaticResource BrushBorderColor3}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!--  Platform icon  -->
                                    <Border
                                        Grid.Column="0"
                                        Width="38"
                                        Height="38"
                                        CornerRadius="8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource BrushColor4}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Platform}" Value="Telegram">
                                                        <Setter Property="Background" Value="{StaticResource BrushTelegram}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Platform}" Value="Viber">
                                                        <Setter Property="Background" Value="{StaticResource BrushViber}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Platform}" Value="WhatsApp.Root">
                                                        <Setter Property="Background" Value="{StaticResource BrushWhatsApp}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <!--  Platform PNG — hidden for manual  -->
                                            <Image
                                                Width="18"
                                                Height="18"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Source="{Binding IconPath}"
                                                Visibility="{Binding IsManual, Converter={StaticResource InverseBoolToVis}}" />
                                            <!--  Mic icon — shown for manual  -->
                                            <Path
                                                Width="16"
                                                Height="16"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Data="M12,14c2.206,0,4-1.794,4-4V4c0-2.206-1.794-4-4-4S8,1.794,8,4v6C8,12.206,9.794,14,12,14zM18,10c0,3.309-2.691,6-6,6s-6-2.691-6-6H4c0,4.072,3.061,7.436,7,7.931V20H9v2h6v-2h-2v-2.069C16.939,17.436,20,14.072,20,10H18z"
                                                Fill="{StaticResource SubText}"
                                                Stretch="Uniform"
                                                Visibility="{Binding IsManual, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </Border>

                                    <!--  Text  -->
                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="12,0,12,0"
                                        VerticalAlignment="Center">
                                        <TextBlock
                                            FontFamily="{StaticResource InterFont}"
                                            FontSize="14"
                                            FontWeight="Bold"
                                            Foreground="{StaticResource Text}"
                                            Text="{Binding PlatformDisplayName}" />
                                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                <Path
                                                    Width="12"
                                                    Height="12"
                                                    Margin="0,0,4,0"
                                                    VerticalAlignment="Center"
                                                    Data="M0,19a5.006,5.006,0,0,0,5,5H19a5.006,5.006,0,0,0,5-5V10H0Zm17-4.5A1.5,1.5,0,1,1,15.5,16,1.5,1.5,0,0,1,17,14.5Zm-5,0A1.5,1.5,0,1,1,10.5,16,1.5,1.5,0,0,1,12,14.5Zm-5,0A1.5,1.5,0,1,1,5.5,16,1.5,1.5,0,0,1,7,14.5Z                                                     M19,2H18V1a1,1,0,0,0-2,0V2H8V1A1,1,0,0,0,6,1V2H5A5.006,5.006,0,0,0,0,7V8H24V7A5.006,5.006,0,0,0,19,2Z                                                     "
                                                    Fill="{StaticResource SubText}"
                                                    Stretch="Uniform" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontFamily="{StaticResource InterFont}"
                                                    FontSize="12"
                                                    FontWeight="Medium"
                                                    Foreground="{StaticResource SubText}"
                                                    Text="{Binding DateDisplay}" />
                                            </StackPanel>
                                            <StackPanel
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                                <Path
                                                    Width="12"
                                                    Height="12"
                                                    Margin="0,0,4,0"
                                                    VerticalAlignment="Center"
                                                    Data="M12,0A12,12,0,1,0,24,12,12.013,12.013,0,0,0,12,0Zm1,11.879a1,1,0,0,1-.469.848l-3.84,2.4a1,1,0,1,1-1.062-1.7L11,11.325V7a1,1,0,0,1,2,0Z"
                                                    Fill="{StaticResource SubText}"
                                                    Stretch="Uniform" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontFamily="{StaticResource InterFont}"
                                                    FontSize="12"
                                                    FontWeight="Medium"
                                                    Foreground="{StaticResource SubText}"
                                                    Text="{Binding TimeOfDayDisplay}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>

                                    <!--  Status  -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">

                                        <!--  Open on Google Drive — visible when DriveUrl is set  -->
                                        <Button
                                            Margin="0,0,12,0"
                                            Padding="8,8"
                                            VerticalAlignment="Center"
                                            Command="{Binding OpenInDriveCommand}"
                                            Cursor="Hand"
                                            Visibility="{Binding DriveUrl, Converter={StaticResource NullToVisibility}}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border
                                                        x:Name="Bg"
                                                        Padding="{TemplateBinding Padding}"
                                                        Background="{StaticResource BrushColor4}"
                                                        BorderBrush="{StaticResource BrushBorderColor4}"
                                                        BorderThickness="1"
                                                        CornerRadius="50">
                                                        <Path
                                                            Width="17"
                                                            Height="17"
                                                            Data="m12,0C5.383,0,0,5.383,0,12s5.383,12,12,12,12-5.383,12-12S18.617,0,12,0Zm4.404,13.873l-5.212,2.854c-.325.183-.683.274-1.041.274-.373,0-.747-.099-1.087-.297-.667-.39-1.064-1.083-1.064-1.855v-5.699c0-.772.397-1.465,1.064-1.855.665-.389,1.465-.396,2.138-.017l5.192,2.843c.696.391,1.105,1.091,1.105,1.878s-.409,1.487-1.096,1.873Zm-.904-1.873c0,.087-.058.119-.066.125l-5.212,2.855c-.019.01-.077.042-.147-.001-.074-.043-.074-.107-.074-.128v-5.699c0-.021,0-.085.074-.128.027-.016.052-.021.074-.021.036,0,.065.016.083.026l5.192,2.844c.019.011.076.043.076.13Z"
                                                            Fill="{StaticResource SubText}"
                                                            Stretch="Uniform" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <!--  Status badge  -->
                                        <Border
                                            Padding="12,8"
                                            VerticalAlignment="Center"
                                            BorderThickness="1"
                                            CornerRadius="16">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:RecordingStatus.Loading}">
                                                            <Setter Property="Background" Value="{StaticResource OtherBrushColor3}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource OtherBrushSubColor3}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:RecordingStatus.Saved}">
                                                            <Setter Property="Background" Value="{StaticResource OtherBrushColor1}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource OtherBrushSubColor1}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:RecordingStatus.Error}">
                                                            <Setter Property="Background" Value="{StaticResource OtherBrushColor4}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource OtherBrushSubColor4}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontFamily="{StaticResource InterFont}"
                                                FontSize="14"
                                                FontWeight="Medium"
                                                Text="{Binding StatusText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:RecordingStatus.Loading}">
                                                                <Setter Property="Foreground" Value="{StaticResource OtherBrushSubColor3}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:RecordingStatus.Saved}">
                                                                <Setter Property="Foreground" Value="{StaticResource OtherBrushSubColor1}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:RecordingStatus.Error}">
                                                                <Setter Property="Foreground" Value="{StaticResource OtherBrushSubColor4}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </Grid>
        </ScrollViewer>
    </Border>
</UserControl>
