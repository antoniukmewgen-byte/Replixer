<UserControl
    x:Class="Replixer.Views.Dialogs.InputDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        Padding="16"
        Background="{StaticResource BrushColor2}"
        BorderBrush="{StaticResource BrushBorderColor2}"
        BorderThickness="1"
        CornerRadius="12">
        <StackPanel>
            <TextBlock
                Margin="0,0,0,12"
                FontFamily="{StaticResource InterFont}"
                FontSize="12"
                FontWeight="Bold"
                Foreground="{StaticResource SubText}"
                Text="{Binding Prompt}" />

            <Border
                Padding="16"
                Background="{StaticResource BrushColor3}"
                BorderBrush="{StaticResource BrushBorderColor3}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <Border Background="{StaticResource BrushColor4}" CornerRadius="16">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource BrushBorderColor4}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="Padding" Value="12,8" />
                                <Style.Triggers>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter Property="BorderThickness" Value="2" />
                                        <Setter Property="Padding" Value="11,7" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <TextBox
                                x:Name="TelegramVerification"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                CaretBrush="{StaticResource Text}"
                                FontFamily="{StaticResource InterFont}"
                                FontSize="14"
                                Foreground="{StaticResource Text}"
                                KeyDown="InputBox_KeyDown"
                                Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource InterFont}"
                                FontSize="14"
                                Foreground="{StaticResource SubText}"
                                IsHitTestVisible="False"
                                Text="Введіть данні">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=TelegramVerification}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                        <Button
                            Margin="0,0,12,0"
                            Padding="12,8"
                            HorizontalAlignment="Center"
                            Command="{Binding CancelCommand}"
                            Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="Bg"
                                        Padding="{TemplateBinding Padding}"
                                        Background="{StaticResource BrushColor4}"
                                        BorderBrush="{StaticResource BrushBorderColor4}"
                                        BorderThickness="1"
                                        CornerRadius="16">
                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                            <TextBlock
                                                x:Name="Label"
                                                VerticalAlignment="Center"
                                                FontFamily="{StaticResource InterFont}"
                                                FontSize="14"
                                                FontWeight="Medium"
                                                Foreground="{StaticResource SubText}">
                                                Скасувати
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button
                            Padding="12,8"
                            HorizontalAlignment="Center"
                            Command="{Binding ConfirmCommand}"
                            Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="Bg"
                                        Padding="{TemplateBinding Padding}"
                                        Background="{StaticResource OtherBrushColor1}"
                                        BorderBrush="{StaticResource OtherBrushSubColor1}"
                                        BorderThickness="1"
                                        CornerRadius="16">
                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                            <TextBlock
                                                x:Name="Label"
                                                VerticalAlignment="Center"
                                                FontFamily="{StaticResource InterFont}"
                                                FontSize="14"
                                                FontWeight="Medium"
                                                Foreground="{StaticResource OtherBrushSubColor1}">
                                                Підтвердити номер
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
