<UserControl
    x:Class="Replixer.Views.Dialogs.InputDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        Width="340"
        Padding="24"
        Background="{StaticResource BrushColor2}"
        BorderBrush="{StaticResource BrushBorderColor2}"
        BorderThickness="1"
        CornerRadius="16">
        <StackPanel>

            <TextBlock
                Margin="0,0,0,16"
                FontFamily="{StaticResource InterFont}"
                FontSize="14"
                FontWeight="Bold"
                Foreground="{StaticResource Text}"
                Text="{Binding Prompt}"
                TextWrapping="Wrap" />

            <Border
                Padding="12,8"
                Background="{StaticResource BrushColor4}"
                BorderBrush="{StaticResource BrushBorderColor4}"
                BorderThickness="1"
                CornerRadius="8">
                <TextBox
                    x:Name="InputBox"
                    Background="Transparent"
                    BorderThickness="0"
                    CaretBrush="{StaticResource Text}"
                    FontFamily="{StaticResource InterFont}"
                    FontSize="14"
                    Foreground="{StaticResource Text}"
                    Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" />
            </Border>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"
                    Padding="0,10"
                    Command="{Binding CancelCommand}"
                    Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bg"
                                Padding="{TemplateBinding Padding}"
                                Background="{StaticResource BrushColor3}"
                                BorderBrush="{StaticResource BrushBorderColor3}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Cursor="{TemplateBinding Cursor}">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontFamily="{StaticResource InterFont}"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Foreground="{StaticResource SubText}"
                                    Text="Скасувати" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Opacity" Value="0.75" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bg" Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button
                    Grid.Column="2"
                    Padding="0,10"
                    Command="{Binding ConfirmCommand}"
                    Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bg"
                                Padding="{TemplateBinding Padding}"
                                Background="{StaticResource BrushTelegram}"
                                CornerRadius="8"
                                Cursor="{TemplateBinding Cursor}">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontFamily="{StaticResource InterFont}"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Foreground="{StaticResource Text}"
                                    Text="Підтвердити" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Opacity" Value="0.75" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bg" Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

        </StackPanel>
    </Border>
</UserControl>
