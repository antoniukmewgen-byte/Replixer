<UserControl
    x:Class="Replixer.Views.Dialogs.CallDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        Background="{StaticResource BrushColor2}"
        BorderBrush="{StaticResource BrushBorderColor2}"
        BorderThickness="1"
        CornerRadius="12">
        <StackPanel>
            <Grid Margin="16,16,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal">
                    <Border
                        Width="38"
                        Height="38"
                        Background="{Binding AppBackground}"
                        CornerRadius="8">
                        <Image
                            Width="18"
                            Height="18"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Source="{Binding AppIconSource}" />
                    </Border>
                    <StackPanel Margin="12,0" VerticalAlignment="Center">
                        <TextBlock
                            Margin="0,0,0,4"
                            FontFamily="{StaticResource InterFont}"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="{StaticResource Text}"
                            Text="{Binding AppName}" />
                        <TextBlock
                            FontFamily="{StaticResource InterFont}"
                            FontSize="12"
                            FontWeight="Medium"
                            Foreground="{StaticResource SubText}">
                            Дзвінок
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Ellipse
                        Width="8"
                        Height="8"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Fill="{Binding StatusColor}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource InterFont}"
                        FontSize="12"
                        FontWeight="Medium"
                        Foreground="{Binding StatusColor}"
                        Text="{Binding StatusText}" />
                </StackPanel>
            </Grid>

            <Rectangle
                Height="1"
                Margin="0,12"
                Fill="{StaticResource BrushBorderColor2}" />
            <TextBlock
                Width="170"
                Margin="16,0"
                FontFamily="{StaticResource InterFont}"
                FontSize="12"
                FontWeight="Medium"
                Foreground="{StaticResource SubText}"
                Text="{Binding Message}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <Border
                Margin="16,12"
                Padding="12,8"
                Background="{StaticResource BrushColor3}"
                BorderBrush="{StaticResource BrushBorderColor3}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        Orientation="Horizontal">
                        <Path
                            Width="16"
                            Height="16"
                            Margin="0,0,12,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="M9.34,10.793a6.179,6.179,0,0,1,.545-8.275l.633-.634a6.179,6.179,0,0,1,8.274-.544,5.946,5.946,0,0,1,2.146,4.343,6.01,6.01,0,0,1-1.751,4.5l-1,1a6.018,6.018,0,0,1-4.246,1.758q-.129,0-.258-.006A5.95,5.95,0,0,1,9.34,10.793ZM18.757,16a5.214,5.214,0,0,0-3.707,1.535A15.14,15.14,0,0,1,4.272,22H3.122a1.121,1.121,0,0,1-.794-1.914l.7-.7a7.176,7.176,0,0,0,4.6-2.092l3.054-3.054A8,8,0,0,1,7.809,12.08a7.568,7.568,0,0,1-1.082-1.725L3.7,13.379a7.171,7.171,0,0,0-2.092,4.6l-.7.7A3.121,3.121,0,0,0,3.122,24h1.15a17.13,17.13,0,0,0,12.192-5.05A3.243,3.243,0,0,1,22,21.242V23a1,1,0,0,0,2,0V21.242A5.249,5.249,0,0,0,18.757,16Z"
                            Fill="{StaticResource SubText}"
                            Stretch="Uniform" />
                        <!--  Animated equalizer  -->
                        <Grid
                            Width="22"
                            Height="16"
                            VerticalAlignment="Center">
                            <Grid.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation
                                                AutoReverse="True"
                                                BeginTime="0:0:0"
                                                Storyboard.TargetName="EqBar1"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                From="0.25"
                                                To="1.0"
                                                Duration="0:0:0.45" />
                                            <DoubleAnimation
                                                AutoReverse="True"
                                                BeginTime="0:0:0.12"
                                                Storyboard.TargetName="EqBar2"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                From="0.5"
                                                To="1.0"
                                                Duration="0:0:0.3" />
                                            <DoubleAnimation
                                                AutoReverse="True"
                                                BeginTime="0:0:0.05"
                                                Storyboard.TargetName="EqBar3"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                From="0.2"
                                                To="1.0"
                                                Duration="0:0:0.55" />
                                            <DoubleAnimation
                                                AutoReverse="True"
                                                BeginTime="0:0:0.2"
                                                Storyboard.TargetName="EqBar4"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                From="0.4"
                                                To="1.0"
                                                Duration="0:0:0.38" />
                                            <DoubleAnimation
                                                AutoReverse="True"
                                                BeginTime="0:0:0.15"
                                                Storyboard.TargetName="EqBar5"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                From="0.3"
                                                To="0.9"
                                                Duration="0:0:0.42" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Grid.Triggers>
                            <StackPanel
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Orientation="Horizontal">
                                <Rectangle
                                    x:Name="EqBar1"
                                    Width="3"
                                    Height="7"
                                    Margin="0,0,2,0"
                                    Fill="{StaticResource SubText}"
                                    RadiusX="1.5"
                                    RadiusY="1.5"
                                    RenderTransformOrigin="0.5,1">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform ScaleY="0.25" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                                <Rectangle
                                    x:Name="EqBar2"
                                    Width="3"
                                    Height="13"
                                    Margin="0,0,2,0"
                                    Fill="{StaticResource SubText}"
                                    RadiusX="1.5"
                                    RadiusY="1.5"
                                    RenderTransformOrigin="0.5,1">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform ScaleY="0.5" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                                <Rectangle
                                    x:Name="EqBar3"
                                    Width="3"
                                    Height="16"
                                    Margin="0,0,2,0"
                                    Fill="{StaticResource SubText}"
                                    RadiusX="1.5"
                                    RadiusY="1.5"
                                    RenderTransformOrigin="0.5,1">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform ScaleY="0.2" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                                <Rectangle
                                    x:Name="EqBar4"
                                    Width="3"
                                    Height="11"
                                    Margin="0,0,2,0"
                                    Fill="{StaticResource SubText}"
                                    RadiusX="1.5"
                                    RadiusY="1.5"
                                    RenderTransformOrigin="0.5,1">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform ScaleY="0.4" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                                <Rectangle
                                    x:Name="EqBar5"
                                    Width="3"
                                    Height="8"
                                    Fill="{StaticResource SubText}"
                                    RadiusX="1.5"
                                    RadiusY="1.5"
                                    RenderTransformOrigin="0.5,1">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform ScaleY="0.3" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource InterFont}"
                        FontSize="12"
                        FontWeight="Medium"
                        Foreground="{StaticResource SubText}"
                        Text="{Binding RecordingDuration}" />
                </Grid>
            </Border>
            <StackPanel Margin="16,0,16,16" Orientation="Horizontal">
                <Button
                    Margin="0,0,12,0"
                    Padding="12,8"
                    HorizontalAlignment="Center"
                    Command="{Binding SecondaryCommand}"
                    Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bg"
                                Padding="{TemplateBinding Padding}"
                                Background="{StaticResource BrushColor4}"
                                BorderBrush="{StaticResource BrushBorderColor4}"
                                BorderThickness="1"
                                CornerRadius="16">
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource InterFont}"
                                        FontSize="14"
                                        FontWeight="Medium"
                                        Foreground="{StaticResource SubText}"
                                        Text="{Binding SecondaryLabel}" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Opacity" Value="0.75" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bg" Property="Opacity" Value="0.5" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bg" Property="Opacity" Value="0.3" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button
                    Padding="12,8"
                    HorizontalAlignment="Center"
                    Command="{Binding PrimaryCommand}"
                    Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bg"
                                Padding="{TemplateBinding Padding}"
                                Background="{Binding PrimaryBackground}"
                                BorderBrush="{Binding PrimaryAccent}"
                                BorderThickness="1"
                                CornerRadius="16">
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <Ellipse
                                        Width="10"
                                        Height="10"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Fill="{Binding PrimaryAccent}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource InterFont}"
                                        FontSize="14"
                                        FontWeight="Medium"
                                        Foreground="{Binding PrimaryAccent}"
                                        Text="{Binding PrimaryLabel}" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Opacity" Value="0.75" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bg" Property="Opacity" Value="0.5" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bg" Property="Opacity" Value="0.3" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
