<UserControl
    x:Class="Replixer.Views.Dialogs.MissedCallReportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:Replixer.ViewModels.Dialogs">

    <Border
        Width="500"
        Padding="16"
        Background="{StaticResource BrushColor2}"
        BorderBrush="{StaticResource BrushBorderColor2}"
        BorderThickness="1"
        CornerRadius="12">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,12"
                    FontFamily="{StaticResource InterFont}"
                    FontSize="12"
                    FontWeight="Bold"
                    Foreground="{StaticResource SubText}">
                    НЕДОДЗВОН
                </TextBlock>

                <Border
                    Padding="16"
                    Background="{StaticResource BrushColor3}"
                    BorderBrush="{StaticResource BrushBorderColor3}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel>

                        <!--  Тип дзвінка  -->
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,4"
                                FontFamily="{StaticResource InterFont}"
                                FontSize="12"
                                FontWeight="Medium"
                                Foreground="{StaticResource SubText}">
                                Тип дзвінка
                            </TextBlock>
                            <ComboBox
                                ItemsSource="{x:Static vm:MissedCallReportViewModel.CallTypes}"
                                SelectedItem="{Binding SelectedCallType}"
                                Style="{StaticResource AppComboBox}"
                                Tag="Оберіть..." />
                        </StackPanel>

                        <!--  Джерело ліда  -->
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock
                                Margin="0,0,0,4"
                                FontFamily="{StaticResource InterFont}"
                                FontSize="12"
                                FontWeight="Medium"
                                Foreground="{StaticResource SubText}">
                                Джерело ліда
                            </TextBlock>
                            <ComboBox
                                ItemsSource="{x:Static vm:MissedCallReportViewModel.LeadSources}"
                                SelectedItem="{Binding SelectedLeadSource}"
                                Style="{StaticResource AppComboBox}"
                                Tag="Оберіть..." />
                        </StackPanel>

                        <!--  CRM  -->
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock
                                Margin="0,0,0,4"
                                FontFamily="{StaticResource InterFont}"
                                FontSize="12"
                                FontWeight="Medium"
                                Foreground="{StaticResource SubText}">
                                Посилання на CRM
                            </TextBlock>
                            <Border Style="{StaticResource AppInputBorder}" Visibility="{Binding IsCrmUrlVisible, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <TextBox
                                        x:Name="CrmBox"
                                        Style="{StaticResource AppTextBox}"
                                        Text="{Binding CrmUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource InterFont}"
                                        FontSize="14"
                                        Foreground="{StaticResource SubText}"
                                        IsHitTestVisible="False"
                                        Text="Введіть посилання...">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=CrmBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                            <!--  No-link checkbox — hides the CRM input and skips sending to Kommo  -->
                            <CheckBox
                                Margin="0,8,0,0"
                                Cursor="Hand"
                                FocusVisualStyle="{x:Null}"
                                IsChecked="{Binding IsNoLink}">
                                <CheckBox.Template>
                                    <ControlTemplate TargetType="CheckBox">
                                        <Border
                                            x:Name="Bg"
                                            Padding="10,7"
                                            Background="{StaticResource BrushColor4}"
                                            BorderBrush="{StaticResource BrushBorderColor4}"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                <Border
                                                    x:Name="Box"
                                                    Width="16"
                                                    Height="16"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Background="Transparent"
                                                    BorderBrush="{StaticResource SubText}"
                                                    BorderThickness="1.5"
                                                    CornerRadius="4">
                                                    <Path
                                                        x:Name="Check"
                                                        Width="9"
                                                        Height="7"
                                                        Data="M 0 3.5 L 3 6.5 L 9 0"
                                                        Stroke="{StaticResource OtherBrushSubColor1}"
                                                        StrokeEndLineCap="Round"
                                                        StrokeLineJoin="Round"
                                                        StrokeStartLineCap="Round"
                                                        StrokeThickness="1.5"
                                                        Visibility="Collapsed" />
                                                </Border>
                                                <TextBlock
                                                    x:Name="Label"
                                                    VerticalAlignment="Center"
                                                    FontFamily="{StaticResource InterFont}"
                                                    FontSize="13"
                                                    Foreground="{StaticResource Text}"
                                                    Text="Немає посилання" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="Box" Property="Background" Value="{StaticResource OtherBrushColor1}" />
                                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource OtherBrushSubColor1}" />
                                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource OtherBrushSubColor1}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </CheckBox.Template>
                            </CheckBox>
                        </StackPanel>

                        <!--  Примітка  -->
                        <StackPanel Margin="0,12,0,0">
                            <Grid Margin="0,0,0,4">
                                <TextBlock
                                    FontFamily="{StaticResource InterFont}"
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="{StaticResource SubText}">
                                    Примітки
                                </TextBlock>
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    FontFamily="{StaticResource InterFont}"
                                    FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource SubText}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNoteNearLimit}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource OtherBrushSubColor4}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <Run Text="{Binding NoteLength, Mode=OneWay}" /><Run Text=" / 500" />
                                </TextBlock>
                            </Grid>
                            <Border Style="{StaticResource AppInputBorder}">
                                <Grid>
                                    <TextBox
                                        x:Name="NotesBox"
                                        MinHeight="60"
                                        MaxHeight="100"
                                        MaxLength="500"
                                        VerticalAlignment="Top"
                                        AcceptsReturn="True"
                                        Style="{StaticResource AppTextBox}"
                                        Text="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        TextWrapping="Wrap"
                                        VerticalScrollBarVisibility="Hidden" />
                                    <TextBlock
                                        VerticalAlignment="Top"
                                        FontFamily="{StaticResource InterFont}"
                                        FontSize="14"
                                        Foreground="{StaticResource SubText}"
                                        IsHitTestVisible="False"
                                        Text="Введіть примітку...">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=NotesBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!--  Submit button  -->
                        <Button
                            Margin="0,12,0,0"
                            Padding="12,9"
                            HorizontalAlignment="Stretch"
                            Command="{Binding SubmitCommand}"
                            Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="Bg"
                                        Padding="{TemplateBinding Padding}"
                                        Background="{StaticResource BrushColor4}"
                                        BorderBrush="{StaticResource BrushBorderColor4}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                        <TextBlock
                                            x:Name="Label"
                                            HorizontalAlignment="Center"
                                            FontFamily="{StaticResource InterFont}"
                                            FontSize="13"
                                            FontWeight="Medium"
                                            Foreground="{StaticResource SubText}"
                                            Text="Відправити" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsEnabled" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource OtherBrushColor1}" />
                                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource OtherBrushSubColor1}" />
                                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource OtherBrushSubColor1}" />
                                        </Trigger>

                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Opacity" Value="0.75" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bg" Property="Opacity" Value="0.5" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Bg" Property="Opacity" Value="0.3" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
