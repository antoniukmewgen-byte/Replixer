<UserControl
    x:Class="Replixer.Views.Dialogs.MissedCallReportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:Replixer.ViewModels.Dialogs">

    <UserControl.Resources>
        <Style x:Key="QuickActionCircleButton" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bg"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource BrushBorderColor4}"
                            BorderThickness="1"
                            CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.55" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuickActionCaption" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource SubText}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <!--
            Іконка месенджера — лише візуальний бейдж (не кнопка): показує, якому
            месенджеру відповідає поле статусу й кнопка-фотоапарат в тому ж рядку.
            Квадрат із заокругленнями (не коло) — розмір узгоджено з кнопкою поруч і з
            природною висотою звичайних полів форми (як "Тип дзвінка"/"CRM"), а не 42px.
        -->
        <Style x:Key="MessengerIconBadge" TargetType="Border">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <!--  Векторна іконка фотоапарата для кнопки "зняти скрін" — без окремого файлу-ассету.  -->
        <CombinedGeometry x:Key="CameraIconGeometry" GeometryCombineMode="Exclude">
            <CombinedGeometry.Geometry1>
                <GeometryGroup FillRule="Nonzero">
                    <RectangleGeometry
                        RadiusX="3"
                        RadiusY="3"
                        Rect="1,6,22,14" />
                    <RectangleGeometry
                        RadiusX="1.5"
                        RadiusY="1.5"
                        Rect="8,2,8,5" />
                </GeometryGroup>
            </CombinedGeometry.Geometry1>
            <CombinedGeometry.Geometry2>
                <EllipseGeometry
                    Center="12,13"
                    RadiusX="4.5"
                    RadiusY="4.5" />
            </CombinedGeometry.Geometry2>
        </CombinedGeometry>
    </UserControl.Resources>

    <Border
        Width="500"
        Margin="16"
        Background="{StaticResource BrushColor2}"
        BorderBrush="{StaticResource BrushBorderColor2}"
        BorderThickness="1"
        CornerRadius="12">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
            <StackPanel Margin="16">
                <TextBlock
                    Margin="0,0,0,12"
                    FontFamily="{StaticResource InterFont}"
                    FontSize="12"
                    FontWeight="Bold"
                    Foreground="{StaticResource SubText}">
                    НЕДОДЗВОН
                </TextBlock>

                <Border
                    Padding="16"
                    Background="{StaticResource BrushColor3}"
                    BorderBrush="{StaticResource BrushBorderColor3}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel>

                        <!--  Тип дзвінка  -->
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,4"
                                FontFamily="{StaticResource InterFont}"
                                FontSize="12"
                                FontWeight="Medium"
                                Foreground="{StaticResource SubText}">
                                Тип дзвінка
                            </TextBlock>
                            <ComboBox
                                ItemsSource="{x:Static vm:MissedCallReportViewModel.CallTypes}"
                                SelectedItem="{Binding SelectedCallType}"
                                Style="{StaticResource AppComboBox}"
                                Tag="Оберіть..." />
                        </StackPanel>

                        <!--  Час першого дзвінка — редагується лише для "ще не було спілкування"  -->
                        <StackPanel Margin="0,12,0,0" Visibility="{Binding IsFirstContactTimeEditable, Converter={StaticResource BoolToVis}}">
                            <TextBlock
                                Margin="0,0,0,4"
                                FontFamily="{StaticResource InterFont}"
                                FontSize="12"
                                FontWeight="Medium"
                                Foreground="{StaticResource SubText}">
                                Час першого дзвінка
                            </TextBlock>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <RepeatButton
                                    Grid.Column="0"
                                    Width="38"
                                    Height="38"
                                    Margin="0,0,8,0"
                                    Command="{Binding DecrementFirstContactTimeCommand}"
                                    Cursor="Hand"
                                    Delay="450"
                                    Interval="80">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border
                                                x:Name="Bg"
                                                Background="{StaticResource BrushColor4}"
                                                BorderBrush="{StaticResource BrushBorderColor4}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontFamily="{StaticResource InterFont}"
                                                    FontSize="16"
                                                    FontWeight="Bold"
                                                    Foreground="{StaticResource SubText}"
                                                    Text="−" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Opacity" Value="0.75" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Bg" Property="Opacity" Value="0.5" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>

                                <Border Grid.Column="1">
                                    <Border.Style>
                                        <Style BasedOn="{StaticResource AppInputBorder}" TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFirstContactTimeInvalid}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource OtherBrushSubColor4}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBox
                                        Style="{StaticResource AppTextBox}"
                                        Text="{Binding FirstContactTimeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        TextAlignment="Center" />
                                </Border>

                                <RepeatButton
                                    Grid.Column="2"
                                    Width="38"
                                    Height="38"
                                    Margin="8,0,0,0"
                                    Command="{Binding IncrementFirstContactTimeCommand}"
                                    Cursor="Hand"
                                    Delay="450"
                                    Interval="80">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border
                                                x:Name="Bg"
                                                Background="{StaticResource BrushColor4}"
                                                BorderBrush="{StaticResource BrushBorderColor4}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontFamily="{StaticResource InterFont}"
                                                    FontSize="16"
                                                    FontWeight="Bold"
                                                    Foreground="{StaticResource SubText}"
                                                    Text="+" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Opacity" Value="0.75" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Bg" Property="Opacity" Value="0.5" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Grid>
                            <TextBlock
                                Margin="2,4,0,0"
                                FontFamily="{StaticResource InterFont}"
                                FontSize="11"
                                Foreground="{StaticResource OtherBrushSubColor4}"
                                Text="Формат: дд.мм.рррр гг:хх (напр. 23.07.2026 14:35)"
                                Visibility="{Binding IsFirstContactTimeInvalid, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <!--  CRM  -->
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock
                                Margin="0,0,0,4"
                                FontFamily="{StaticResource InterFont}"
                                FontSize="12"
                                FontWeight="Medium"
                                Foreground="{StaticResource SubText}">
                                Посилання на CRM
                            </TextBlock>
                            <Border>
                                <Border.Style>
                                    <Style BasedOn="{StaticResource AppInputBorder}" TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCrmUrlInvalid}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource OtherBrushSubColor4}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <TextBox
                                        x:Name="CrmBox"
                                        Style="{StaticResource AppTextBox}"
                                        Text="{Binding CrmUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource InterFont}"
                                        FontSize="14"
                                        Foreground="{StaticResource SubText}"
                                        IsHitTestVisible="False"
                                        Text="Введіть посилання...">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=CrmBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                            <TextBlock
                                Margin="2,4,0,0"
                                FontFamily="{StaticResource InterFont}"
                                FontSize="11"
                                Foreground="{StaticResource OtherBrushSubColor4}"
                                Text="Введіть посилання на лід у Kommo (напр. https://movenation.kommo.com/)"
                                Visibility="{Binding IsCrmUrlInvalid, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <!--
                            Швидкі дії — іконка месенджера, поле статусу (лише перегляд) і кнопка-фотоапарат,
                            яка відкриває чат з клієнтом і автоматично знімає скрін.
                        -->
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock
                                Margin="0,0,0,4"
                                FontFamily="{StaticResource InterFont}"
                                FontSize="12"
                                FontWeight="Medium"
                                Foreground="{StaticResource SubText}">
                                Скріншоти
                            </TextBlock>

                            <!--  Viber  -->
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Grid.Column="0"
                                    Background="{StaticResource BrushViber}"
                                    Style="{StaticResource MessengerIconBadge}"
                                    ToolTip="Viber">
                                    <Image
                                        Width="18"
                                        Height="18"
                                        Source="/Assets/Icons/viber.png" />
                                </Border>

                                <Border Grid.Column="1" Margin="8,0">
                                    <Border.Style>
                                        <Style BasedOn="{StaticResource AppInputBorder}" TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ViberActionFailed}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource OtherBrushSubColor4}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <TextBox
                                            x:Name="ViberStatusBox"
                                            Focusable="False"
                                            IsReadOnly="True"
                                            Style="{StaticResource AppTextBox}"
                                            Text="{Binding ViberStatus, Mode=OneWay}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource InterFont}"
                                            FontSize="14"
                                            Foreground="{StaticResource SubText}"
                                            IsHitTestVisible="False"
                                            Text="Скрін ще не знято">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=ViberStatusBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <Button
                                    Grid.Column="2"
                                    Background="{StaticResource BrushViber}"
                                    Command="{Binding OpenMessengerCommand}"
                                    CommandParameter="Viber"
                                    Style="{StaticResource QuickActionCircleButton}"
                                    ToolTip="Написати у Viber і зняти скрін">
                                    <Path
                                        Width="16"
                                        Height="16"
                                        Data="{StaticResource CameraIconGeometry}"
                                        Fill="White"
                                        Stretch="Uniform" />
                                </Button>
                            </Grid>

                            <!--  Telegram  -->
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Grid.Column="0"
                                    Background="{StaticResource BrushTelegram}"
                                    Style="{StaticResource MessengerIconBadge}"
                                    ToolTip="Telegram">
                                    <Image
                                        Width="18"
                                        Height="18"
                                        Source="/Assets/Icons/telegram.png" />
                                </Border>

                                <Border Grid.Column="1" Margin="8,0">
                                    <Border.Style>
                                        <Style BasedOn="{StaticResource AppInputBorder}" TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TelegramActionFailed}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource OtherBrushSubColor4}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <TextBox
                                            x:Name="TelegramStatusBox"
                                            Focusable="False"
                                            IsReadOnly="True"
                                            Style="{StaticResource AppTextBox}"
                                            Text="{Binding TelegramStatus, Mode=OneWay}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource InterFont}"
                                            FontSize="14"
                                            Foreground="{StaticResource SubText}"
                                            IsHitTestVisible="False"
                                            Text="Скрін ще не знято">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=TelegramStatusBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <Button
                                    Grid.Column="2"
                                    Background="{StaticResource BrushTelegram}"
                                    Command="{Binding OpenMessengerCommand}"
                                    CommandParameter="Telegram"
                                    Style="{StaticResource QuickActionCircleButton}"
                                    ToolTip="Написати у Telegram і зняти скрін">
                                    <Path
                                        Width="16"
                                        Height="16"
                                        Data="{StaticResource CameraIconGeometry}"
                                        Fill="White"
                                        Stretch="Uniform" />
                                </Button>
                            </Grid>

                            <!--  WhatsApp  -->
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Grid.Column="0"
                                    Background="{StaticResource BrushWhatsApp}"
                                    Style="{StaticResource MessengerIconBadge}"
                                    ToolTip="WhatsApp">
                                    <Image
                                        Width="18"
                                        Height="18"
                                        Source="/Assets/Icons/whatsapp.png" />
                                </Border>

                                <Border Grid.Column="1" Margin="8,0">
                                    <Border.Style>
                                        <Style BasedOn="{StaticResource AppInputBorder}" TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WhatsAppActionFailed}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource OtherBrushSubColor4}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <TextBox
                                            x:Name="WhatsAppStatusBox"
                                            Focusable="False"
                                            IsReadOnly="True"
                                            Style="{StaticResource AppTextBox}"
                                            Text="{Binding WhatsAppStatus, Mode=OneWay}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource InterFont}"
                                            FontSize="14"
                                            Foreground="{StaticResource SubText}"
                                            IsHitTestVisible="False"
                                            Text="Скрін ще не знято">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=WhatsAppStatusBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <Button
                                    Grid.Column="2"
                                    Background="{StaticResource BrushWhatsApp}"
                                    Command="{Binding OpenMessengerCommand}"
                                    CommandParameter="WhatsApp"
                                    Style="{StaticResource QuickActionCircleButton}"
                                    ToolTip="Написати у WhatsApp і зняти скрін">
                                    <Path
                                        Width="16"
                                        Height="16"
                                        Data="{StaticResource CameraIconGeometry}"
                                        Fill="White"
                                        Stretch="Uniform" />
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!--
                            Підказка: поки не набрано потрібної кількості скрінів (RequiredScreenshotCount —
                            2 для "ще не було спілкування", 1 для "вже було"), кнопка "Відправити" неактивна
                            (CanSubmit). Не показуємо взагалі, доки тип дзвінка ще не обрано (ShowScreenshotHint).
                        -->
                        <TextBlock
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            FontFamily="{StaticResource InterFont}"
                            FontSize="12"
                            Foreground="{StaticResource SubText}"
                            Text="{Binding ScreenshotHintText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowScreenshotHint}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!--  Submit button  -->
                        <Button
                            Margin="0,12,0,0"
                            Padding="12,9"
                            HorizontalAlignment="Stretch"
                            Command="{Binding SubmitCommand}"
                            Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="Bg"
                                        Padding="{TemplateBinding Padding}"
                                        Background="{StaticResource BrushColor4}"
                                        BorderBrush="{StaticResource BrushBorderColor4}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                        <TextBlock
                                            x:Name="Label"
                                            HorizontalAlignment="Center"
                                            FontFamily="{StaticResource InterFont}"
                                            FontSize="13"
                                            FontWeight="Medium"
                                            Foreground="{StaticResource SubText}"
                                            Text="Відправити" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsEnabled" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource OtherBrushColor1}" />
                                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource OtherBrushSubColor1}" />
                                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource OtherBrushSubColor1}" />
                                        </Trigger>

                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Opacity" Value="0.75" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bg" Property="Opacity" Value="0.5" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Bg" Property="Opacity" Value="0.3" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
