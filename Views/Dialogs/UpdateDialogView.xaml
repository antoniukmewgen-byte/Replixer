<UserControl
    x:Class="Replixer.Views.Dialogs.UpdateDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        Width="320"
        Padding="16"
        Background="{StaticResource BrushColor2}"
        BorderBrush="{StaticResource BrushBorderColor2}"
        BorderThickness="1"
        CornerRadius="12">
        <StackPanel>

            <Border
                Padding="16"
                Background="{StaticResource BrushColor3}"
                BorderBrush="{StaticResource BrushBorderColor3}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>

                    <!--  Icon + title  -->
                    <StackPanel Margin="0,0,0,12" HorizontalAlignment="Center">
                        <Path
                            Width="36"
                            Height="36"
                            Margin="0,0,0,12"
                            HorizontalAlignment="Center"
                            Data="M17.974,7.146c-.332-.066-.603-.273-.742-.569-1.552-3.271-5.143-5.1-8.735-4.438-3.272,.6-5.837,3.212-6.384,6.501-.162,.971-.15,1.943,.033,2.89,.06,.309-.073,.653-.346,.901-1.145,1.041-1.801,2.524-1.801,4.07,0,3.032,2.467,5.5,5.5,5.5h11c4.136,0,7.5-3.364,7.5-7.5,0-3.565-2.534-6.658-6.026-7.354Zm-2.853,7.562l-2.707,2.707c-.387,.387-.896,.582-1.405,.584l-.009,.002-.009-.002c-.509-.002-1.018-.197-1.405-.584l-2.707-2.707c-.391-.391-.391-1.023,0-1.414s1.023-.391,1.414,0l1.707,1.707v-5c0-.553,.448-1,1-1s1,.447,1,1v5l1.707-1.707c.391-.391,1.023-.391,1.414,0s.391,1.023,0,1.414Z"
                            Fill="{StaticResource OtherBrushSubColor1}"
                            Stretch="Uniform" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontFamily="{StaticResource InterFont}"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="{StaticResource Text}"
                            Text="Доступне оновлення" />
                        <StackPanel
                            Margin="0,4,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                FontFamily="{StaticResource InterFont}"
                                FontSize="12"
                                FontWeight="Medium"
                                Foreground="{StaticResource SubText}"
                                Text="Версія " />
                            <TextBlock
                                FontFamily="{StaticResource InterFont}"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="{StaticResource OtherBrushSubColor1}"
                                Text="{Binding NewVersion}" />
                        </StackPanel>
                    </StackPanel>

                    <!--  Download progress  -->
                    <StackPanel Margin="0,0,0,12" Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}">
                        <Grid Margin="0,0,0,6">
                            <TextBlock
                                FontFamily="{StaticResource InterFont}"
                                FontSize="12"
                                FontWeight="Medium"
                                Foreground="{StaticResource SubText}"
                                Text="Завантаження..." />
                            <TextBlock
                                HorizontalAlignment="Right"
                                FontFamily="{StaticResource InterFont}"
                                FontSize="12"
                                FontWeight="Medium"
                                Foreground="{StaticResource OtherBrushSubColor1}"
                                Text="{Binding DownloadProgressText, Mode=OneWay}" />
                        </Grid>
                        <ProgressBar
                            Height="6"
                            Maximum="1"
                            Minimum="0"
                            Value="{Binding DownloadProgress, Mode=OneWay}">
                            <ProgressBar.Template>
                                <ControlTemplate TargetType="ProgressBar">
                                    <Border
                                        x:Name="PART_Track"
                                        Background="{StaticResource BrushColor4}"
                                        BorderBrush="{StaticResource BrushBorderColor4}"
                                        BorderThickness="1"
                                        ClipToBounds="True"
                                        CornerRadius="2">
                                        <Border
                                            x:Name="PART_Indicator"
                                            HorizontalAlignment="Left"
                                            Background="{StaticResource OtherBrushSubColor1}"
                                            CornerRadius="2" />
                                    </Border>
                                </ControlTemplate>
                            </ProgressBar.Template>
                        </ProgressBar>
                    </StackPanel>

                    <!--  Buttons  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            Padding="12,8"
                            HorizontalAlignment="Stretch"
                            Command="{Binding DismissCommand}"
                            Cursor="Hand"
                            IsEnabled="{Binding IsDownloading, Converter={StaticResource InverseBool}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="Bg"
                                        Padding="{TemplateBinding Padding}"
                                        Background="{StaticResource BrushColor4}"
                                        BorderBrush="{StaticResource BrushBorderColor4}"
                                        BorderThickness="1"
                                        CornerRadius="16">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontFamily="{StaticResource InterFont}"
                                            FontSize="14"
                                            FontWeight="Medium"
                                            Foreground="{StaticResource SubText}"
                                            Text="Пізніше" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Opacity" Value="0.75" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bg" Property="Opacity" Value="0.5" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Bg" Property="Opacity" Value="0.3" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button
                            Grid.Column="2"
                            Padding="12,8"
                            HorizontalAlignment="Stretch"
                            Command="{Binding UpdateNowCommand}"
                            Cursor="Hand"
                            IsEnabled="{Binding IsDownloading, Converter={StaticResource InverseBool}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="Bg"
                                        Padding="{TemplateBinding Padding}"
                                        Background="{StaticResource OtherBrushColor1}"
                                        BorderBrush="{StaticResource OtherBrushSubColor1}"
                                        BorderThickness="1"
                                        CornerRadius="16">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontFamily="{StaticResource InterFont}"
                                            FontSize="14"
                                            FontWeight="Medium"
                                            Foreground="{StaticResource OtherBrushSubColor1}"
                                            Text="Оновити" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Opacity" Value="0.75" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bg" Property="Opacity" Value="0.5" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Bg" Property="Opacity" Value="0.3" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
