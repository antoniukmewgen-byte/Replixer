<UserControl
    x:Class="Replixer.Views.Dialogs.UpdateDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        Width="320"
        Padding="16"
        Background="{StaticResource BrushColor2}"
        BorderBrush="{StaticResource BrushBorderColor2}"
        BorderThickness="1"
        CornerRadius="12">
        <StackPanel>

            <Border
                Padding="16"
                Background="{StaticResource BrushColor3}"
                BorderBrush="{StaticResource BrushBorderColor3}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>

                    <!--  Icon + title  -->
                    <StackPanel Margin="0,0,0,12" HorizontalAlignment="Center">
                        <Path
                            Width="28"
                            Height="28"
                            Margin="0,0,0,12"
                            HorizontalAlignment="Center"
                            Data="M23.899,7H0v-1C0,3.243,2.243,1,5,1h2.528c.463,0,.927,.109,1.341,.316l3.156,1.578c.138,.069,.293,.105,.447,.105h6.528c2.414,0,4.434,1.721,4.899,4Zm.101,2v9c0,2.757-2.243,5-5,5H5c-2.757,0-5-2.243-5-5V9H24Zm-8.293,4.48l-1.613-1.613c-1.154-1.154-3.033-1.154-4.187,0l-1.614,1.613c-.921,.929,.486,2.335,1.414,1.414l1.293-1.293v6.398c.006,1.308,1.995,1.307,2,0v-6.398l1.293,1.293c.929,.921,2.335-.486,1.414-1.414Z"
                            Fill="{StaticResource OtherBrushSubColor1}"
                            Stretch="Uniform" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontFamily="{StaticResource InterFont}"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="{StaticResource Text}"
                            Text="Доступне оновлення" />
                        <StackPanel
                            Margin="0,4,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                FontFamily="{StaticResource InterFont}"
                                FontSize="12"
                                FontWeight="Medium"
                                Foreground="{StaticResource SubText}"
                                Text="Версія " />
                            <TextBlock
                                FontFamily="{StaticResource InterFont}"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="{StaticResource OtherBrushSubColor1}"
                                Text="{Binding NewVersion}" />
                        </StackPanel>
                    </StackPanel>

                    <!--  Download progress  -->
                    <StackPanel Margin="0,0,0,12" Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}">
                        <Grid Margin="0,0,0,6">
                            <TextBlock
                                FontFamily="{StaticResource InterFont}"
                                FontSize="12"
                                FontWeight="Medium"
                                Foreground="{StaticResource SubText}"
                                Text="Завантаження..." />
                            <TextBlock
                                HorizontalAlignment="Right"
                                FontFamily="{StaticResource InterFont}"
                                FontSize="12"
                                FontWeight="Medium"
                                Foreground="{StaticResource OtherBrushSubColor1}">
                                <TextBlock.Text>
                                    <MultiBinding Mode="OneWay" StringFormat="{}{0:0}%">
                                        <Binding Mode="OneWay" Path="DownloadProgress" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Grid>
                        <ProgressBar
                            Height="4"
                            Maximum="1"
                            Minimum="0"
                            Value="{Binding DownloadProgress, Mode=OneWay}">
                            <ProgressBar.Template>
                                <ControlTemplate TargetType="ProgressBar">
                                    <Border
                                        Background="{StaticResource BrushColor4}"
                                        BorderBrush="{StaticResource BrushBorderColor4}"
                                        BorderThickness="1"
                                        CornerRadius="2">
                                        <Border ClipToBounds="True" CornerRadius="2">
                                            <Border
                                                x:Name="PART_Indicator"
                                                HorizontalAlignment="Left"
                                                Background="{StaticResource OtherBrushSubColor1}"
                                                CornerRadius="2" />
                                        </Border>
                                    </Border>
                                </ControlTemplate>
                            </ProgressBar.Template>
                        </ProgressBar>
                    </StackPanel>

                    <!--  Buttons  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            Padding="12,8"
                            HorizontalAlignment="Stretch"
                            Command="{Binding DismissCommand}"
                            Cursor="Hand"
                            IsEnabled="{Binding IsDownloading, Converter={StaticResource InverseBool}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="Bg"
                                        Padding="{TemplateBinding Padding}"
                                        Background="{StaticResource BrushColor4}"
                                        BorderBrush="{StaticResource BrushBorderColor4}"
                                        BorderThickness="1"
                                        CornerRadius="16">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontFamily="{StaticResource InterFont}"
                                            FontSize="14"
                                            FontWeight="Medium"
                                            Foreground="{StaticResource SubText}"
                                            Text="Пізніше" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Opacity" Value="0.75" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bg" Property="Opacity" Value="0.5" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Bg" Property="Opacity" Value="0.3" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button
                            Grid.Column="2"
                            Padding="12,8"
                            HorizontalAlignment="Stretch"
                            Command="{Binding UpdateNowCommand}"
                            Cursor="Hand"
                            IsEnabled="{Binding IsDownloading, Converter={StaticResource InverseBool}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="Bg"
                                        Padding="{TemplateBinding Padding}"
                                        Background="{StaticResource OtherBrushColor1}"
                                        BorderBrush="{StaticResource OtherBrushSubColor1}"
                                        BorderThickness="1"
                                        CornerRadius="16">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontFamily="{StaticResource InterFont}"
                                            FontSize="14"
                                            FontWeight="Medium"
                                            Foreground="{StaticResource OtherBrushSubColor1}"
                                            Text="Оновити" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Opacity" Value="0.75" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bg" Property="Opacity" Value="0.5" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Bg" Property="Opacity" Value="0.3" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
