<Application
    x:Class="Replixer.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Replixer.Converters"
    xmlns:dialogViews="clr-namespace:Replixer.Views.Dialogs"
    xmlns:dialogs="clr-namespace:Replixer.ViewModels.Dialogs"
    xmlns:local="clr-namespace:Replixer"
    xmlns:models="clr-namespace:Replixer.Models"
    xmlns:views="clr-namespace:Replixer.Views"
    xmlns:vm="clr-namespace:Replixer.ViewModels"
    ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles.xaml" />
                <ResourceDictionary Source="Resources/TrayResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Converters  -->
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibility" />
            <converters:InverseBoolConverter x:Key="InverseBool" />

            <!--  DataTemplates: ViewModel → View  -->
            <DataTemplate DataType="{x:Type vm:HomeViewModel}">
                <views:HomePage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RecordingsViewModel}">
                <views:RecordingsPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MissedCallsViewModel}">
                <views:MissedCallsPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProfileViewModel}">
                <views:ProfilePage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type dialogs:CallDialogViewModel}">
                <dialogViews:CallDialogView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type dialogs:InputDialogViewModel}">
                <dialogViews:InputDialogView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type dialogs:CallReportViewModel}">
                <dialogViews:CallReportView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type dialogs:MissedCallReportViewModel}">
                <dialogViews:MissedCallReportView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type dialogs:UpdateDialogViewModel}">
                <dialogViews:UpdateDialogView />
            </DataTemplate>

            <!--
                Model → View: неявні шаблони для ItemsControl без явного ItemTemplate,
                щоб один список міг рендерити впереміш RecordingEntry і MissedCallEntry
                (див. HomeViewModel.RecentActivity + HomePage.xaml)
            -->
            <DataTemplate DataType="{x:Type models:RecordingEntry}">
                <views:RecordingItemView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type models:MissedCallEntry}">
                <views:MissedCallItemView />
            </DataTemplate>

        </ResourceDictionary>
    </Application.Resources>
</Application>
