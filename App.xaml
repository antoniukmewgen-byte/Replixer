<Application
    x:Class="Replixer.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Replixer.Converters"
    xmlns:dialogViews="clr-namespace:Replixer.Views.Dialogs"
    xmlns:dialogs="clr-namespace:Replixer.ViewModels.Dialogs"
    xmlns:local="clr-namespace:Replixer"
    xmlns:views="clr-namespace:Replixer.Views"
    xmlns:vm="clr-namespace:Replixer.ViewModels"
    ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Colors.xaml" />
                <ResourceDictionary Source="Resources/TrayResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="InterFont">pack://application:,,,/Fonts/#Inter</FontFamily>

            <!--  Converters  -->
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibility" />

            <!--  DataTemplates: ViewModel → View  -->
            <DataTemplate DataType="{x:Type vm:HomeViewModel}">
                <views:HomePage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RecordingsViewModel}">
                <views:RecordingsPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProfileViewModel}">
                <views:ProfilePage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type dialogs:CallDialogViewModel}">
                <dialogViews:CallDialogView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type dialogs:InputDialogViewModel}">
                <dialogViews:InputDialogView />
            </DataTemplate>

            <!--  Icon button (circular, used in record cards)  -->
            <Style x:Key="IconButton" TargetType="Button">
                <Setter Property="Padding" Value="8,8" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bg"
                                Padding="{TemplateBinding Padding}"
                                Background="{StaticResource BrushColor4}"
                                BorderBrush="{StaticResource BrushBorderColor4}"
                                BorderThickness="1"
                                CornerRadius="50"
                                Cursor="{TemplateBinding Cursor}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Opacity" Value="0.75" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bg" Property="Opacity" Value="0.5" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bg" Property="Opacity" Value="0.3" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  Toggle Switch  -->
            <Style x:Key="ToggleSwitch" TargetType="ToggleButton">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="22" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid>
                                <Border x:Name="Track" CornerRadius="11">
                                    <Border.Background>
                                        <SolidColorBrush x:Name="TrackColor" Color="{StaticResource ColorBorder}" />
                                    </Border.Background>
                                </Border>
                                <Border
                                    x:Name="Thumb"
                                    Width="16"
                                    Height="16"
                                    Margin="3,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    CornerRadius="8">
                                    <Border.Background>
                                        <SolidColorBrush x:Name="ThumbColor" Color="{StaticResource ColorSubtext}" />
                                    </Border.Background>
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="ThumbSlide" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="ThumbSlide"
                                                    Storyboard.TargetProperty="X"
                                                    To="18"
                                                    Duration="0:0:0.15" />
                                                <ColorAnimation
                                                    Storyboard.TargetName="TrackColor"
                                                    Storyboard.TargetProperty="Color"
                                                    To="{StaticResource ColorToggleActive}"
                                                    Duration="0:0:0.15" />
                                                <ColorAnimation
                                                    Storyboard.TargetName="ThumbColor"
                                                    Storyboard.TargetProperty="Color"
                                                    To="{StaticResource ColorWhite}"
                                                    Duration="0:0:0.15" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="ThumbSlide"
                                                    Storyboard.TargetProperty="X"
                                                    To="0"
                                                    Duration="0:0:0.15" />
                                                <ColorAnimation
                                                    Storyboard.TargetName="TrackColor"
                                                    Storyboard.TargetProperty="Color"
                                                    To="{StaticResource ColorBorder}"
                                                    Duration="0:0:0.15" />
                                                <ColorAnimation
                                                    Storyboard.TargetName="ThumbColor"
                                                    Storyboard.TargetProperty="Color"
                                                    To="{StaticResource ColorSubtext}"
                                                    Duration="0:0:0.15" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
