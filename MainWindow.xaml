<Window
    x:Class="Replixer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Replixer.Controls"
    xmlns:views="clr-namespace:Replixer.Views"
    Width="1000"
    Height="636"
    AllowsTransparency="True"
    Background="Transparent"
    Icon="/Assets/Icons/IconApp.png"
    RenderOptions.BitmapScalingMode="NearestNeighbor"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">

    <Window.Resources>
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bg"
                            Background="Transparent"
                            CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushBorderColor1}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="HeaderButtonClose"
            BasedOn="{StaticResource HeaderButton}"
            TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bg"
                            Background="Transparent"
                            CornerRadius="0,12,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource OtherBrushSubColor4}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="{StaticResource BrushColor4}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <controls:RippleEffect CornerRadius="8">
                            <Border
                                x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </controls:RippleEffect>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="SidebarButtonRound"
            BasedOn="{StaticResource SidebarButton}"
            TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <controls:RippleEffect CornerRadius="50">
                            <Border
                                x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="50">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </controls:RippleEffect>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border
        x:Name="RootBorder"
        Background="{StaticResource BrushColor1}"
        CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Header  -->
            <Grid
                Grid.Row="0"
                Grid.ColumnSpan="2"
                Margin="16,0,0,0"
                Background="Transparent"
                MouseDown="Window_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image
                    Grid.Column="0"
                    Width="26"
                    Height="26"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    Source="/Assets/Icons/IconApp.png" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button
                        x:Name="EmailButton"
                        Click="EmailButton_Click"
                        Style="{StaticResource HeaderButton}">
                        <Path
                            Width="12"
                            Height="12"
                            Data="M505.878,36.682L110.763,431.69c8.542,4.163,17.911,6.351,27.413,6.4h67.669c5.661-0.015,11.092,2.236,15.083,6.251   l36.672,36.651c19.887,20.024,46.936,31.295,75.157,31.317c11.652-0.011,23.224-1.921,34.261-5.653   c38.05-12.475,65.726-45.46,71.403-85.099l72.085-342.4C513.948,64.89,512.311,49.871,505.878,36.682z M433.771,1.652L92.203,73.61C33.841,81.628-6.971,135.44,1.047,193.802c3.167,23.048,13.782,44.43,30.228,60.885   l36.651,36.651c4.006,4.005,6.255,9.439,6.251,15.104v67.669c0.049,9.502,2.237,18.872,6.4,27.413L475.627,6.41   C462.645,0.03,447.853-1.651,433.771,1.652z"
                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            Stretch="Uniform" />
                    </Button>
                    <Button
                        x:Name="UpdateButton"
                        Command="{Binding CheckForUpdatesCommand}"
                        Style="{StaticResource HeaderButton}">
                        <Grid>
                            <Path
                                Width="12"
                                Height="12"
                                Data="M23,24H1c-.55,0-1-.45-1-1s.45-1,1-1H23c.55,0,1,.45,1,1s-.45,1-1,1Zm-8.23-5.14s6.35-6.75,6.35-6.75c.87-.87,1.12-2.11,.65-3.24-.47-1.13-1.52-1.84-2.75-1.85h-2.02s0-4.03,0-4.03c.01-1.67-1.36-3-3.02-3h-3.98c-1.66,0-3,1.34-3,3v4s-1.87,0-1.87,0c-1.17,0-2.3,.61-2.81,1.66-.57,1.18-.34,2.51,.54,3.4l6.29,6.8c.77,.77,1.79,1.16,2.81,1.16s2.03-.39,2.81-1.16Z"
                                Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                Stretch="Uniform" />
                            <Ellipse
                                Width="6"
                                Height="6"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Fill="{StaticResource OtherBrushSubColor1}"
                                Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Button>
                    <Rectangle
                        Width="1"
                        Height="24"
                        Margin="6,0"
                        Fill="{StaticResource BrushBorderColor1}" />
                    <Button
                        x:Name="CollapseButton"
                        Click="CollapseButton_Click"
                        Style="{StaticResource HeaderButton}">
                        <Path
                            Width="12"
                            Height="12"
                            Data="M18.71,8.21a1,1,0,0,0-1.42,0l-4.58,4.58a1,1,0,0,1-1.42,0L6.71,8.21a1,1,0,0,0-1.42,0,1,1,0,0,0,0,1.41l4.59,4.59a3,3,0,0,0,4.24,0l4.59-4.59A1,1,0,0,0,18.71,8.21Z"
                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            Stretch="Uniform" />
                    </Button>
                    <Button
                        x:Name="MinimizeButton"
                        Click="MinimizeButton_Click"
                        Style="{StaticResource HeaderButton}">
                        <Path
                            Width="12"
                            Height="12"
                            Data="M22.5,14H1.5c-.83,0-1.5-.67-1.5-1.5s.67-1.5,1.5-1.5H22.5c.83,0,1.5,.67,1.5,1.5s-.67,1.5-1.5,1.5Z"
                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            Stretch="Uniform" />
                    </Button>
                    <Button
                        x:Name="FullscreenButton"
                        Click="FullscreenButton_Click"
                        Style="{StaticResource HeaderButton}">
                        <Path
                            x:Name="FullscreenIcon"
                            Width="12"
                            Height="12"
                            Data="M22.5,15.5A1.5,1.5,0,0,0,21,17v1.5A2.5,2.5,0,0,1,18.5,21H17a1.5,1.5,0,0,0,0,3h1.5A5.506,5.506,0,0,0,24,18.5V17A1.5,1.5,0,0,0,22.5,15.5Z     M7,0H5.5A5.506,5.506,0,0,0,0,5.5V7A1.5,1.5,0,0,0,3,7V5.5A2.5,2.5,0,0,1,5.5,3H7A1.5,1.5,0,0,0,7,0Z     M7,21H5.5A2.5,2.5,0,0,1,3,18.5V17a1.5,1.5,0,0,0-3,0v1.5A5.506,5.506,0,0,0,5.5,24H7a1.5,1.5,0,0,0,0-3Z     M18.5,0H17a1.5,1.5,0,0,0,0,3h1.5A2.5,2.5,0,0,1,21,5.5V7a1.5,1.5,0,0,0,3,0V5.5A5.506,5.506,0,0,0,18.5,0Z"
                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            Stretch="Uniform" />
                    </Button>
                    <Button
                        x:Name="CloseButton"
                        Click="CloseButton_Click"
                        Style="{StaticResource HeaderButtonClose}">
                        <Path
                            Width="12"
                            Height="12"
                            Data="M301.258,256.01L502.645,54.645c12.501-12.501,12.501-32.769,0-45.269c-12.501-12.501-32.769-12.501-45.269,0l0,0   L256.01,210.762L54.645,9.376c-12.501-12.501-32.769-12.501-45.269,0s-12.501,32.769,0,45.269L210.762,256.01L9.376,457.376   c-12.501,12.501-12.501,32.769,0,45.269s32.769,12.501,45.269,0L256.01,301.258l201.365,201.387   c12.501,12.501,32.769,12.501,45.269,0c12.501-12.501,12.501-32.769,0-45.269L301.258,256.01z"
                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>

            <!--  SideBar  -->
            <Grid
                x:Name="SidebarGrid"
                Grid.Row="1"
                Grid.Column="0"
                Margin="0,17,0,16">
                <StackPanel VerticalAlignment="Top">
                    <Button
                        x:Name="HomeButton"
                        Padding="0"
                        Command="{Binding NavigateHomeCommand}"
                        Style="{StaticResource SidebarButton}">
                        <Path
                            Width="18"
                            Height="18"
                            Data="M362.667,383.841v128H448c35.346,0,64-28.654,64-64V253.26c0.005-11.083-4.302-21.733-12.011-29.696l-181.29-195.99c-31.988-34.61-85.976-36.735-120.586-4.747c-1.644,1.52-3.228,3.103-4.747,4.747L12.395,223.5C4.453,231.496-0.003,242.31,0,253.58v194.261c0,35.346,28.654,64,64,64h85.333v-128c0.399-58.172,47.366-105.676,104.073-107.044C312.01,275.383,362.22,323.696,362.667,383.841Z     M256,319.841c-35.346,0-64,28.654-64,64v128h128v-128C320,348.495,291.346,319.841,256,319.841Z"
                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            Stretch="Uniform" />
                    </Button>
                    <Button
                        x:Name="RecordingsButton"
                        Margin="0,12"
                        Padding="0"
                        Command="{Binding NavigateRecordingsCommand}"
                        Style="{StaticResource SidebarButton}">
                        <Path
                            Width="18"
                            Height="18"
                            Data="M10,12a1,1,0,0,1-1,1H4.069a7.993,7.993,0,0,0,15.862,0H15a1,1,0,0,1,0-2h5V9H15a1,1,0,0,1,0-2h4.931A7.993,7.993,0,0,0,4.069,7H9A1,1,0,0,1,9,9H4v2H9A1,1,0,0,1,10,12Z                             M23,12a1,1,0,0,0-1,1,9.01,9.01,0,0,1-9,9H11a9.011,9.011,0,0,1-9-9,1,1,0,0,0-2,0A11.013,11.013,0,0,0,11,24h2A11.013,11.013,0,0,0,24,13,1,1,0,0,0,23,12Z"
                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            Stretch="Uniform" />
                    </Button>
                    <Button
                        x:Name="SettingsButton"
                        Padding="0"
                        Command="{Binding NavigateSettingsCommand}"
                        Style="{StaticResource SidebarButton}">
                        <Path
                            Width="18"
                            Height="18"
                            Data="M34.283,384c17.646,30.626,56.779,41.148,87.405,23.502c0.021-0.012,0.041-0.024,0.062-0.036l9.493-5.483   c17.92,15.332,38.518,27.222,60.757,35.072V448c0,35.346,28.654,64,64,64s64-28.654,64-64v-10.944   c22.242-7.863,42.841-19.767,60.757-35.115l9.536,5.504c30.633,17.673,69.794,7.167,87.467-23.467   c17.673-30.633,7.167-69.794-23.467-87.467l0,0l-9.472-5.461c4.264-23.201,4.264-46.985,0-70.187l9.472-5.461   c30.633-17.673,41.14-56.833,23.467-87.467c-17.673-30.633-56.833-41.14-87.467-23.467l-9.493,5.483   C362.862,94.638,342.25,82.77,320,74.944V64c0-35.346-28.654-64-64-64s-64,28.654-64,64v10.944   c-22.242,7.863-42.841,19.767-60.757,35.115l-9.536-5.525C91.073,86.86,51.913,97.367,34.24,128s-7.167,69.794,23.467,87.467l0,0   l9.472,5.461c-4.264,23.201-4.264,46.985,0,70.187l-9.472,5.461C27.158,314.296,16.686,353.38,34.283,384z M256,170.667   c47.128,0,85.333,38.205,85.333,85.333S303.128,341.333,256,341.333S170.667,303.128,170.667,256S208.872,170.667,256,170.667z"
                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            Stretch="Uniform" />
                    </Button>
                </StackPanel>

                <!--  Active page indicator  -->
                <Border
                    x:Name="ActiveIndicator"
                    Width="4"
                    Height="38"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="{StaticResource Text}"
                    CornerRadius="0,4,4,0">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="IndicatorTranslate" />
                    </Border.RenderTransform>
                </Border>

                <!--  Profile button pinned to bottom  -->
                <Button
                    x:Name="ProfileButton"
                    Padding="0"
                    VerticalAlignment="Bottom"
                    Command="{Binding NavigateProfileCommand}"
                    Style="{StaticResource SidebarButtonRound}">
                    <Path
                        Width="18"
                        Height="18"
                        Data="M384,128A128,128,0,1,1,256,0A128,128,0,0,1,384,128Z     M256,298.667c-105.99,0.118-191.882,86.01-192,192C64,502.449,73.551,512,85.333,512h341.333c11.782,0,21.333-9.551,21.333-21.333C447.882,384.677,361.99,298.784,256,298.667Z"
                        Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        Stretch="Uniform" />
                </Button>
            </Grid>

            <!--  MainContent  -->
            <Border
                Grid.Row="1"
                Grid.Column="1"
                BorderBrush="{StaticResource BrushBorderColor1}"
                BorderThickness="1,1,0,0"
                CornerRadius="12,0,0,0">
                <ContentControl Content="{Binding CurrentViewModel}" />
            </Border>

            <!--  Modal overlay — covers entire window  -->
            <Grid
                Grid.RowSpan="2"
                Grid.ColumnSpan="2"
                Visibility="{Binding Dialog, Converter={StaticResource NullToVisibility}}">
                <Rectangle
                    Fill="{StaticResource BrushColor1}"
                    Opacity="0.88"
                    RadiusX="12"
                    RadiusY="12" />
                <ContentControl
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="{Binding Dialog}" />
            </Grid>

            <!--  Toast notifications — bottom-right corner, non-interactive  -->
            <ItemsControl
                Grid.RowSpan="2"
                Grid.ColumnSpan="2"
                Margin="0,0,14,14"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                IsHitTestVisible="False"
                ItemsSource="{Binding Notifications.Items}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel VerticalAlignment="Bottom" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <views:NotificationItemView />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </Grid>
    </Border>
</Window>
