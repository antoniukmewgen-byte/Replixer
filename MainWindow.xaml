<Window
    x:Class="EchoVault.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:EchoVault.Converters"
    xmlns:dialogViews="clr-namespace:EchoVault.Views.Dialogs"
    xmlns:dialogs="clr-namespace:EchoVault.ViewModels.Dialogs"
    xmlns:views="clr-namespace:EchoVault.Views"
    xmlns:vm="clr-namespace:EchoVault.ViewModels"
    Width="1000"
    Height="700"
    AllowsTransparency="True"
    Background="Transparent"
    Icon="/Assets/Icons/IconApp.png"
    WindowStyle="None">

    <Window.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />

        <!--  DataTemplates: ViewModel → View  -->
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomePage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RecordingsViewModel}">
            <views:RecordingsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProfileViewModel}">
            <views:ProfilePage />
        </DataTemplate>

        <DataTemplate DataType="{x:Type dialogs:CallDialogViewModel}">
            <dialogViews:CallDialogView />
        </DataTemplate>

        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bg"
                            Background="Transparent"
                            CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="HeaderButtonClose"
            BasedOn="{StaticResource HeaderButton}"
            TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bg"
                            Background="Transparent"
                            CornerRadius="0,12,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="{StaticResource BrushColor4}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bg"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="SidebarButtonRound"
            BasedOn="{StaticResource SidebarButton}"
            TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bg"
                            Background="{TemplateBinding Background}"
                            CornerRadius="50">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border
        x:Name="RootBorder"
        Background="{StaticResource BrushColor1}"
        CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Header  -->
            <Grid
                Grid.Row="0"
                Grid.ColumnSpan="2"
                Margin="16,0,0,0"
                Background="Transparent"
                MouseDown="Window_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Image
                        Width="14"
                        Height="14"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Source="/Assets/Icons/IconApp.png" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource InterFont}"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="{StaticResource Text}">
                        EchoVault
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="EmailButton" Style="{StaticResource HeaderButton}">
                        <Path
                            Width="12"
                            Height="12"
                            Data="M23.954,5.542,15.536,13.96a5.007,5.007,0,0,1-7.072,0L.046,5.542C.032,5.7,0,5.843,0,6V18a5.006,5.006,0,0,0,5,5H19a5.006,5.006,0,0,0,5-5V6C24,5.843,23.968,5.7,23.954,5.542Z     M14.122,12.546l9.134-9.135A4.986,4.986,0,0,0,19,1H5A4.986,4.986,0,0,0,.744,3.411l9.134,9.135A3.007,3.007,0,0,0,14.122,12.546Z"
                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            Stretch="Uniform" />
                    </Button>
                    <Rectangle
                        Width="1"
                        Height="24"
                        Margin="6,0"
                        Fill="{StaticResource BrushBorderColor1}" />
                    <Button x:Name="CollapseButton" Style="{StaticResource HeaderButton}">
                        <Path
                            Width="12"
                            Height="12"
                            Data="M18.71,8.21a1,1,0,0,0-1.42,0l-4.58,4.58a1,1,0,0,1-1.42,0L6.71,8.21a1,1,0,0,0-1.42,0,1,1,0,0,0,0,1.41l4.59,4.59a3,3,0,0,0,4.24,0l4.59-4.59A1,1,0,0,0,18.71,8.21Z"
                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            Stretch="Uniform" />
                    </Button>
                    <Button
                        x:Name="MinimizeButton"
                        Click="MinimizeButton_Click"
                        Style="{StaticResource HeaderButton}">
                        <Path
                            Width="12"
                            Height="12"
                            Data="M22.5,14H1.5c-.83,0-1.5-.67-1.5-1.5s.67-1.5,1.5-1.5H22.5c.83,0,1.5,.67,1.5,1.5s-.67,1.5-1.5,1.5Z"
                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            Stretch="Uniform" />
                    </Button>
                    <Button x:Name="FullscreenButton" Style="{StaticResource HeaderButton}">
                        <Path
                            Width="12"
                            Height="12"
                            Data="M22.5,15.5A1.5,1.5,0,0,0,21,17v1.5A2.5,2.5,0,0,1,18.5,21H17a1.5,1.5,0,0,0,0,3h1.5A5.506,5.506,0,0,0,24,18.5V17A1.5,1.5,0,0,0,22.5,15.5Z     M7,0H5.5A5.506,5.506,0,0,0,0,5.5V7A1.5,1.5,0,0,0,3,7V5.5A2.5,2.5,0,0,1,5.5,3H7A1.5,1.5,0,0,0,7,0Z     M7,21H5.5A2.5,2.5,0,0,1,3,18.5V17a1.5,1.5,0,0,0-3,0v1.5A5.506,5.506,0,0,0,5.5,24H7a1.5,1.5,0,0,0,0-3Z     M18.5,0H17a1.5,1.5,0,0,0,0,3h1.5A2.5,2.5,0,0,1,21,5.5V7a1.5,1.5,0,0,0,3,0V5.5A5.506,5.506,0,0,0,18.5,0Z"
                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            Stretch="Uniform" />
                    </Button>
                    <Button
                        x:Name="CloseButton"
                        Click="CloseButton_Click"
                        Style="{StaticResource HeaderButtonClose}">
                        <Path
                            Width="12"
                            Height="12"
                            Data="M301.258,256.01L502.645,54.645c12.501-12.501,12.501-32.769,0-45.269c-12.501-12.501-32.769-12.501-45.269,0l0,0   L256.01,210.762L54.645,9.376c-12.501-12.501-32.769-12.501-45.269,0s-12.501,32.769,0,45.269L210.762,256.01L9.376,457.376   c-12.501,12.501-12.501,32.769,0,45.269s32.769,12.501,45.269,0L256.01,301.258l201.365,201.387   c12.501,12.501,32.769,12.501,45.269,0c12.501-12.501,12.501-32.769,0-45.269L301.258,256.01z"
                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>

            <!--  SideBar  -->
            <Grid
                x:Name="SidebarGrid"
                Grid.Row="1"
                Grid.Column="0"
                Margin="0,17,0,16">
                <StackPanel VerticalAlignment="Top">
                    <Button
                        x:Name="HomeButton"
                        Padding="0"
                        Command="{Binding NavigateHomeCommand}"
                        Style="{StaticResource SidebarButton}">
                        <Path
                            Width="18"
                            Height="18"
                            Data="M362.667,383.841v128H448c35.346,0,64-28.654,64-64V253.26c0.005-11.083-4.302-21.733-12.011-29.696l-181.29-195.99c-31.988-34.61-85.976-36.735-120.586-4.747c-1.644,1.52-3.228,3.103-4.747,4.747L12.395,223.5C4.453,231.496-0.003,242.31,0,253.58v194.261c0,35.346,28.654,64,64,64h85.333v-128c0.399-58.172,47.366-105.676,104.073-107.044C312.01,275.383,362.22,323.696,362.667,383.841Z     M256,319.841c-35.346,0-64,28.654-64,64v128h128v-128C320,348.495,291.346,319.841,256,319.841Z"
                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            Stretch="Uniform" />
                    </Button>
                    <Button
                        x:Name="RecordingsButton"
                        Margin="0,12"
                        Padding="0"
                        Command="{Binding NavigateRecordingsCommand}"
                        Style="{StaticResource SidebarButton}">
                        <Path
                            Width="18"
                            Height="18"
                            Data="M10,12a1,1,0,0,1-1,1H4.069a7.993,7.993,0,0,0,15.862,0H15a1,1,0,0,1,0-2h5V9H15a1,1,0,0,1,0-2h4.931A7.993,7.993,0,0,0,4.069,7H9A1,1,0,0,1,9,9H4v2H9A1,1,0,0,1,10,12Z                             M23,12a1,1,0,0,0-1,1,9.01,9.01,0,0,1-9,9H11a9.011,9.011,0,0,1-9-9,1,1,0,0,0-2,0A11.013,11.013,0,0,0,11,24h2A11.013,11.013,0,0,0,24,13,1,1,0,0,0,23,12Z"
                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            Stretch="Uniform" />
                    </Button>
                    <Button
                        x:Name="SettingsButton"
                        Padding="0"
                        Command="{Binding NavigateSettingsCommand}"
                        Style="{StaticResource SidebarButton}">
                        <Path
                            Width="18"
                            Height="18"
                            Data="M34.283,384c17.646,30.626,56.779,41.148,87.405,23.502c0.021-0.012,0.041-0.024,0.062-0.036l9.493-5.483   c17.92,15.332,38.518,27.222,60.757,35.072V448c0,35.346,28.654,64,64,64s64-28.654,64-64v-10.944   c22.242-7.863,42.841-19.767,60.757-35.115l9.536,5.504c30.633,17.673,69.794,7.167,87.467-23.467   c17.673-30.633,7.167-69.794-23.467-87.467l0,0l-9.472-5.461c4.264-23.201,4.264-46.985,0-70.187l9.472-5.461   c30.633-17.673,41.14-56.833,23.467-87.467c-17.673-30.633-56.833-41.14-87.467-23.467l-9.493,5.483   C362.862,94.638,342.25,82.77,320,74.944V64c0-35.346-28.654-64-64-64s-64,28.654-64,64v10.944   c-22.242,7.863-42.841,19.767-60.757,35.115l-9.536-5.525C91.073,86.86,51.913,97.367,34.24,128s-7.167,69.794,23.467,87.467l0,0   l9.472,5.461c-4.264,23.201-4.264,46.985,0,70.187l-9.472,5.461C27.158,314.296,16.686,353.38,34.283,384z M256,170.667   c47.128,0,85.333,38.205,85.333,85.333S303.128,341.333,256,341.333S170.667,303.128,170.667,256S208.872,170.667,256,170.667z"
                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            Stretch="Uniform" />
                    </Button>
                </StackPanel>

                <!--  Active page indicator  -->
                <Border
                    x:Name="ActiveIndicator"
                    Width="4"
                    Height="38"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="{StaticResource Text}"
                    CornerRadius="0,4,4,0">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="IndicatorTranslate" />
                    </Border.RenderTransform>
                </Border>

                <Button
                    x:Name="ProfileButton"
                    Padding="0"
                    VerticalAlignment="Bottom"
                    Command="{Binding NavigateProfileCommand}"
                    Style="{StaticResource SidebarButtonRound}">
                    <Path
                        Width="18"
                        Height="18"
                        Data="M384,128A128,128,0,1,1,256,0A128,128,0,0,1,384,128Z     M256,298.667c-105.99,0.118-191.882,86.01-192,192C64,502.449,73.551,512,85.333,512h341.333c11.782,0,21.333-9.551,21.333-21.333C447.882,384.677,361.99,298.784,256,298.667Z"
                        Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        Stretch="Uniform" />
                </Button>
            </Grid>

            <!--  MainContent  -->
            <Border
                Grid.Row="1"
                Grid.Column="1"
                Padding="16"
                BorderBrush="{StaticResource BrushBorderColor1}"
                BorderThickness="1,1,0,0"
                CornerRadius="12,0,0,0">
                <ContentControl Content="{Binding CurrentViewModel}" />
            </Border>

            <!--  Modal overlay — covers entire window  -->
            <Grid
                Grid.RowSpan="2"
                Grid.ColumnSpan="2"
                Visibility="{Binding Dialog, Converter={StaticResource NullToVisibility}}">
                <Rectangle
                    Fill="{StaticResource BrushColor1}"
                    Opacity="0.88"
                    RadiusX="12"
                    RadiusY="12" />
                <ContentControl
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="{Binding Dialog}" />
            </Grid>

        </Grid>
    </Border>
</Window>
