<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Base dark-theme neutrals  -->
    <Color x:Key="ColorWindowBackground">#0E0E0E</Color>
    <Color x:Key="ColorCardBackground">#111111</Color>
    <Color x:Key="ColorCardDeep">#161616</Color>
    <Color x:Key="ColorBorder">#1E1E1E</Color>
    <Color x:Key="ColorHover">#2A2A2A</Color>
    <Color x:Key="ColorPressedDeep">#0A0A0A</Color>
    <Color x:Key="ColorIcon">#888888</Color>
    <Color x:Key="ColorSubtext">#555555</Color>
    <Color x:Key="ColorWhite">#FFFFFF</Color>

    <!--  Red accent (recording / stop)  -->
    <Color x:Key="ColorAccent">#CC5555</Color>
    <Color x:Key="ColorAccentBackground">#2A0F0F</Color>
    <Color x:Key="ColorAccentBorder">#481919</Color>
    <Color x:Key="ColorAccentPressed">#1A0808</Color>

    <!--  Green status  -->
    <Color x:Key="ColorIndicatorActive">#4A8A4A</Color>
    <Color x:Key="ColorToggleActive">#306932</Color>
    <Color x:Key="ColorGreenHover">#3D8B40</Color>
    <Color x:Key="ColorAuthorizedBackground">#0D1A0D</Color>

    <!--  Danger  -->
    <Color x:Key="ColorDanger">#C0392B</Color>

    <!--  Platform brand colors  -->
    <Color x:Key="ColorTelegram">#1A3A5C</Color>
    <Color x:Key="ColorViber">#3A1A4A</Color>
    <Color x:Key="ColorWhatsApp">#1B4A2E</Color>

    <!--  SolidColorBrush resources  -->
    <SolidColorBrush x:Key="BrushWindowBackground" Color="{StaticResource ColorWindowBackground}" />
    <SolidColorBrush x:Key="BrushCardBackground" Color="{StaticResource ColorCardBackground}" />
    <SolidColorBrush x:Key="BrushCardDeep" Color="{StaticResource ColorCardDeep}" />
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="BrushHover" Color="{StaticResource ColorHover}" />
    <SolidColorBrush x:Key="BrushPressedDeep" Color="{StaticResource ColorPressedDeep}" />
    <SolidColorBrush x:Key="BrushIcon" Color="{StaticResource ColorIcon}" />
    <SolidColorBrush x:Key="BrushSubtext" Color="{StaticResource ColorSubtext}" />
    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="BrushAccentBackground" Color="{StaticResource ColorAccentBackground}" />
    <SolidColorBrush x:Key="BrushAccentBorder" Color="{StaticResource ColorAccentBorder}" />
    <SolidColorBrush x:Key="BrushAccentPressed" Color="{StaticResource ColorAccentPressed}" />
    <SolidColorBrush x:Key="BrushIndicatorActive" Color="{StaticResource ColorIndicatorActive}" />
    <SolidColorBrush x:Key="BrushToggleActive" Color="{StaticResource ColorToggleActive}" />
    <SolidColorBrush x:Key="BrushGreenHover" Color="{StaticResource ColorGreenHover}" />
    <SolidColorBrush x:Key="BrushAuthorizedBackground" Color="{StaticResource ColorAuthorizedBackground}" />
    <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}" />
    <SolidColorBrush x:Key="BrushTelegram" Color="{StaticResource ColorTelegram}" />
    <SolidColorBrush x:Key="BrushViber" Color="{StaticResource ColorViber}" />
    <SolidColorBrush x:Key="BrushWhatsApp" Color="{StaticResource ColorWhatsApp}" />

</ResourceDictionary>
